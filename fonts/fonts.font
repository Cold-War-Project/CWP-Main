# Cold War Project: same-name overwrite of the vanilla 1.15.1 fonts.font. Only the Latin font files are swapped,
# following the master branch's look: body text (Open Sans, EB Garamond) -> Cabin, headings and map names
# (Playfair Display) and the Fancy font (Paradox Victorian) -> Bebas Neue. CJK and Noto fallbacks are vanilla.
# Fonts in fonts/cwe are SIL Open Font License. Re-diff against vanilla after each game update.
### Open Sans (override cw font to support more languages)
fontfiles = {
    name = "Game-OpenSans-Regular"
    always_load = yes

    group = {
        languages = { "l_english" "l_braz_por" "l_french" "l_german" "l_polish" "l_russian" "l_spanish" "l_turkish" }
        files = {
            "fonts/cwe/Cabin-Regular.ttf"
            "fonts/NotoSans/NotoSansJP-Regular.otf"
            "fonts/NotoSans/NotoSansKR-Regular.otf"
            "fonts/NotoSans/NotoSansSC-Regular.otf"
            "fonts/NotoSans/NotoSans-Regular.ttf"
        }
    }
    
    group = {
        languages = { "l_japanese" }
        files = {
            "fonts/NotoSans/NotoSansJP-Regular.otf"
            "fonts/cwe/Cabin-Regular.ttf"
            "fonts/NotoSans/NotoSansKR-Regular.otf"
            "fonts/NotoSans/NotoSansSC-Regular.otf"
            "fonts/NotoSans/NotoSans-Regular.ttf"
        }
    }

    group = {
        languages = { "l_korean" }
        files = {
            "fonts/NotoSans/NotoSansKR-Regular.otf"
            "fonts/cwe/Cabin-Regular.ttf"
            "fonts/NotoSans/NotoSansJP-Regular.otf"
            "fonts/NotoSans/NotoSansSC-Regular.otf"
            "fonts/NotoSans/NotoSans-Regular.ttf"
        }
    }
    
    group = {
        languages = { "l_simp_chinese" }
        files = {
            "fonts/NotoSans/NotoSansSC-Regular.otf"
            "fonts/cwe/Cabin-Regular.ttf"
            "fonts/NotoSans/NotoSansJP-Regular.otf"
            "fonts/NotoSans/NotoSansKR-Regular.otf"
            "fonts/NotoSans/NotoSans-Regular.ttf"
        }
    }
}
