							size = { 110 22 }
							parentanchor = vcenter
							align = left|nobaseline
							text = "cwp_sgt_world_liquidity"
						}

						gold_progressbar_horizontal = {
							size = { 270 22 }
							parentanchor = vcenter

							blockoverride "values" {
								value = "[FixedPointToFloat(GetGlobalVariable('cwp_sgt_liquidity').GetValue)]"
								min = 0
								max = 100
