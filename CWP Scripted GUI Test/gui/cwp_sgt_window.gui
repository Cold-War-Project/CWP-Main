							}
						}

						cwp_sgt_button = {
							size = { 52 24 }
							enabled = "[GetScriptedGui('cwp_sgt_world_sgui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('direction', MakeScopeValue('(CFixedPoint)1')).AddScope('amount', MakeScopeValue('(CFixedPoint)10')).End)]"
							onclick = "[GetScriptedGui('cwp_sgt_world_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('direction', MakeScopeValue('(CFixedPoint)1')).AddScope('amount', MakeScopeValue('(CFixedPoint)10')).End)]"
							tooltip = "cwp_sgt_world_plus_tt"

							blockoverride "cwp_sgt_button_text" {
								raw_text = "+ 10"
							}
						}
					}

					flowcontainer = {
						spacing = 8
						tooltip = "cwp_sgt_world_liquidity_tt"

