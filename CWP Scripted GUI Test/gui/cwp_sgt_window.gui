								raw_text = "[GetGlobalVariable('cwp_sgt_confidence').GetValue|1] / 100"
							}
						}

						cwp_sgt_button = {
							size = { 52 24 }
							enabled = "[GetScriptedGui('cwp_sgt_world_sgui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('direction', MakeScopeValue('(CFixedPoint)2')).AddScope('amount', MakeScopeValue('(CFixedPoint)10')).End)]"
							onclick = "[GetScriptedGui('cwp_sgt_world_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('direction', MakeScopeValue('(CFixedPoint)2')).AddScope('amount', MakeScopeValue('(CFixedPoint)10')).End)]"
							tooltip = "cwp_sgt_world_minus_tt"

							blockoverride "cwp_sgt_button_text" {
