										}
									}

									cwp_sgt_button = {
										size = { 110 24 }
										onclick = "[GetScriptedGui('cwp_sgt_flag_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('action', MakeScopeFlag('tighten')).End)]"
										tooltip = "cwp_sgt_tests_flag_tt"

										blockoverride "cwp_sgt_button_text" {
											raw_text = "Send tighten"
										}
									}
								}

								flowcontainer = {
									spacing = 6

									textbox = {
										size = { 150 22 }
										parentanchor = vcenter
										align = left|nobaseline
										text = "cwp_sgt_tests_ai"
									}

									cwp_sgt_button = {
										size = { 110 24 }
										onclick = "[GetScriptedGui('cwp_sgt_ai_toggle_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
										tooltip = "cwp_sgt_tests_ai_tt"

										blockoverride "cwp_sgt_button_selected" {
											visible = "[GetScriptedGui('cwp_sgt_ai_on_sgui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
										}

										blockoverride "cwp_sgt_button_text" {
											raw_text = "AI test on / off"
										}
									}

									cwp_sgt_button = {
										size = { 130 24 }
										enabled = "[GetScriptedGui('cwp_sgt_ai_sgui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
										onclick = "[GetScriptedGui('cwp_sgt_ai_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
										tooltip = "cwp_sgt_tests_ai_tt"

										blockoverride "cwp_sgt_button_text" {
											raw_text = "Press it myself"
										}
									}
								}

								cwp_sgt_note = {
									text = "cwp_sgt_tests_lists"
								}

								cwp_sgt_idx_row = {
									blockoverride "cwp_sgt_idx_icon" {
										texture = "[GetGoods('grain').GetTexture]"
									}

									blockoverride "cwp_sgt_idx_name" {
										raw_text = "#b [GetGoods('grain').GetNameNoFormatting]#!"
									}

									blockoverride "cwp_sgt_idx_level" {
										raw_text = "Level #v [GetPlayer.MakeScope.Var('cwp_sgt_lvl_grain').GetValue|0]#! of 2"
									}

									blockoverride "cwp_sgt_idx_minus" {
										enabled = "[GetScriptedGui('cwp_sgt_idx_sgui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('idx', MakeScopeValue('(CFixedPoint)1')).AddScope('action', MakeScopeValue('(CFixedPoint)1')).End)]"
										onclick = "[GetScriptedGui('cwp_sgt_idx_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('idx', MakeScopeValue('(CFixedPoint)1')).AddScope('action', MakeScopeValue('(CFixedPoint)1')).End)]"
									}

									blockoverride "cwp_sgt_idx_plus" {
										enabled = "[GetScriptedGui('cwp_sgt_idx_sgui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('idx', MakeScopeValue('(CFixedPoint)1')).AddScope('action', MakeScopeValue('(CFixedPoint)2')).End)]"
										onclick = "[GetScriptedGui('cwp_sgt_idx_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('idx', MakeScopeValue('(CFixedPoint)1')).AddScope('action', MakeScopeValue('(CFixedPoint)2')).End)]"
									}
								}

								cwp_sgt_idx_row = {
									blockoverride "cwp_sgt_idx_icon" {
										texture = "[GetGoods('meat').GetTexture]"
									}

									blockoverride "cwp_sgt_idx_name" {
										raw_text = "#b [GetGoods('meat').GetNameNoFormatting]#!"
									}

									blockoverride "cwp_sgt_idx_level" {
										raw_text = "Level #v [GetPlayer.MakeScope.Var('cwp_sgt_lvl_meat').GetValue|0]#! of 2"
									}

									blockoverride "cwp_sgt_idx_minus" {
										enabled = "[GetScriptedGui('cwp_sgt_idx_sgui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('idx', MakeScopeValue('(CFixedPoint)2')).AddScope('action', MakeScopeValue('(CFixedPoint)1')).End)]"
										onclick = "[GetScriptedGui('cwp_sgt_idx_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('idx', MakeScopeValue('(CFixedPoint)2')).AddScope('action', MakeScopeValue('(CFixedPoint)1')).End)]"
									}

									blockoverride "cwp_sgt_idx_plus" {
										enabled = "[GetScriptedGui('cwp_sgt_idx_sgui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('idx', MakeScopeValue('(CFixedPoint)2')).AddScope('action', MakeScopeValue('(CFixedPoint)2')).End)]"
										onclick = "[GetScriptedGui('cwp_sgt_idx_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('idx', MakeScopeValue('(CFixedPoint)2')).AddScope('action', MakeScopeValue('(CFixedPoint)2')).End)]"
									}
								}
							}
						}
					}

					scrollbar_vertical = {
						using = vertical_scrollbar
					}
				}

				### TAB 4: Ration book
				cwp_sgt_ration_book = {
					visible = "[GetVariableSystem.HasValue('cwp_sgt_tab', 'ration')]"
					parentanchor = hcenter
				}

				### TAB 5: Conference. Exists only while one sits.
				flowcontainer = {
					visible = "[And(GetVariableSystem.HasValue('cwp_sgt_tab', 'conference'), GetScriptedGui('cwp_sgt_conference_on_sgui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
					parentanchor = hcenter
					direction = vertical
					spacing = 6

					cwp_sgt_header = {
						blockoverride "text1" {
							text = "cwp_sgt_conference_members"
						}

						blockoverride "text2" {
							raw_text = "[GetDataModelSize(GetPlayer.MakeScope.GetList('cwp_sgt_members'))] delegations"
						}
					}

					# a list written out as text by a scripted GUI
					cwp_sgt_line = {
						text = "[GetScriptedGui('cwp_sgt_list_sgui').ExecuteTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					}
				}
			}
		}
	}
}
