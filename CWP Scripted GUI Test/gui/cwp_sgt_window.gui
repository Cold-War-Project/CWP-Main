			### Tab content. One fixed size, so the window keeps its shape from tab to tab.
			### 400 high: five ledger rows with a little air, and the ration book with its key.
			widget = {
				visible = "[GetScriptedGui('cwp_sgt_ready_sgui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				size = { 548 400 }

				### TAB 1: World
				flowcontainer = {
					visible = "[Or(Or(Not(GetVariableSystem.Exists('cwp_sgt_tab')), GetVariableSystem.HasValue('cwp_sgt_tab', 'world')), And(GetVariableSystem.HasValue('cwp_sgt_tab', 'conference'), Not(GetScriptedGui('cwp_sgt_conference_on_sgui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End))))]"
					parentanchor = hcenter
					direction = vertical
					spacing = 8
					ignoreinvisible = yes

					cwp_sgt_header = {
						blockoverride "text1" {
							text = "cwp_sgt_world_title"
						}

						blockoverride "text2" {
							text = "cwp_sgt_world_members"
						}
					}

					# a label, a bar with its figure, and the buttons that move it
					flowcontainer = {
						spacing = 8
						tooltip = "cwp_sgt_world_confidence_tt"

						textbox = {
							size = { 110 22 }
							parentanchor = vcenter
							align = left|nobaseline
							text = "cwp_sgt_world_confidence"
						}

						default_progressbar_horizontal = {
							size = { 270 22 }
							parentanchor = vcenter

							blockoverride "values" {
								value = "[FixedPointToFloat(GetGlobalVariable('cwp_sgt_confidence').GetValue)]"
