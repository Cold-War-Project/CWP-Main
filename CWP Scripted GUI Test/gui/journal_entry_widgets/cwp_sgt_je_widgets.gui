# CWP scripted GUI test: the panel inside the journal entry cwp_sgt_je.
# Laid out like vanilla's tsarpoints_widgets.gui: a named flowcontainer that the journal entry's
# "widget" field places in custom_widget_container_3.
# Every type used here (cwp_sgt_ration_book, cwp_sgt_member_ledger, cwp_sgt_button) is defined in
# gui/cwp_sgt_window.gui, so the journal entry and the window show the same rows.

flowcontainer = {
	name = "widget_cwp_sgt_je_panel"
	ignoreinvisible = yes

	flowcontainer = {
		direction = vertical
		spacing = 10
		margin = { 0 8 }
		ignoreinvisible = yes

		# the one prominent action of the entry
		cwp_sgt_button = {
			parentanchor = hcenter
			size = { 300 34 }
			tooltip = "cwp_sgt_open_window_tt"
			onclick = "[GetVariableSystem.Toggle('cwp_sgt_window_open')]"

			blockoverride "cwp_sgt_button_style" {
				using = default_button_primary
			}

			blockoverride "cwp_sgt_button_text" {
				text = "cwp_sgt_open_window"
			}
		}

		cwp_sgt_ration_book = {}

		cwp_sgt_member_ledger = {
			blockoverride "cwp_sgt_ledger_count" {
				raw_text = "[GetDataModelSize(JournalEntry.GetCountry.MakeScope.GetList('cwp_sgt_members'))] members"
			}

			blockoverride "cwp_sgt_list_size" {
				size = { 544 268 }
			}

			blockoverride "cwp_sgt_list_datamodel" {
				datamodel = "[JournalEntry.GetCountry.MakeScope.GetList('cwp_sgt_members')]"
			}
		}
	}
}
