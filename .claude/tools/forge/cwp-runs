# ---------------------------------------------------------------- planning

def load_started():
    """Steps handed out by `cwp-runs start` whose run has not been catalogued yet (in flight)."""
    d = RUNS / "started"
    out = []
    for f in sorted(d.glob("*.json")) if d.exists() else []:
        try:
            rec = json.loads(f.read_text())
        except ValueError:
            continue
        if not rec.get("closed"):
            out.append(rec)
    return out


def clear_started(cat):
    """Close in-flight records whose run is now in the catalog, or that are older than 36 h (never run).
    Caller holds runs_lock."""
    for rec in load_started():
        rows = [r for o, r in cat.items() if o == rec["outdir"] or o.startswith(rec["outdir"] + "/")]
        # An econ_bench session that yielded the game is catalogued as partial but its job resumes it:
        # only a finished row closes the record.
        done = any(r["status"] != "partial" or r["source"] == "observer" for r in rows)
        age = now() - parse_iso(rec["started_at"])
        stale = age > dt.timedelta(hours=36)
        # Its job has ended: no output after 6 h (time to launch the printed command), or a partial row
        # (an econ session that yielded) whose job is no longer there to resume it.
        gone = (not job_active(rec["token"]) and
                ((not rows and not Path(rec["outdir"]).exists() and age > dt.timedelta(hours=6))
                 or (rows and age > dt.timedelta(minutes=30))))
        if done or stale or gone:
            rec["closed"] = ("catalogued" if done else "stale (36 h without a finished run)" if stale
                             else "its job is not running and produced no output folder")
            write_json(RUNS / "started" / f"{rec['token']}.json", rec)


def job_active(token):
    """Is the systemd --user unit of `cwp-vic job runs-<token>` loaded and not finished?"""
    try:
        r = subprocess.run(["systemctl", "--user", "is-active", f"cwp-job-runs-{token}"], capture_output=True,
                           text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return True   # can't tell: assume it is
    return r.stdout.strip() in ("active", "activating", "reloading")


def plan(cat, inflight=None):
    """Deterministic: the ordered list of runs that would serve every pending request and the staging queue,
    given the catalog and the steps already started (in flight). Reads only; changes nothing."""
    inflight = load_started() if inflight is None else inflight
    reqs = [r for r in load_requests() if r["state"] == "pending" and parse_iso(r["expires"]) >= now()]
    staging = staging_items()
    steps = []
    fly_batches = [rec for rec in inflight if rec["step"]["type"] == "batch"]
    planned = {}   # gh -> arm steps already planned; another request needing the same build reuses them

    counted = {o for o, r in cat.items() if sample_ok(r, 0)}

    def flying(gh, until):
        return sum(1 for rec in inflight if rec["step"]["type"] in ("arm", "solo") and rec["step"].get("gh") == gh
                   and rec["step"]["until"] >= until
                   and not any(o == rec["outdir"] or o.startswith(rec["outdir"] + "/")
                               for o in counted if (cat[o].get("years_reached") or 0) >= until))

    def arm_steps(req):
        served, d = evaluate(req, cat)
        if served:
            return []
        n = req["replicates"]
        done_t = len(d["treatment"]) + flying(req["gh"], req["until"])
        done_b = len(d["baseline"]) + flying(req.get("baseline_gh"), req["until"])
        need_t, need_b = max(0, n - done_t), max(0, n - done_b)
        if req.get("baseline_sha") is None:
            need_b = 0   # proxy baseline: only existing runs serve it (submit checked there are enough)
        econ = req["thread"].startswith("econ")
        out = []
        while need_t or need_b:   # interleave arms: whichever has fewer runs goes next, baseline on ties
            side = "baseline" if need_b and (done_b <= done_t or not need_t) else "treatment"
            gh = req["baseline_gh"] if side == "baseline" else req["gh"]
            sha = req["baseline_sha"] if side == "baseline" else req["sha"]
            # One run of a build is a sample for every request that needs that build. A cwp-observe run gives
            # every area its data (econ by ingest), so anyone may reuse and extend it. An econ_bench run (econ
            # priority, yields to others) is reused by a non-econ request only if that doesn't extend it; it
            # then runs as cwp-observe so the other thread gets its dumps.
            def fits(st):
                if req["id"] in {x for x, _ in st["serves"]}:
                    return False
                return not st["econ_only"] or econ or req["until"] <= st["until"]
            reuse = next((st for st in planned.get(gh, []) if fits(st)), None)
            if reuse:
                reuse["until"] = max(reuse["until"], req["until"])
                reuse["econ_only"] = reuse["econ_only"] and econ
                reuse["serves"].append((req["id"], side))
            else:
                st = {"type": "arm", "gh": gh, "sha": sha, "until": req["until"], "serves": [(req["id"], side)],
                      "thread": req["thread"], "econ_only": econ,
                      "econ_priority": econ and not req.get("yield_ok")}
                planned.setdefault(gh, []).append(st)
                out.append(st)
            if side == "baseline":
                need_b, done_b = need_b - 1, done_b + 1
            else:
                need_t, done_t = need_t - 1, done_t + 1
        return out

    measures = sorted((r for r in reqs if r["kind"] == "measure"), key=lambda r: r["created"])
    econ_first = [r for r in measures if r["thread"].startswith("econ") and not r.get("yield_ok")]
    for r in econ_first:
        steps += arm_steps(r)

    # The batch: the staging queue plus every pending smoke/observe request that fits under the cap,
    # minus what a batch already in flight covers.
    def in_flight_batch(branch, created=None):
        return any(branch in rec["step"]["items"] and (created is None or parse_iso(created) <= parse_iso(rec["started_at"]))
                   for rec in fly_batches)

    riders = [r for r in sorted(reqs, key=lambda r: r["created"]) if r["kind"] in ("smoke", "observe")
              and not evaluate(r, cat)[0] and not in_flight_batch(r["branch"], r["created"])]
    fit = [r for r in riders if r["until"] <= BATCH_CAP]
    items, seen = [], set()
    for br, _ in staging:
        if br not in seen and not in_flight_batch(br):
            items.append(br)
            seen.add(br)
    serves = []
    for r in fit:
        if not resolve(f"refs/heads/{r['branch']}"):
            continue   # not a local branch (submit refuses these; an old request may still have one)
        if r["branch"] not in seen:
            items.append(r["branch"])
            seen.add(r["branch"])
        serves.append(r["id"])
    if items and fly_batches:   # one integration tree: the next batch waits until this one is catalogued
        steps.append({"type": "wait-batch", "items": items, "serves": serves})
    elif items:
        end = max([STAGING_UNTIL] * bool(set(items) & {b for b, _ in staging}) + [r["until"] for r in fit if r["id"] in serves])
        steps.append({"type": "batch", "items": items, "until": min(end, BATCH_CAP), "serves": serves,
                      "staging": [b for b, _ in staging]})
    for r in riders:
        if r["until"] > BATCH_CAP:   # long observe: its own run (solo, its branch only)
            if flying(r["gh"], r["until"]):
                continue
            steps.append({"type": "solo", "serves": [(r["id"], "solo")], "thread": r["thread"],
                          "sha": resolve_request_sha(r), "gh": r["gh"], "branch": r["branch"], "until": r["until"],
                          "econ_only": False, "econ_priority": False})
    for r in measures:
        if r not in econ_first:
            steps += arm_steps(r)
    return steps


def step_outdir(st, token):
    if st["type"] == "arm" and st["econ_only"]:
        return str(ECON / f"runs-{st['sha'][:9]}-{token}" / "run-001")
    return str(OBSERVER / f"{now():%Y%m%d-%H%M}-{token}")


def step_commands(st, token, outdir):
    """Shell commands for the staging thread. Each run gets its own output folder, so replicates never collide."""
    job = f"runs-{token}"
    if st["type"] == "batch":
        return [f"cwp-integrate build {' '.join(st['items'])}   # explicit items only (a bare build adds open PRs)",
                f"CWP_AGENT=observer cwp-vic job {job} -- cwp-observe {INTEGRATION} {st['until']} {outdir}",
                f"cwp-runs done {outdir}   # when the job has finished"]
    wt = FORGE / "worktrees" / f"runs-{st['sha'][:9]}"
    cmds = [f"[ -d {wt} ] || git -C {REPO} worktree add --detach {wt} {st['sha']}"]
    if st["type"] == "arm" and st["econ_only"]:
        cmds.append(f"cd {ECON_BENCH} && CWP_AGENT=econ cwp-vic job {job} -- python3 -m tools.econ_bench run "
                    f"--worktree {wt} --runs 1 --end-year {st['until']} --out {Path(outdir).parent}")
    else:   # cwp-observe: dumps for every area; `cwp-runs done` adds the econ data by ingest
        cmds.append(f"CWP_AGENT=observer cwp-vic job {job} -- cwp-observe {wt} {st['until']} {outdir}")
    cmds.append(f"cwp-runs done {outdir}   # when the job has finished")
    return cmds


def describe(i, st):
    if st["type"] == "wait-batch":
        return [f"{i}. NEXT BATCH (after the batch in flight is done; one integration tree): " + ", ".join(st["items"])]
    if st["type"] == "batch":
        lines = [f"{i}. BATCH to {st['until']}: {BASE} + {len(st['items'])} branch(es)"]
        lines += [f"     {b}" + ("   [staging]" if b in st["staging"] else "") for b in st["items"]]
        if st["serves"]:
            lines.append(f"   serves requests: {', '.join(st['serves'])}")
        return lines
    who = ", ".join(f"{side} of {rid}" for rid, side in st["serves"])
    kind = "SOLO observe" if st["type"] == "solo" else "ARM"
    runner = "econ_bench" if st["econ_only"] else "cwp-observe"
    return [f"{i}. {kind} {st['sha'][:9]} (gh {st['gh']}) to {st['until']} via {runner}"
            f"{' [econ priority]' if st['econ_priority'] else ''}: {who}"]


def fresh_plan():
    cat = index_dirs(candidate_dirs())
    reevaluate(cat, quiet=True)
    cat = load_catalog()
    with runs_lock():
        clear_started(cat)
    return cat, plan(cat)


def cmd_plan(a):
    cat, steps = fresh_plan()
    inflight = load_started()
    if a.json:
        print(json.dumps({"in_flight": inflight, "steps": steps}, indent=1))
        return
    if free_gb() < MIN_FREE_GB:
        print(f"WARNING: only {free_gb():.1f} GB free on the Forge disk; `start` refuses below {MIN_FREE_GB:g} GB\n")
    for rec in inflight:
        print(f"in flight since {rec['started_at']}: {rec['token']} -> {rec['outdir']}")
        for line in describe("-", rec["step"]):
            print("   " + line)
    if not steps:
        print("nothing (more) to run: no unserved requests and the staging queue is covered")
        return
    for i, st in enumerate(steps, 1):
        print("\n".join(describe(i, st)))
    print("\nStart a step with `cwp-runs start <n>`: it records the step as in flight (so the next plan doesn't"
          " book it again) and prints the commands.")


def cmd_start(a):
    # A separate lock file (runs_lock is taken inside fresh_plan): two starts can't plan and record at once.
    with open(RUNS / ".start.lock", "w") as lf:
        fcntl.flock(lf, fcntl.LOCK_EX)
        return start_locked(a)


MIN_FREE_GB = float(os.environ.get("CWP_RUNS_MIN_FREE_GB", "20"))   # an observer run writes 1-3 GB of saves and dumps


def free_gb(path=os.path.expanduser("~/forge")):
    return shutil.disk_usage(path).free / 1e9


def start_locked(a):
    if free_gb() < MIN_FREE_GB:
        die(f"only {free_gb():.1f} GB free on the Forge disk (need {MIN_FREE_GB:g}; CWP_RUNS_MIN_FREE_GB): "
            "free space first (landed, clean worktrees; caches), never by deleting run outputs")
    cat, steps = fresh_plan()
    if not 1 <= a.step <= len(steps):
        die(f"no step {a.step} in the current plan ({len(steps)} steps)")
    st = steps[a.step - 1]
    if st["type"] == "wait-batch":
        die("that batch waits for the batch in flight (one integration tree); `cwp-runs done` that one first")
    tag = st["sha"][:9] if st.get("sha") else "batch"
    token = f"{now():%m%d%H%M%S}-{tag}-{os.urandom(2).hex()}"
    outdir = step_outdir(st, token)
    rec = {"token": token, "started_at": iso(), "outdir": outdir, "step": st}
    (RUNS / "started").mkdir(parents=True, exist_ok=True)
    with runs_lock():
        fd = os.open(RUNS / "started" / f"{token}.json", os.O_WRONLY | os.O_CREAT | os.O_EXCL)
        os.close(fd)
        write_json(RUNS / "started" / f"{token}.json", rec)
        if st["type"] == "batch":
            (RUNS / "batches").mkdir(parents=True, exist_ok=True)
            (RUNS / "batches" / f"{token}.items").write_text("\n".join(st["items"]) + "\n")
    print("\n".join(describe(a.step, st)))
    print(f"recorded as in flight: {token} (output {outdir})\nrun:")
    for c in step_commands(st, token, outdir):
        print(f"  {c}")
    return 0


# ---------------------------------------------------------------- main

def main(argv=None):
    ap = argparse.ArgumentParser(prog="cwp-runs", description=__doc__.split("\n\n")[0])
    sub = ap.add_subparsers(dest="cmd")
    s = sub.add_parser("submit")
    s.add_argument("--thread", required=True)
    s.add_argument("--kind", required=True)
    s.add_argument("--branch", required=True, help="local branch or sha")
    s.add_argument("--until", required=True, type=int, help="in-game year the data must reach")
    s.add_argument("--replicates", type=int)
    s.add_argument("--baseline", default="auto", help="measure: auto (merge-base with CWP2), a sha, or accept:<GH>:<why>")
    s.add_argument("--session", help="session id the result should be sent to")
    s.add_argument("--note")
    s.add_argument("--id")
    s.add_argument("--pin", dest="pin", action="store_true", default=None)
    s.add_argument("--no-pin", dest="pin", action="store_false")
    s.add_argument("--underpowered", action="store_true")
    s.add_argument("--yield-ok", action="store_true", help="econ measure only: don't jump ahead of the staging batch")
    s.add_argument("--hours", type=float, help="expiry (default 48 h, measure 7 days)")
    b = sub.add_parser("baselines")
    b.add_argument("ref")
    b.add_argument("--until", type=int)
    r = sub.add_parser("runs")
    r.add_argument("--gh")
    r.add_argument("--sha")
    r.add_argument("--branch")
    p = sub.add_parser("plan")
    p.add_argument("--json", action="store_true")
    d = sub.add_parser("done")
    d.add_argument("outdirs", nargs="*")
    d.add_argument("--no-ingest", action="store_true")
    c = sub.add_parser("catalog")
    c.add_argument("--backfill", action="store_true", help="(same as no flag: indexing is always idempotent)")
    w = sub.add_parser("wait")
    w.add_argument("id")
    w.add_argument("--year", type=int, help="return as soon as a running build with this branch reaches this year")
    w.add_argument("--timeout", type=float, default=6900)
    sh = sub.add_parser("show")
    sh.add_argument("id", nargs="?")
    sh.add_argument("--all", action="store_true")
    for name in ("cancel", "hold", "release"):
        x = sub.add_parser(name)
        x.add_argument("id")
    rn = sub.add_parser("renew")
    rn.add_argument("id")
    rn.add_argument("--hours", type=float, default=48)
    nt = sub.add_parser("notify")
    nt.add_argument("--peek", action="store_true", help="print without marking them passed on")
    stt = sub.add_parser("start")
    stt.add_argument("step", type=int, help="step number from `cwp-runs plan`")
    us = sub.add_parser("unstart")
    us.add_argument("token", help="the in-flight token `cwp-runs plan` shows")
    g = sub.add_parser("gh")
    g.add_argument("ref")
    a = ap.parse_args(argv)
    if a.cmd is None:
        print(__doc__)
        return 0
    RUNS.mkdir(parents=True, exist_ok=True)
    if a.cmd == "submit":
        cmd_submit(a)
    elif a.cmd == "baselines":
        cmd_baselines(a)
    elif a.cmd == "runs":
        cmd_runs(a)
    elif a.cmd == "plan":
        cmd_plan(a)
    elif a.cmd == "done":
        cmd_done(a)
    elif a.cmd == "catalog":
        cmd_catalog(a)
    elif a.cmd == "wait":
        return cmd_wait(a)
    elif a.cmd == "show":
        cmd_show(a)
    elif a.cmd == "cancel":
        set_state(a.id, "cancelled")
    elif a.cmd == "hold":
        set_state(a.id, "held")
    elif a.cmd == "release":
        set_state(a.id, "pending", only_from=("held",))
    elif a.cmd == "renew":
        set_state(a.id, "pending", only_from=("pending", "expired"), expires=iso(now() + dt.timedelta(hours=a.hours)))
    elif a.cmd == "notify":
        cmd_notify(a)
    elif a.cmd == "start":
        return cmd_start(a)
    elif a.cmd == "unstart":
        if not re.fullmatch(r"[0-9a-z-]+", a.token):
            die("a token looks like 1120142117-695c666fc-81b5 (see cwp-runs plan)")
        f = RUNS / "started" / f"{a.token}.json"
        if not f.exists():
            die(f"no started step {a.token} (cwp-runs plan lists the ones in flight)")
        with runs_lock():
            rec = json.loads(f.read_text())
            rec["closed"] = "unstarted by hand"
            write_json(f, rec)
        print(f"{a.token}: no longer in flight; the next plan books it again if it is still needed")
    elif a.cmd == "gh":
        sha = resolve(a.ref) or die(f"cannot resolve {a.ref}")
        print(gameplay_hash(sha))
    return 0


if __name__ == "__main__":
    sys.exit(main())
