#!/usr/bin/env bash
# cwp-vic: shared Victoria 3 test harness for agents on the Forge machine.
#
# Only one Victoria 3 may run at a time (shared GPU), and several agents share the machine.
# Every game session therefore holds ~/forge/.vic3.lock from launch until the game is stopped.
#
#   cwp-vic status                  who holds the lock, which worktree is linked, running games
#   cwp-vic lock [--wait S] [--priority] [NOTE]  take the lock, first come first served (waits up to S s, default 4 h (CWP_VIC_WAIT);
#                                   --priority jumps normal requests, coordinator-approved only)
#   cwp-vic queue                   list waiting requests in the order they will be served
#   cwp-vic bump <pid|text>         move a waiting request to the front (coordinator's call)
#   cwp-vic job <name> -- <cmd...>  run a game job under systemd --user (survives Claude session restarts);
#                                   log in ~/forge/jobs/<name>.log. Use this for every observer/bench run.
#   lock --owner-pid PID            release the lock as soon as PID (the runner) exits
#   cwp-vic link <worktree>         enable that worktree as the only mod (content_load.json)  (needs lock)
#   cwp-vic vanilla                 disable the mod for a vanilla baseline run               (needs lock)
#   cwp-vic launch [game args]      clear error.log and start the game in debug mode         (needs lock)
#   cwp-vic stop [--all]            stop the game you launched (--all: every Victoria 3, only if orphaned)
#   cwp-vic unlock [--force]        stop the game and release the lock
#   cwp-vic errors                  this session's error log (rotated files included) minus known noise
#   cwp-vic perf [SECONDS] [STEP]   sample CPU/RAM/VRAM of the game into a CSV (default 600 s, 15 s)
#
# Typical session:
#   cwp-vic lock "politics: law port smoke test" && cwp-vic link ~/forge/worktrees/politics \
#     && cwp-vic launch    ...  vic-shot / vic-key / cwp-vic errors ...   cwp-vic unlock
#
# The lock is a flock(1) on ~/forge/.vic3.lock held by a background `sleep`, so it is released
# automatically if the holder dies, and plain `flock ~/forge/.vic3.lock <cmd>` callers queue
# behind it correctly. A lock is held at most CWP_VIC_MAX_HOLD seconds (default 7200).
set -uo pipefail

FORGE="${FORGE:-$HOME/forge}"
LOCK="$FORGE/.vic3.lock"
HOLDER="$FORGE/.vic3.lock.holder"      # pid of the sleep that holds the flock
OWNER="$FORGE/.vic3.lock.owner"        # free-text note: who and why, since when
GAMEPID="$FORGE/.vic3.game.pid"        # pid of the game started by the current lock holder
OWNERPID="$FORGE/.vic3.lock.ownerpid"  # --owner-pid of the holder (0 if none); vic-guard lets only its descendants drive the game
USERDIR="$HOME/.local/share/Paradox Interactive/Victoria 3"
CONTENT="$USERDIR/content_load.json"   # what the game mounts when started without the launcher
ERRLOG="$USERDIR/logs/error.log"
MAX_HOLD="${CWP_VIC_MAX_HOLD:-7200}"
# The game runs as "./victoria3 -debug_mode" from its binaries folder; match both spellings.
GAME_PAT='(^|/|\./)victoria3( |$)'

die()  { echo "cwp-vic: $*" >&2; exit 1; }
game_pids() { pgrep -f "$GAME_PAT" | while read -r p; do
  [[ "$(readlink "/proc/$p/exe" 2>/dev/null)" == */binaries/victoria3 ]] && echo "$p"; done; }
holder_alive() { [[ -s "$HOLDER" ]] && kill -0 "$(cat "$HOLDER")" 2>/dev/null; }
need_lock() { holder_alive || die "you must hold the lock first: cwp-vic lock \"<who>: <why>\""; }

cmd_status() {
  if holder_alive; then echo "lock:    HELD (pid $(cat "$HOLDER")) by: $(cat "$OWNER" 2>/dev/null)"
  elif ! flock -n "$LOCK" true 2>/dev/null; then
    echo "lock:    HELD by a plain flock caller (not cwp-vic); holder and queue:"
    for p in /proc/[0-9]*; do ls -l "$p/fd" 2>/dev/null | grep -qF "$LOCK" && \
      echo "         pid ${p#/proc/}: $(tr '\0' ' ' < "$p/cmdline" | cut -c1-120)"; done
  else echo "lock:    free"; fi
  if [[ -f "$CONTENT" ]]; then echo "enabled: $(tr -d '\n\t ' < "$CONTENT")"; else echo "enabled: (no content_load.json: vanilla)"; fi
  local pids; pids=$(game_pids | tr '\n' ' ')
  if [[ -n "$pids" ]]; then
    for p in $pids; do echo "game:    pid $p, up $(ps -o etime= -p "$p" | tr -d ' '), RSS $(( $(ps -o rss= -p "$p") / 1024 )) MB"; done
  else echo "game:    not running"; fi
  nvidia-smi --query-gpu=memory.used,memory.total --format=csv,noheader 2>/dev/null | sed 's/^/gpu:     /'
}

QUEUE="$FORGE/.vic3.queue"            # FIFO tickets: <order>-<pid>, content = note; dead pids are dropped

queue_clean() { local t; for t in "$QUEUE"/*; do [[ -e "$t" ]] || continue
  kill -0 "${t##*-}" 2>/dev/null || rm -f "$t"; done; }
queue_first() { queue_clean; ls "$QUEUE" 2>/dev/null | sort | head -1; }

cmd_lock() {
  local wait="${CWP_VIC_WAIT:-14400}" prio=5 owner_pid="${CWP_VIC_OWNER_PID:-0}"
  while [[ "${1:-}" == --* ]]; do
    case "$1" in --wait) wait="$2"; shift 2 ;; --priority) prio=1; shift ;; --owner-pid) owner_pid="$2"; shift 2 ;;
      *) die "unknown option $1" ;; esac
  done
  local note="${*:-${CWP_AGENT:-$(basename "$PWD")}}"
  holder_alive && echo "lock is held by: $(cat "$OWNER" 2>/dev/null); queueing behind it"
  touch "$LOCK"; mkdir -p "$QUEUE"
  # Tickets are served oldest first (--priority, for the coordinator's urgent work, goes ahead of normal ones).
  local ticket; ticket="$prio$(date +%s%N)-$$"
  printf '%s (queued %s)\n' "$note" "$(date '+%F %T %Z')" > "$QUEUE/$ticket"
  child="" taken=0   # globals on purpose: the EXIT trap runs after this function returns
  # If this wrapper is killed or times out, take our ticket and our not-yet-successful taker with us
  # (the taker is a setsid group leader, so kill its whole group, including the flock it runs).
  trap 'rm -f "$QUEUE/'"$ticket"'"; [[ $taken == 0 && -n "$child" ]] && kill -- -"$child" 2>/dev/null' EXIT
  trap 'exit 1' INT TERM HUP
  local stamp; stamp="$note (since $(date '+%F %T %Z'), req $$-$RANDOM)"
  local deadline=$((SECONDS + wait))
  echo "queued (position $(( $(ls "$QUEUE" | sort | grep -n "^$ticket$" | cut -d: -f1) ))); waiting up to ${wait}s ..."
  while (( SECONDS < deadline )); do
    if [[ -z "$child" ]]; then
      # Spawn the taker only when we are first in line AND the lock is free right now, so a later
      # higher-priority ticket is not overtaken by a taker already blocked inside flock.
      # Find our ticket by pid each time: `cwp-vic bump` may have renamed it to reorder the queue.
      local mine; mine=$(ls "$QUEUE" 2>/dev/null | grep -- "-$$\$" | head -1); [[ -n "$mine" ]] && ticket=$mine
      # Stale holder (OFF unless CWP_VIC_STALE is set): the first in line releases a lock whose holder has
      # had no game running for CWP_VIC_STALE seconds, e.g. a session that forgot to unlock. Never applies to
      # an --owner-pid holder whose runner is alive (those free the lock themselves when the runner dies).
      # Caveat: the released session is not told, and its later cwp-vic stop/unlock would act on the new holder.
      local op; op=$(cat "$OWNERPID" 2>/dev/null)
      if (( ${CWP_VIC_STALE:-0} > 0 )) && [[ "$(queue_first)" == "$ticket" ]] && holder_alive \
         && ! { [[ "$op" =~ ^[0-9]+$ ]] && (( op > 0 )) && kill -0 "$op" 2>/dev/null; }; then
        if [[ -n "$(game_pids)" ]]; then rm -f "$FORGE/.vic3.idle-since"
        else
          [[ "$(cut -d" " -f1 "$FORGE/.vic3.idle-since" 2>/dev/null)" == "$(cat "$HOLDER")" ]] || echo "$(cat "$HOLDER") $(date +%s)" > "$FORGE/.vic3.idle-since"
          if (( $(date +%s) - $(cut -d" " -f2 "$FORGE/.vic3.idle-since") > CWP_VIC_STALE )); then
            echo "$(date '+%F %T') released stale lock of: $(cat "$OWNER" 2>/dev/null) (no game for ${CWP_VIC_STALE}s; next: $note)" \
              | tee -a "$FORGE/jobs/stale-releases.log" >&2
            local hp; hp=$(cat "$HOLDER" 2>/dev/null); rm -f "$HOLDER" "$OWNER" "$OWNERPID" "$FORGE/.vic3.idle-since"; kill "$hp" 2>/dev/null
          fi
        fi
      fi
      if [[ "$(queue_first)" == "$ticket" ]] && ! holder_alive && flock -n "$LOCK" true 2>/dev/null; then
        # Our turn: the child takes the flock on fd 9, records itself as holder and becomes a sleep that keeps
        # fd 9 open. Holder files are only written by whoever has the flock, so waiters never clobber them.
        # With --owner-pid, the holder gives the lock back as soon as that process (the runner) is gone,
        # so a runner killed by a restart cannot keep the game slot for hours.
        setsid bash -c 'exec 9>>"$1"; flock -w "$2" 9 || exit 1; echo "$7" > "$8"; echo $$ > "$3"; printf "%s\n" "$5" > "$4"
          if [ "$7" -gt 0 ]; then end=$(( $(date +%s) + $6 )); while kill -0 "$7" 2>/dev/null && [ "$(date +%s)" -lt "$end" ]; do sleep 5; done
          else exec sleep "$6"; fi' \
          _ "$LOCK" "$((deadline - SECONDS + 1))" "$HOLDER" "$OWNER" "$stamp" "$MAX_HOLD" "$owner_pid" "$OWNERPID" </dev/null >/dev/null 2>&1 &
        child=$!
      fi
    else
      if [[ "$(cat "$OWNER" 2>/dev/null)" == "$stamp" ]] && holder_alive; then
        taken=1; rm -f "$QUEUE/$ticket" "$FORGE/.vic3.idle-since"; echo "lock taken: $note"
        # Nobody else can be using the game now: a game still running is an orphan of a dead runner.
        if [[ -n "$(game_pids)" ]]; then echo "orphaned Victoria 3 found (pids $(game_pids | tr '\n' ' ')): stopping it"; cmd_stop --all; fi
        return 0
      fi
      kill -0 "$child" 2>/dev/null || break
    fi
    sleep 1
  done
  die "could not get the lock within ${wait}s (held by: $(cat "$OWNER" 2>/dev/null))"
}

cmd_bump() {   # move a waiting request (by pid or text in its note) to the front of the line
  local m t; m="${1:?usage: cwp-vic bump <pid|text>}"
  t=$(ls "$QUEUE" | while read -r x; do [[ "${x##*-}" == "$m" ]] || grep -qF -- "$m" "$QUEUE/$x" && echo "$x"; done | head -1)
  [[ -n "$t" ]] || die "no queued request matches '$m'"
  mv "$QUEUE/$t" "$QUEUE/0$(date +%s%N)-${t##*-}"; echo "moved to front: $(cat "$QUEUE"/0*-"${t##*-}")"
  echo "note: only requests made with cwp-vic from 2026-11-17 on follow a bump; an older waiting request would stall the line" >&2
}

cmd_job() {   # run a game job outside the Claude process tree, so it survives session restarts
  local name="${1:?usage: cwp-vic job <name> -- <command...>}"; shift; [[ "${1:-}" == "--" ]] && shift
  (( $# )) || die "usage: cwp-vic job <name> -- <command...>"
  mkdir -p "$FORGE/jobs"; local log="$FORGE/jobs/$name.log"
  if command -v systemd-run >/dev/null && systemctl --user show-environment >/dev/null 2>&1; then
    # A systemd unit starts with an almost empty environment; the game needs this session's display,
    # X auth, runtime dir and graphics (Vulkan) variables, so the unit replays the caller's exported env.
    export DISPLAY="${DISPLAY:-:0}"; local envf="$FORGE/jobs/$name.env"; export -p > "$envf"
    systemd-run --user --collect --unit="cwp-job-$name" -p WorkingDirectory="$PWD" \
      bash -c 'set -a; . "$1"; set +a; shift; exec "$@" >>"$0" 2>&1' "$log" "$envf" "$@" || die "systemd-run failed"
    echo "job cwp-job-$name started (systemd --user). log: $log   status: systemctl --user status cwp-job-$name"
  else
    setsid nohup "$@" >>"$log" 2>&1 </dev/null & disown
    echo "job $name started (setsid, pid $!). log: $log"
  fi
}

cmd_queue() { queue_clean; local t; for t in $(ls "$QUEUE" 2>/dev/null | sort); do echo "  $t  $(cat "$QUEUE/$t")"; done; }

write_content_load() {   # $1 = mod path or empty for vanilla
  local mods='[]'
  [[ -n "${1:-}" ]] && mods="[ { \"path\": \"$1\" } ]"
  printf '{\n\t"enabledMods": %s,\n\t"enabledUGC": [],\n\t"disabledDLC": []\n}\n' "$mods" > "$CONTENT"
}

cmd_link() {
  need_lock
  local wt; wt=$(readlink -f "${1:?usage: cwp-vic link <worktree>}")
  [[ -f "$wt/.metadata/metadata.json" ]] || die "$wt has no .metadata/metadata.json; not a mod root"
  [[ -n "$(game_pids)" ]] && die "stop the game before relinking (cwp-vic stop)"
  # The game mounts content_load.json paths directly; no copy or link in the mod folder is needed.
  # NO trailing slash: with "path/" the mod mounts but its replace_paths are silently ignored
  # (verified 2026-11-16: 11,602 error lines with the slash vs 18 without, same commit).
  write_content_load "${wt%/}"
  echo "enabled $wt ($(git -C "$wt" rev-parse --abbrev-ref HEAD 2>/dev/null) @ $(git -C "$wt" rev-parse --short HEAD 2>/dev/null))"
}

cmd_vanilla() { need_lock; [[ -n "$(game_pids)" ]] && die "stop the game first"; write_content_load ""; echo "mod disabled; next launch is vanilla"; }

cmd_launch() {
  rm -f "$FORGE/.vic3.idle-since"   # a launch resets the stale-holder idle clock
  need_lock
  [[ -n "$(game_pids)" ]] && die "a Victoria 3 is already running (pids $(game_pids | tr '\n' ' ')). Find its owner (cwp-vic status) before stopping it."
  # error.log rotates by size (~512 KB) into error.1..5.log within one session; clear them all so
  # everything left afterwards belongs to this launch.
  mkdir -p "$(dirname "$ERRLOG")"; : > "$ERRLOG" 2>/dev/null || true
  rm -f "$(dirname "$ERRLOG")"/error.[0-9].log
  # Also start debug/game logs fresh: the canary in `errors` reads them, and a previous session's
  # lines (another worktree's files) would otherwise show up as leaks.
  local f; for f in "$(dirname "$ERRLOG")"/{debug,game}.log; do [[ -f "$f" ]] && : > "$f"; done
  rm -f "$(dirname "$ERRLOG")"/{debug,game}.[0-9].log
  # A CWP game needs ~7 GB RAM. Launching on a short machine sends the kernel OOM killer after the
  # game or the desktop session (2026-11-17 16:19: the desktop died and Forge sat at the login screen).
  local need="${CWP_VIC_MIN_FREE_MB:-7000}" avail; avail=$(awk '/MemAvailable/ {print int($2/1024)}' /proc/meminfo)
  if (( avail < need )); then
    echo "cwp-vic: only ${avail} MB RAM available (need ${need}); waiting up to 10 min for memory to free up..." >&2
    for _ in $(seq 1 60); do sleep 10; avail=$(awk '/MemAvailable/ {print int($2/1024)}' /proc/meminfo); (( avail >= need )) && break; done
    (( avail >= need )) || die "not enough free RAM to launch safely (${avail} MB < ${need} MB). Close something or set CWP_VIC_MIN_FREE_MB."
  fi
  vic-launch "$@"; local rc=$?
  game_pids | head -1 > "$GAMEPID"
  return $rc
}

cmd_stop() {   # stops the game this lock holder launched; --all stops every Victoria 3
  local pids
  if [[ "${1:-}" == "--all" ]]; then pids=$(game_pids)
  else pids=$(cat "$GAMEPID" 2>/dev/null); [[ -n "$pids" ]] && ! kill -0 "$pids" 2>/dev/null && pids=""; fi
  [[ -z "$pids" ]] && { echo "no game of ours running (see cwp-vic status; --all stops every instance)"; rm -f "$GAMEPID"; return 0; }
  kill -INT $pids 2>/dev/null
  for _ in $(seq 1 20); do kill -0 $pids 2>/dev/null || break; sleep 1; done
  kill $pids 2>/dev/null; sleep 2; kill -9 $pids 2>/dev/null
  rm -f "$GAMEPID"; echo "Victoria 3 stopped (pid $pids)"
}

cmd_unlock() {
  holder_alive || { echo "lock was not held"; rm -f "$HOLDER" "$OWNER" "$OWNERPID"; return 0; }
  if [[ "${1:-}" != "--force" && -n "${CWP_AGENT:-}" ]] && ! grep -qF "$CWP_AGENT" "$OWNER" 2>/dev/null; then
    die "lock belongs to: $(cat "$OWNER"). Use --force only if that thread is gone."
  fi
  cmd_stop
  local hp; hp=$(cat "$HOLDER"); rm -f "$HOLDER" "$OWNER" "$OWNERPID"   # remove first: the next holder rewrites them
  kill "$hp" 2>/dev/null
  echo "lock released (run 'game-mode off' if nobody else needs the game)"
}

cmd_errors() {
  [[ -f "$ERRLOG" ]] || die "no error.log yet"
  # The whole session, oldest first: rotated error.5..1.log, then error.log.
  local d f files=(); d=$(dirname "$ERRLOG")
  for f in "$d"/error.5.log "$d"/error.4.log "$d"/error.3.log "$d"/error.2.log "$d"/error.1.log "$ERRLOG"; do
    [[ -f "$f" ]] && files+=("$f"); done
  (( ${#files[@]} > 1 )) && echo "cwp-vic: reading ${#files[@]} log files (error.log rotated; 5 rotations max, older lines are lost)" >&2
  # Engine noise ignored on purpose; keep in step with the ignore list in .claude/reference/debugging.md.
  cat "${files[@]}" | grep -vE 'Could not find item in store backend'
  # Canary: vanilla files from replaced folders in the logs mean replace_paths were not applied.
  local modroot canary
  modroot=$(python3 -c 'import json,sys;m=json.load(open(sys.argv[1]))["enabledMods"];print(m[0]["path"] if m else "")' "$CONTENT" 2>/dev/null)
  canary="$(dirname "$(readlink -f "$0")")/replace_paths_canary.py"
  if [[ -n "$modroot" && -f "$canary" ]]; then
    python3 "$canary" "$modroot" "$d"/game*.log "$d"/debug*.log "${files[@]}" || true
  fi
}

cmd_perf() {
  local secs="${1:-600}" step="${2:-15}" pid out
  pid=$(game_pids | head -1); [[ -n "$pid" ]] || die "game not running"
  out="$FORGE/perf/$(date +%Y%m%d-%H%M%S).csv"; mkdir -p "$FORGE/perf"
  echo "time,elapsed_s,cpu_pct,rss_mb,vram_used_mb,errorlog_lines" > "$out"
  local t0=$SECONDS
  while (( SECONDS - t0 < secs )) && kill -0 "$pid" 2>/dev/null; do
    printf '%s,%s,%s,%s,%s,%s\n' "$(date +%T)" "$((SECONDS - t0))" \
      "$(ps -o %cpu= -p "$pid" | tr -d ' ')" "$(( $(ps -o rss= -p "$pid") / 1024 ))" \
      "$(nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits 2>/dev/null | head -1)" \
      "$(wc -l < "$ERRLOG" 2>/dev/null || echo 0)" >> "$out"
    sleep "$step"
  done
  echo "$out"
}

case "${1:-status}" in
  status)  cmd_status; echo "queue:"; cmd_queue ;;
  queue)   cmd_queue ;;
  bump)    shift; cmd_bump "$@" ;;
  job)     shift; cmd_job "$@" ;;
  lock)    shift; cmd_lock "$@" ;;
  link)    shift; cmd_link "$@" ;;
  vanilla) cmd_vanilla ;;
  launch)  shift; cmd_launch "$@" ;;
  stop)    shift; cmd_stop "$@" ;;
  unlock)  shift; cmd_unlock "$@" ;;
  errors)  cmd_errors ;;
  perf)    shift; cmd_perf "$@" ;;
  *)       sed -n '2,24p' "$0" ;;
esac
