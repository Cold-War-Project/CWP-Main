#!/usr/bin/env bash
# cwp-gui-batch: one shared game launch for everyone's GUI screenshot checks (Jack's rule: every
# GUI-facing change is screenshot-checked in game before it lands).
#
# Book a check: drop a bash script in ~/forge/gui-checks/book/<name>.sh. First line(s) may say
#   # branch: <local branch to include>        (repeatable; merged on top of CWP2 for the batch)
#   # needs-game: yes                           (start a 1946 observer game before your steps; default: main menu)
# The script runs with these helpers and must finish within 4 minutes:
#   shot <label>           screenshot -> $OUT/<label>.png (full resolution)
#   console "<command>"    run an in-game console command
#   click X Y / key KEY... (vic-click / vic-key on 1280x720 screenshot coordinates). Prefer clicks to
#                          F-key shortcuts: Xfce grabs F-keys; key() sends them to the game window, which may ignore them.
# Results: ~/forge/gui-checks/done/<date>-<name>/ (PNGs, log); the booking is moved there too.
#
#   cwp-gui-batch run      run all bookings now (takes the game lock with priority; ~15 min)
#   cwp-gui-batch list     show bookings
set -u
B=~/forge/gui-checks/book; D=~/forge/gui-checks/done
export DISPLAY=:0 CWP_AGENT=gui-batch XAUTHORITY="${XAUTHORITY:-$HOME/.Xauthority}" PATH="$HOME/.local/bin:/usr/local/bin:$PATH"   # systemd timer units start with a bare environment
case "${1:-list}" in
  list) ls -1 "$B"/*.sh 2>/dev/null | xargs -r -n1 basename; exit 0 ;;
  run) ;;
  *) sed -n '2,20p' "$0"; exit 1 ;;
esac
(( $(ls -1 "$B"/*.sh 2>/dev/null | wc -l) )) || { echo "no bookings"; exit 0; }
stamp=$(date +%Y%m%d-%H%M)
WT=~/forge/worktrees/gui-batch
if [[ ! -d $WT ]]; then git -C ~/forge/CWP-Main worktree add -q --detach "$WT" origin/CWP2; fi
cwp-vic lock --owner-pid $$ --priority "gui-batch: screenshot checks (~15 min)" || exit 1
trap 'cwp-vic unlock >/dev/null' EXIT
# Bookings and branch heads are read only now that the game is ours, so late bookings and new commits count.
mapfile -t books < <(ls -1 "$B"/*.sh 2>/dev/null)
(( ${#books[@]} )) || { echo "no bookings"; exit 0; }
branches=$(grep -h '^# branch:' "${books[@]}" | awk '{print $3}' | awk '!s[$0]++')
needs_game=$(grep -lh '^# needs-game: yes' "${books[@]}" | head -1)
git -C ~/forge/CWP-Main fetch -q origin CWP2
git -C "$WT" checkout -q --detach origin/CWP2
for br in $branches; do git -C "$WT" merge -q --no-ff --no-edit -m "gui-batch: $br" "$br" >/dev/null 2>&1 \
  || { git -C "$WT" merge --abort; echo "branch $br: CONFLICT, skipped" | tee -a "$D/$stamp-batch.log"; }; done
# A failed launch or game start keeps the bookings for the next hour (20 Nov: a launch that never
# happened produced black screenshots and the bookings were deleted).
keep() { echo "$(date +%T) $1; bookings kept for the next batch" | tee -a "$D/$stamp-batch.log"; exit 1; }
cwp-vic link "$WT" >/dev/null && cwp-vic launch > "$D/$stamp-launch.txt" 2>&1 || keep "LAUNCH FAILED (see $stamp-launch.txt)"
sleep 200
cwp-vic status | grep -q "game:    pid" || keep "GAME NOT RUNNING after launch"
for w in $(xdotool search --name "Unlock Keyring|Authentication required" 2>/dev/null); do xdotool windowclose "$w"; done
raise_game() { local w; w=$(xdotool search --name "^Victoria 3" 2>/dev/null | tail -1); [[ -n "$w" ]] && xdotool windowactivate --sync "$w" 2>/dev/null; }
raise_game; vic-shot >/dev/null
SAVES="$HOME/.local/share/Paradox Interactive/Victoria 3/save games"
if [[ -n "$needs_game" ]]; then
  # New Game -> Sandbox -> Observe, unpaused at speed 2; confirm with a fresh autosave, retry once.
  for try in 1 2; do
    touch "$D/.$stamp-start"
    raise_game; vic-shot >/dev/null; vic-click 266 284 >/dev/null; sleep 8
    raise_game; vic-shot >/dev/null; vic-click 1086 330 >/dev/null; sleep 100
    raise_game; vic-shot >/dev/null; vic-click 566 702 >/dev/null; sleep 5
    raise_game; vic-key 2 >/dev/null; vic-key space >/dev/null
    for _ in $(seq 1 24); do sleep 10; f=$(ls -t "$SAVES"/autosave*.v3 2>/dev/null | head -1)
      [[ -n "$f" && "$f" -nt "$D/.$stamp-start" ]] && break 2; done
    echo "game start attempt $try failed" | tee -a "$D/$stamp-batch.log"; vic-shot --full | tail -1 >> "$D/$stamp-batch.log"
    raise_game; vic-key Escape >/dev/null; sleep 2; vic-key Escape >/dev/null; sleep 5
    (( try == 2 )) && keep "GAME DID NOT START (needs-game)"
  done
  raise_game; vic-key space >/dev/null   # pause for the checks
fi
raise_game() { local w; w=$(xdotool search --name "^Victoria 3" 2>/dev/null | tail -1); [[ -n "$w" ]] && xdotool windowactivate --sync "$w" 2>/dev/null; }
# Full-res PNG for the record, then a scaled shot so later click() coordinates stay on the 1280x720 scale.
shot()    { raise_game; local f; f=$(vic-shot --full | tail -1); cp "$f" "$OUT/$1.png"; vic-shot >/dev/null; echo "shot $1" >> "$OUT/log.txt"; }
console() { raise_game; vic-key grave >/dev/null; sleep 1; vic-key --type "$1" >/dev/null; vic-key Return >/dev/null; sleep 1; vic-key grave >/dev/null; sleep 1; }
click()   { raise_game; vic-click "$@" >/dev/null; sleep 1; }
# F-keys are grabbed by Xfce (F4 opens the Application Finder): send those straight to the game window.
key()     { raise_game; local k; for k in "$@"; do
            if [[ "$k" =~ ^F[0-9]+$ ]]; then xdotool key --window "$(xdotool search --name '^Victoria 3' | tail -1)" "$k"; else vic-key "$k" >/dev/null; fi
          done; sleep 1; }
# The pause menu sits at a fixed place: compare the "Return to Game" button with a template (diff < 5 = open).
TEMPLATE="${CWP_PAUSE_TEMPLATE:-$(dirname "$(readlink -f "$0")")/pause_menu_template.png}"; export TEMPLATE
[[ -r "$TEMPLATE" ]] || echo "WARNING: no pause-menu template at $TEMPLATE; menu detection off" | tee -a "$D/$stamp-batch.log"
menu_open() { local f; f=$(vic-shot --full | tail -1); vic-shot >/dev/null
  python3 -I -c 'import sys
from PIL import Image, ImageChops, ImageStat
t = Image.open(sys.argv[1]); im = Image.open(sys.argv[2]).convert("L")
sys.exit(0 if im.size == (1920, 1080) and ImageStat.Stat(ImageChops.difference(t, im.crop((290, 300, 645, 350)))).mean[0] < 5 else 1)' "$TEMPLATE" "$f"; }
# Leave the game on the map: one Escape closes a panel left open, and if that Escape opened the pause menu instead, close it.
# Escape until the pause menu shows (every panel is closed by then), then close it: covers nested panels.
ui_reset() { raise_game; menu_open && { vic-key Escape >/dev/null; sleep 2; }
             local i; for i in 1 2 3 4; do vic-key Escape >/dev/null; sleep 2; menu_open && { vic-key Escape >/dev/null; sleep 2; break; }; done; return 0; }
export -f raise_game shot console click key menu_open ui_reset
for bk in "${books[@]}"; do
  name=$(basename "$bk" .sh); export OUT="$D/$stamp-$name"; mkdir -p "$OUT"; cp "$bk" "$OUT/"
  ui_reset; echo "$(date +%T) start $name" >> "$OUT/log.txt"
  timeout 240 bash -c 'source "$1"' _ "$bk" >> "$OUT/log.txt" 2>&1; echo "$(date +%T) end $name rc=$?" >> "$OUT/log.txt"
  rm -f "$bk"; ui_reset
done
cwp-vic errors > "$D/$stamp-errors.txt" 2>&1
echo "batch $stamp done: ${#books[@]} checks, results in $D/$stamp-*"
