#!/usr/bin/env bash
# cwp-observe: one shared long observer game, with periodic state dumps for every area to tune from.
#   cwp-observe <mod worktree> [END_YEAR=1956] [OUT=~/forge/observer/<date>-<sha>]
#   CWP_OBSERVE_REBUILD=1 rebuilds the integration tree from the staging queue right after taking the lock.
# Takes the game lock, starts a new game in observer mode at max speed, and every ~2 minutes copies the
# newest autosave and dumps it with cwp-save-dump (journal entries, bars, wars, cwp_ flags, key tags).
# Stops at END_YEAR, writes errors + per-PR attribution + perf CSV, unlocks. Clicks assume 1920x1080.
set -u
WT=$(readlink -f "${1:?usage: cwp-observe <worktree> [end_year] [outdir]}"); END=${2:-1956}
export CWP_VIC_MAX_HOLD=${CWP_VIC_MAX_HOLD:-$(( (END - 1946) * 240 + 3600 ))}   # hold long enough for the whole run
cwp-vic lock --owner-pid $$ --wait "${CWP_OBSERVE_WAIT:-14400}" ${CWP_OBSERVE_PRIORITY:+--priority} "observer: shared run $(basename "$WT") to $END" || exit 1
trap 'cwp-vic unlock >/dev/null' EXIT
# Disk guard: a run writes 1-3 GB (save copies, dumps) and the game's own autosaves fail on a full disk.
free_gb() { local v; v=$(df -P --block-size=1G "$HOME/forge" 2>/dev/null | awk 'NR==2{print $4}'); [[ $v =~ ^[0-9]+$ ]] && echo "$v" || echo 999; }
if (( $(free_gb) < ${CWP_OBSERVE_MIN_FREE_GB:-10} )); then
  echo "cwp-observe: only $(free_gb) GB free (need ${CWP_OBSERVE_MIN_FREE_GB:-10}); not starting. Free space first, never by deleting run outputs." >&2
  [[ -n "${3:-}" ]] && { mkdir -p "$3"; echo "not started: low disk" > "$3/DISKFULL"; }   # closes a cwp-runs booking at once
  exit 4; fi
# CWP_OBSERVE_REBUILD=1: rebuild the integration tree from the staging queue only once the game is ours,
# so the round tests the newest heads no matter how long it waited in line.
[[ -n "${CWP_OBSERVE_REBUILD:-}" ]] && cwp-integrate build > "$HOME/forge/jobs/last-rebuild.txt" 2>&1
SHA=$(git -C "$WT" rev-parse --short HEAD)
OUT=${3:-$HOME/forge/observer/$(date +%Y%m%d-%H%M)-$SHA}; mkdir -p "$OUT/saves"
{ echo "tree: $WT"; echo "build: $SHA ($(git -C "$WT" rev-parse --abbrev-ref HEAD))"; echo "started: $(date '+%F %T %Z')"
  [[ -f "$WT/.integration/prs.tsv" ]] && { echo "PRs (number, branch, merge result):"; cut -f1-3 "$WT/.integration/prs.tsv"; }
} > "$OUT/BUILD.txt"
export DISPLAY=:0 CWP_AGENT=${CWP_AGENT:-observer}
U="$HOME/.local/share/Paradox Interactive/Victoria 3"; SAVES="$U/save games"
cwp-vic link "$WT" >/dev/null && cwp-vic launch > "$OUT/launch.out" 2>&1
# Desktop popups (e.g. "Unlock Keyring" after a re-login) steal focus and swallow the clicks below.
clear_popups() { local w; for w in $(xdotool search --name "Unlock Keyring|Authentication required" 2>/dev/null); do
  echo "$(date +%T) closed popup: $(xdotool getwindowname "$w")" >> "$OUT/popups.txt"; xdotool windowclose "$w" 2>/dev/null || xdotool windowkill "$w"; done; }
sleep 170; cwp-vic errors > "$OUT/errors_menu.txt" 2> "$OUT/canary_menu.txt"
clear_popups
start_game() {   # main menu -> New Game -> Sandbox card -> (country select) Observe -> speed 5, unpause
  clear_popups; vic-click 266 284 >/dev/null; sleep 6; clear_popups; vic-click 1086 330 >/dev/null; sleep 100
  clear_popups; vic-click 566 702 >/dev/null; sleep 4; clear_popups; vic-key 5 >/dev/null; vic-key space >/dev/null
}
# The menu can take longer than 170 s on a big build; if no autosave newer than our start shows up
# within 6 min, back out to the menu and try again (3 tries).
for try in 1 2 3; do
  touch "$OUT/.started"; start_game
  for _ in $(seq 1 36); do sleep 10; f=$(ls -t "$SAVES"/autosave*.v3 2>/dev/null | head -1); [[ -n "$f" && "$f" -nt "$OUT/.started" ]] && break 2; done
  vic-shot > "$OUT/retry${try}_shot.txt"; echo "$(date +%T) start attempt $try failed, retrying" >> "$OUT/progress.txt"
  vic-key Escape >/dev/null; sleep 2; vic-key Escape >/dev/null; sleep 5
done
MAXS=${CWP_OBSERVE_MAX_SECONDS:-$(( (END - 1946) * 240 + 1800 ))}   # ~4 min per game year at max speed, plus slack
cwp-vic perf "$MAXS" 30 > "$OUT/perf_path.txt" 2>&1 &
PERF=$!
# Stall watchdog: a stray click or key from another session can open a panel or pause the game.
# Autosaves come every 15-30 s at speed 5, so none for STALL seconds means the game is stuck:
# screenshot it, then try a different nudge every 2 min (toggle pause, close a panel); give up after 8.
STALL=${CWP_OBSERVE_STALL_SECONDS:-600}; nudges=0
last=""; t0=$SECONDS
while (( SECONDS - t0 < MAXS )); do
  sleep 120
  cwp-vic status | grep -q "game:    pid" || { echo "GAME NOT RUNNING (crash?) at $((SECONDS-t0))s" | tee "$OUT/CRASH"; break; }
  (( $(free_gb) < 3 )) && { echo "DISK NEARLY FULL ($(free_gb) GB free): stopping the run before saves fail" | tee "$OUT/DISKFULL"; break; }
  clear_popups
  f=$(ls -t "$SAVES"/autosave*.v3 2>/dev/null | head -1)
  # No autosave newer than our game start after 8 minutes: the game never started (popup, wrong click).
  if [[ ! -f "$OUT/.last" ]] && (( SECONDS - t0 > 480 )) && ! [[ -n "$f" && "$f" -nt "$OUT/.started" ]]; then
    vic-shot > "$OUT/nostart_shot.txt"; echo "GAME DID NOT START: no autosave after 8 min (see nostart_shot.txt)" | tee "$OUT/FAILED"; break; fi
  [[ -z "$f" || ! "$f" -nt "$OUT/.started" ]] && continue
  mt=$(stat -c %Y "$f" 2>/dev/null) || continue; age=$(( $(date +%s) - mt ))
  if [[ -f "$OUT/.last" ]] && (( age > STALL )); then
    nudges=$((nudges + 1)); vic-shot > "$OUT/stall${nudges}_shot.txt"
    if (( nudges > 8 )); then echo "GAME STALLED: no new autosave for ${STALL}s after 8 nudges (see stall*_shot.txt)" | tee "$OUT/FAILED"; break; fi
    case $(( (nudges - 1) % 4 )) in 0) keys="space" ;; 1) keys="Escape" ;; 2) keys="space" ;; *) keys="Escape space" ;; esac
    for k in $keys; do vic-key "$k" >/dev/null; sleep 1; done
    echo "$(date +%T) STALL: no new autosave for ${age}s; nudge $nudges ($keys)" | tee -a "$OUT/STALLS" >> "$OUT/progress.txt"
    continue
  fi
  nudges=0
  [[ "$f" == "$last" && ! "$f" -nt "$OUT/.last" ]] && continue
  touch "$OUT/.last"; last=$f
  d=$(head -c 4000 "$f" | grep -m1 -o 'game_date=[0-9.]*' | cut -d= -f2); [[ -z "$d" ]] && d=$(grep -m1 -o '^date=[0-9.]*' "$f" | cut -d= -f2)
  cp "$f" "$OUT/saves/$d.v3"
  cwp-save-dump "$OUT/saves/$d.v3" --out "$OUT" > /dev/null
  echo "$(date +%T) $d" >> "$OUT/progress.txt"
  (( ${d%%.*} >= END )) && break
done
vic-shot > "$OUT/final_shot.txt"
cwp-vic errors > "$OUT/errors_end.txt" 2> "$OUT/canary_end.txt"
command -v cwp-integrate >/dev/null && [[ "$WT" == *integration* ]] && cwp-integrate attribute "$OUT/errors_end.txt" > "$OUT/attribution.txt" 2>&1
kill $PERF 2>/dev/null; cp "$(ls -t ~/forge/perf/*.csv | head -1)" "$OUT/perf.csv" 2>/dev/null
# Per-area error greps (whole session), so each area thread reads only its own lines.
declare -A AREA=(
  [korea]='cwp_korea|korea|NRK|STK|divided_peninsula'
  [germany]='cwp_gq|german_question|cwp_german|DDR|occupation_zone'
  [china]='cwp_ccw|chinese_civil_war|PRC|ROC'
  [decolonization]='cwp_tide|cwp_india|cwp_indonesia|cwp_indochina|cwp_algeria|decoloni|winds_of_change|war_support_from_journal_entries|cwp_former_colony'
)
for a in "${!AREA[@]}"; do grep -E -B2 -A3 "${AREA[$a]}" "$OUT/errors_end.txt" > "$OUT/errors_$a.txt" 2>/dev/null; done
ls "$OUT"/*.md | sort > "$OUT/INDEX.txt"
echo "$OUT"
