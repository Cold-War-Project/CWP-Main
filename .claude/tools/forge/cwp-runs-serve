#!/usr/bin/env python3
"""cwp-runs-serve: drive `cwp-runs plan` unattended, so Forge never sits idle.

Runs as one long-lived job (`cwp-vic job runs-serve -- cwp-runs-serve`). Every minute it:
  1. catalogues finished steps (`cwp-runs done <outdir>`; this also keeps the build snapshot for landing),
  2. starts what the plan says should run next, by the staging thread's rules:
       - quick probes at once, moved to the front of the game queue;
       - the staging batch as soon as no batch is in flight, moved to the front (after quick probes);
       - measure arms in plan order, at most CWP_SERVE_MAX_ARMS (default 4) in flight at a time.
It never lands anything (landing needs GUI checks and judgement), never takes the game lock itself
(each step is an ordinary `cwp-vic job` that waits in the queue), never stops or kills a process, and
starts nothing when the disk is low (`cwp-runs start` refuses below 20 GB). One instance only.
"""
import datetime, fcntl, json, os, re, shlex, shutil, subprocess, sys, time
from pathlib import Path

HOME = Path.home()
RUNS = HOME / "forge" / "runs"
LOG = RUNS / "serve.log"
MAX_ARMS = int(os.environ.get("CWP_SERVE_MAX_ARMS", "4"))
TICK = int(os.environ.get("CWP_SERVE_TICK", "60"))
PRUNE_BELOW_GB = float(os.environ.get("CWP_SERVE_PRUNE_BELOW_GB", "60"))   # start freeing space well above the 20 GB floor


def log(msg):
    with open(LOG, "a") as f:
        f.write(time.strftime("%F %T ") + msg + "\n")


def sh(cmd, timeout=600, env=None, split=False):
    try:
        p = subprocess.run(["bash", "-c", cmd], capture_output=True, text=True, timeout=timeout, env=env,
                           start_new_session=True)
    except subprocess.TimeoutExpired as e:
        return 124, ("", f"timeout: {cmd[:80]}") if split else f"timeout: {cmd[:80]}"
    return p.returncode, (p.stdout, p.stderr) if split else p.stdout + p.stderr


DONE_SET = RUNS / "serve-done.txt"
DONE_FAILS = {}
FAILS = {}   # step key -> (count, last failure time); a step failing 3 times rests for 6 hours


def done_set():
    try:
        return set(DONE_SET.read_text().split())
    except OSError:
        return set()


def started_records():
    out = []
    for f in sorted((RUNS / "started").glob("*.json")):
        try:
            out.append(json.loads(f.read_text()))
        except (OSError, ValueError):
            pass
    return out


def plan():
    rc, out = sh("cwp-runs plan --json 2>/dev/null", timeout=300)
    try:
        return json.loads(out[out.index("{"):])
    except (ValueError, json.JSONDecodeError):
        log(f"plan failed rc={rc}: {out[-300:]}")
        return None


def unit_active(token):
    rc, _ = sh(f"systemctl --user is-active -q cwp-job-runs-{token}", timeout=30)
    return rc == 0


def finished(outdir):
    d = Path(outdir)
    # observer runs end with one of these; econ_bench runs write meta.json at the end of a session
    return any((d / m).exists() for m in ("errors_end.txt", "CRASH", "FAILED", "DISKFULL")) or (d / "meta.json").exists()


def catalogue():
    """`cwp-runs done` every finished step exactly once, straight from started/ (a plan may already have
    closed the record): this keeps the batch's build state for landing and writes the notify lines."""
    seen = done_set()
    for rec in started_records():
        tok, outdir = rec["token"], rec["outdir"]
        if outdir in seen or unit_active(tok):
            continue
        # finished normally, or the runner died and the plan closed the record (done indexes it as partial)
        if not (finished(outdir) or rec.get("closed")):
            continue
        rc, out = sh(f"cwp-runs done {outdir}", timeout=1800)
        notes = [l for l in out.splitlines() if l.startswith("notify")]
        log(f"done {tok} rc={rc}" + "".join("\n    " + n for n in notes))
        fails = DONE_FAILS.get(outdir, 0) + (rc != 0)
        DONE_FAILS[outdir] = fails
        if rc == 0 or fails >= 3:   # never let one broken folder block the batches for good
            if rc != 0:
                log(f"done {tok} failed 3 times; giving up on it: {out.strip()[-200:]}")
            with open(DONE_SET, "a") as f:
                f.write(outdir + "\n")


def integration_free():
    """No batch job running and every batch catalogued: only then may a new batch rebuild the tree."""
    seen = done_set()
    for rec in started_records():
        if rec["step"]["type"] != "batch" or rec["outdir"] in seen:
            continue
        if unit_active(rec["token"]) or Path(rec["outdir"]).exists():
            return False
    return True


def bump_unit(token):
    """Move this job's lock ticket to the front: the ticket is named after the pid of a process in the unit."""
    for _ in range(12):
        _, cg = sh(f"systemctl --user show -p ControlGroup --value cwp-job-runs-{token}", timeout=30)
        pids = set()
        if cg.strip():
            try:
                pids = set((Path("/sys/fs/cgroup") / cg.strip().lstrip("/") / "cgroup.procs").read_text().split())
            except OSError:
                pass
        for t in os.listdir(HOME / "forge" / ".vic3.queue") if (HOME / "forge" / ".vic3.queue").is_dir() else []:
            pid = t.rsplit("-", 1)[-1]
            if pid in pids:
                sh(f"cwp-vic bump {pid}", timeout=60)
                log(f"{token}: moved to the front of the game queue")
                return
        time.sleep(5)
    log(f"{token}: no lock ticket found to move up (it may already hold the game)")


def step_key(st):
    return (st["type"], st.get("sha"), st.get("until"), st.get("econ_only"), tuple(sorted(st.get("items") or [])))


def start(steps, want):
    """Start the plan step equal to `want`; re-plan first because step numbers shift."""
    k = step_key(want)
    c, t = FAILS.get(k, (0, 0))
    if c >= 3 and time.time() - t < 6 * 3600:
        return False
    p = plan()
    if not p:
        return False
    keys = [step_key(s) for s in p["steps"]]
    if k not in keys:
        return False
    n = keys.index(k) + 1
    rc, (out, err) = sh(f"cwp-runs start {n}", timeout=300, split=True)
    m = re.search(r"recorded as in flight: (\S+)", out)
    if rc != 0 or not m:
        log(f"start {n} refused: {(out + err).strip()[-300:]}")
        return None   # refused (disk, lock file): stop starting more this tick
    token = m.group(1)
    try:   # what was actually recorded, in case the plan shifted under us
        want = json.loads((RUNS / "started" / f"{token}.json").read_text())["step"]
    except (OSError, ValueError, KeyError):
        pass
    body = out.split("\nrun:\n", 1)[1] if "\nrun:\n" in out else ""
    cmds = [l.strip() for l in body.splitlines() if l.startswith("  ") and not l.strip().startswith("cwp-runs done")]
    env = dict(os.environ, CWP_OBSERVE_WAIT="86400")
    for c in cmds:
        c = c.split("   #", 1)[0]
        rc, o = sh(c, timeout=1800, env=env)
        if rc != 0:
            log(f"{token}: command failed rc={rc}: {c[:120]}: {o.strip()[-300:]}")
            sh(f"cwp-runs unstart {token}", timeout=120)   # nothing queued; let the next plan book it again
            FAILS[k] = (FAILS.get(k, (0, 0))[0] + 1, time.time())
            return False
    FAILS.pop(k, None)
    log(f"started {token}: {want['type']} {want.get('sha', '')[:9]} to {want.get('until')}"
        + (" [quick]" if want.get("quick") else ""))
    if want.get("quick") or want["type"] == "batch" or want.get("econ_priority"):   # econ arms: Jack's econ-first rule
        bump_unit(token)
    return token


def prune():
    """Disk relief before the 20 GB floor stops the queue: remove clean `runs-<sha9>` worktrees that no
    running job or open step uses (cwp-runs start re-creates them), then gzip finished runs' saves.
    Holds cwp-runs' own start lock throughout, so no `cwp-runs start` (by anyone) can book a tree meanwhile."""
    global LAST_COMPRESS
    with open(RUNS / ".start.lock", "w") as lf:
        fcntl.flock(lf, fcntl.LOCK_EX)
        prune_locked()
    if time.time() - LAST_COMPRESS > 3600:   # at most hourly: it can take a while
        LAST_COMPRESS = time.time()
        sh(f"CWP_COMPRESS_MIN_AGE_HOURS=2 bash {HOME}/forge/admin/compress-old-saves.sh", timeout=3600)


LAST_COMPRESS = 0


def prune_locked():
    busy = set()
    for rec in started_records():
        if not rec.get("closed") or unit_active(rec["token"]):
            sha = rec["step"].get("sha")
            if sha:
                busy.add(f"runs-{sha[:9]}")
    _, units = sh("systemctl --user list-units 'cwp-job-*' --no-legend --plain | awk '{print $1}'", timeout=60)
    for u in units.split():
        _, ex = sh(f"systemctl --user show -p ExecStart --value {u}", timeout=30)
        busy.update(re.findall(r"worktrees/(runs-[0-9a-f]{9})\b", ex))
    cwds = set()
    for d in Path("/proc").iterdir():
        try:
            cwds.add(os.readlink(d / "cwd"))
        except OSError:
            pass
    removed = []
    for w in sorted((HOME / "forge" / "worktrees").glob("runs-*")):
        if not re.fullmatch(r"runs-[0-9a-f]{9}", w.name) or w.name in busy:
            continue
        if any(c == str(w) or c.startswith(str(w) + "/") for c in cwds):
            continue
        rc, st = sh(f"git -C {w} status --porcelain", timeout=120)
        if rc != 0 or st.strip():
            continue
        rc, _ = sh(f"git -C {HOME}/forge/CWP-Main worktree remove {w}", timeout=300)   # refuses dirty trees
        if rc == 0:
            removed.append(w.name)
    if removed:
        log(f"pruned {len(removed)} idle arm worktrees: {' '.join(removed)}")


BATCH_SEEN = RUNS / "serve-batches.txt"


def batch_signature(st):
    """The batch's items at their current heads plus the requests it serves: an identical batch tests
    nothing new, so it is not run again (24 Nov: the same unlanded batch ran about 51 times)."""
    heads = []
    for b in sorted(st.get("items") or []):
        rc, h = sh(f"git -C {HOME}/forge/CWP-Main rev-parse --verify -q {shlex.quote('refs/heads/' + b)}", timeout=60)
        heads.append(f"{b}@{h.strip() if rc == 0 else '?'}")
    rc, base = sh(f"git -C {HOME}/forge/CWP-Main rev-parse --verify -q origin/CWP2", timeout=60)
    return "|".join([base.strip()] + heads + sorted(st.get("serves") or []))


def batch_seen(st):
    """True if this exact batch already ran to a clean finish (a crashed or failed run may run again)."""
    sig = batch_signature(st)
    clean = False
    try:
        for line in BATCH_SEEN.read_text().splitlines():
            parts = line.split("\t")
            if len(parts) == 3 and parts[0] == sig:
                d = Path(parts[2])
                if (d / "errors_end.txt").exists() and not any((d / m).exists() for m in ("CRASH", "FAILED", "DISKFULL")):
                    clean = True
                elif unit_active(parts[1]):
                    clean = True   # still waiting or running: don't start a second copy either
    except OSError:
        pass
    if clean:
        if time.time() - LAST_SKIP_LOG.get(sig, 0) > 3600:
            LAST_SKIP_LOG[sig] = time.time()
            log("staging batch unchanged since its last run (same CWP2, branch heads and requests): "
                "not running it again; land or dequeue what passed")
        return True
    return False


def remember_batch(sig, token):
    try:
        outdir = json.loads((RUNS / "started" / f"{token}.json").read_text())["outdir"]
    except (OSError, ValueError, KeyError):
        return
    with open(BATCH_SEEN, "a") as f:
        f.write(f"{sig}\t{token}\t{outdir}\n")


LAST_SKIP_LOG = {}


AGE_CAP_H = float(os.environ.get("CWP_SERVE_AGE_CAP_HOURS", "4"))
STARVE_H = float(os.environ.get("CWP_SERVE_STARVE_HOURS", "12"))


def age_cap():
    """A normal game-queue ticket that has waited more than AGE_CAP_H hours goes to the front (once), so
    quick probes and batches, which are always moved up, cannot starve a long run for good."""
    q = HOME / "forge" / ".vic3.queue"
    if not q.is_dir():
        return
    for t in sorted(os.listdir(q)):
        m = re.fullmatch(r"5(\d+)-(\d+)", t)
        if not m:
            continue
        waited = time.time() - int(m.group(1)) / 1e9
        if waited > AGE_CAP_H * 3600:
            # rename exactly as `cwp-vic bump` does (the waiter finds its ticket by the pid suffix); by name,
            # not through bump's pid-or-note-text match, which could pick another ticket
            try:
                # keep its original timestamp under the bumped prefix: it then sorts ahead of every ticket
                # bumped later (quick probes, batches), instead of queueing behind them again
                os.rename(q / t, q / f"0{m.group(1)}-{m.group(2)}")
                log(f"ticket {t} waited {waited / 3600:.1f} h: moved to the front")
            except OSError as e:
                log(f"ticket {t}: could not move it up: {e}")


def starved(st):
    """An arm whose request is older than STARVE_H hours and has nothing in flight may start past the cap."""
    for rid, _side in st.get("serves") or []:
        try:
            created = json.loads((RUNS / "requests" / f"{rid}.json").read_text())["created"]
            t = datetime.datetime.fromisoformat(created).timestamp()
        except (OSError, ValueError, KeyError):
            continue
        if time.time() - t > STARVE_H * 3600:
            return rid
    return None


def tick():
    catalogue()
    age_cap()
    if shutil.disk_usage(HOME / "forge").free / 1e9 < PRUNE_BELOW_GB:
        prune()
    free = shutil.disk_usage(HOME / "forge").free / 1e9
    if free < 20:
        log(f"only {free:.0f} GB free: starting nothing")
        return
    p = plan()
    if not p:
        return
    flying = p["in_flight"]
    arms_flying = sum(1 for r in flying if r["step"]["type"] in ("arm", "solo") and not r["step"].get("quick"))
    for st in [s for s in p["steps"] if s.get("quick") and s["type"] != "batch"]:
        if start(p["steps"], st) is None:
            return
    if integration_free():
        b = next((s for s in p["steps"] if s["type"] == "batch"), None)
        if b and batch_seen(b):
            b = None
        if b:
            sig = batch_signature(b)
            r = start(p["steps"], b)
            if r is None:
                return
            if r:
                remember_batch(sig, r)
    flying_reqs = {sv[0] for r in flying if r["step"]["type"] in ("arm", "solo")
                   for sv in (r["step"].get("serves") or []) if isinstance(sv, list)}
    for st in [s for s in p["steps"] if s["type"] in ("arm", "solo") and not s.get("quick")]:
        if arms_flying >= MAX_ARMS:
            rid = starved(st)
            if not rid or rid in flying_reqs:
                continue
            log(f"request {rid} waited over {STARVE_H:g} h with nothing running: one arm starts past the cap")
            flying_reqs.add(rid)
        r = start(p["steps"], st)
        if r is None:
            return
        if r:
            arms_flying += 1


def main():
    RUNS.mkdir(parents=True, exist_ok=True)
    lock = open(RUNS / ".serve.lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        print("cwp-runs-serve is already running", file=sys.stderr)
        return 1
    if not DONE_SET.exists():   # first start: everything already finished was catalogued by hand
        old = time.time() - 3600   # closed more than an hour ago: catalogued by hand before the serve existed
        DONE_SET.write_text("".join(r["outdir"] + "\n" for r in started_records()
                                    if r.get("closed") and Path(RUNS / "started" / f"{r['token']}.json").stat().st_mtime < old))
    log(f"serve started (max {MAX_ARMS} arms, tick {TICK}s)")
    once = "--once" in sys.argv
    while True:
        try:
            tick()
        except Exception as e:   # keep serving; one bad tick must not stop the queue
            log(f"tick error: {e!r}")
        if once:
            return 0
        time.sleep(TICK)


if __name__ == "__main__":
    sys.exit(main())
