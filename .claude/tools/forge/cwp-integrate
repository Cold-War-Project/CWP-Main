#!/usr/bin/env bash
# cwp-integrate: build one combined test mod from several open PRs, so they can be tested together.
#
#   cwp-integrate build [PR# ...]     fresh ~/forge/worktrees/integration off origin/CWP2 (CWP_BASE=<branch> to change), then merge
#                                     each PR's branch in order (default: every open PR into that base).
#                                     A PR that conflicts is skipped (merge aborted) and reported.
#   cwp-integrate attribute [LOGFILE]  group error lines by the merged PR that touched the file they name
#                                     (default: the current session via `cwp-vic errors`)
#   cwp-integrate report               print the last build's per-PR table
#   cwp-integrate publish              push the last build to origin/CWP2-staging (replaced on every publish)
#                                     so the merged state can be shared and tested by anyone
#
# Then test it like any worktree:  cwp-vic lock "..." && cwp-vic link ~/forge/worktrees/integration && cwp-vic launch
# The local branch is integration/local; `publish` copies it to CWP2-staging. Never open a PR from either.
set -uo pipefail
REPO="${CWP_REPO:-$HOME/forge/CWP-Main}"
WT="${CWP_INTEGRATION:-$HOME/forge/worktrees/integration}"
BRANCH="integration/local"
BASE="${CWP_BASE:-CWP2}"         # the working branch the PRs target
STATE="$WT/.integration"            # per-build state (untracked)
die() { echo "cwp-integrate: $*" >&2; exit 1; }

cmd_build() {
  git -C "$REPO" fetch -q origin || die "fetch failed"
  local prs=("$@")
  if (( ${#prs[@]} == 0 )); then
    mapfile -t prs < <(gh -R Cold-War-Project/CWP-Main pr list --base "$BASE" --state open --limit 100 \
      --json number -q '.[].number' | sort -n)
  fi
  (( ${#prs[@]} )) || die "no PRs to merge"
  if [[ -d "$WT" ]]; then
    [[ -n "$(pgrep -f '\./victoria3' 2>/dev/null)" ]] && grep -q "$WT" "$HOME/.local/share/Paradox Interactive/Victoria 3/content_load.json" 2>/dev/null \
      && die "the game is running on the integration worktree; stop it first"
    git -C "$WT" merge --abort 2>/dev/null
    git -C "$WT" checkout -q -B "$BRANCH" origin/$BASE || die "reset failed"
    git -C "$WT" clean -qfdx
  else
    git -C "$REPO" worktree add -q -B "$BRANCH" "$WT" origin/$BASE || die "worktree add failed"
  fi
  mkdir -p "$STATE"; : > "$STATE/prs.tsv"
  local base; base=$(git -C "$WT" rev-parse --short HEAD)
  echo "integration build on $BASE @ $base"
  for n in "${prs[@]}"; do
    local head title
    read -r head title < <(gh -R Cold-War-Project/CWP-Main pr view "$n" --json headRefName,title -q '"\(.headRefName) \(.title)"')
    [[ -z "$head" ]] && { printf '%s\t-\tmissing\t\t\n' "$n" >> "$STATE/prs.tsv"; continue; }
    git -C "$REPO" fetch -q origin "+refs/heads/$head:refs/remotes/origin/$head" 2>/dev/null
    local sha; sha=$(git -C "$REPO" rev-parse --short "origin/$head")
    local files; files=$(git -C "$WT" diff --name-only "origin/$BASE...origin/$head" | tr '\n' ' ')
    if git -C "$WT" merge -q --no-ff --no-edit -m "integration: #$n $head" "origin/$head" >/dev/null 2>&1; then
      printf '%s\t%s\tmerged @ %s\t%s\t%s\n' "$n" "$head" "$sha" "$title" "$files" >> "$STATE/prs.tsv"
      echo "  #$n $head @ $sha: merged"
    else
      local conflicts; conflicts=$(git -C "$WT" diff --name-only --diff-filter=U | tr '\n' ' ')
      git -C "$WT" merge --abort
      printf '%s\t%s\tCONFLICT: %s\t%s\t%s\n' "$n" "$head" "$conflicts" "$title" "$files" >> "$STATE/prs.tsv"
      echo "  #$n $head: CONFLICT in $conflicts(skipped)"
    fi
  done
  git -C "$WT" rev-parse --short HEAD > "$STATE/head"
  echo "built $WT @ $(cat "$STATE/head"). Next: cwp-vic lock/link $WT/launch, then cwp-integrate attribute."
}

cmd_report() {
  [[ -f "$STATE/prs.tsv" ]] || die "no build yet"
  echo "| PR | branch | merge |"; echo "|---|---|---|"
  awk -F'\t' '{printf "| #%s | `%s` | %s |\n", $1, $2, $3}' "$STATE/prs.tsv"
}

cmd_attribute() {
  [[ -f "$STATE/prs.tsv" ]] || die "no build yet"
  local log="${1:-}"
  if [[ -z "$log" ]]; then log=$(mktemp); cwp-vic errors > "$log" 2>/dev/null; fi
  python3 - "$STATE/prs.tsv" "$log" <<'PY'
import re, sys, collections
import subprocess, os
prs = [l.rstrip("\n").split("\t") for l in open(sys.argv[1]) if l.strip()]
repo = os.environ.get("CWP_REPO", os.path.expanduser("~/forge/CWP-Main"))
owner = collections.defaultdict(list)
for n, head, status, *_ in prs:
    if status.startswith("merged"):
        out = subprocess.run(["git", "-C", repo, "diff", "-z", "--name-only", f"origin/{os.environ.get('CWP_BASE', 'CWP2')}...origin/{head}"],
                             capture_output=True, text=True).stdout
        for f in filter(None, out.split("\0")):   # -z: file names may contain spaces
            owner[f].append("#" + n)
pat = re.compile(r"((?:common|events|gfx|gui|localization|map_data|tools)/[\w ./\-']+?\.(?:txt|gui|yml|csv|asset))")
by = collections.defaultdict(list)
for line in open(sys.argv[2], errors="replace"):
    line = line.rstrip()
    if not line.strip():
        continue
    paths = pat.findall(line)
    who = sorted({o for p in paths for o in owner.get(p, [])})
    key = ", ".join(who) if who else ("base branch or vanilla (file not touched by a merged PR)" if paths else "no file named")
    by[key].append(line)
for key in sorted(by, key=lambda k: -len(by[k])):
    lines = by[key]
    print(f"== {key}: {len(lines)} lines")
    for msg, c in collections.Counter(re.sub(r"^\[[0-9:]+\]", "", l)[:180] for l in lines).most_common(5):
        print(f"   {c:5d}  {msg}")
PY
}

cmd_publish() {
  [[ -f "$STATE/head" ]] || die "no build yet"
  local staging="${CWP_STAGING:-CWP2-staging}"
  git -C "$WT" push -q --force origin "HEAD:refs/heads/$staging" || die "push failed"
  echo "published $(cat "$STATE/head") to origin/$staging"
  { echo "CWP2-staging = $BASE @ $(git -C "$WT" rev-parse --short "origin/$BASE") + these PRs ($(date '+%F %T %Z')):"; cmd_report; } \
    > "$STATE/published.md"
}

case "${1:-}" in
  build)     shift; cmd_build "$@" ;;
  report)    cmd_report ;;
  attribute) shift; cmd_attribute "$@" ;;
  publish)   cmd_publish ;;
  *)         sed -n '2,16p' "$0" ;;
esac
