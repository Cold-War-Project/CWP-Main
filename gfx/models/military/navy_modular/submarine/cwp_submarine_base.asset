# Cold War Project: copy of vanilla submarine_base_entity (submarine_base.asset) with a hidden loc_figurehead locator.
# Reuses vanilla's submarine_base_mesh. Used by gfx/map/fleet_entities/cwp_submarines_entities.txt.

entity = {
	name = "cwp_submarine_base_entity"
	pdxmesh = "submarine_base_mesh"

	# The submarine mesh has no loc_figurehead, so a submarine flagship logged
	# "has no attach point named loc_figurehead" every time it rendered. Submarines carry no
	# figurehead: the locator sits inside the hull so the ornament stays hidden.
	locator = { name = "loc_figurehead" position = { 0.0 -0.5 0.0 } scale = 0.01 }

	default_state = "move"

	state = { name = "idle" 
		event = { time = 0 keep_sound = yes sound  = { soundeffect = "event:/SFX/Animation/vehicles/naval/fleet/torpedo_craft/submarine/anm_ship_submarine_idle" } }
	}

	state = { name = "move" 
		event = { time = 0 keep_sound = yes sound  = { soundeffect = "event:/SFX/Animation/vehicles/naval/fleet/torpedo_craft/submarine/anm_ship_submarine_moving" } }
		event = { time = 0 trigger_once = yes keep_sound = no sound = { soundeffect = "event:/SFX/Animation/vehicles/naval/fleet/torpedo_craft/submarine/anm_ship_submarine_moving_start" } }
	}

	state = { name = "move_local"
		event = { time = 0 keep_sound = yes sound = { soundeffect = "event:/SFX/Animation/vehicles/naval/fleet/torpedo_craft/submarine/anm_ship_submarine_moving_local" } }
		event = { time = 0 trigger_once = yes keep_sound = no sound  = { soundeffect = "event:/SFX/Animation/vehicles/naval/fleet/torpedo_craft/submarine/anm_ship_submarine_moving_start" } }
	}

	state = { name = "move_ship_viewer"
		event = { time = 0 keep_sound = yes sound = { soundeffect = "event:/SFX/Animation/vehicles/naval/fleet/torpedo_craft/submarine/anm_ship_submarine_moving_ship_viewer" } }
	}

	state = { name = "combat" 
		event = { time = 0 keep_sound = yes sound  = { soundeffect = "event:/SFX/Animation/vehicles/naval/fleet/torpedo_craft/submarine/anm_ship_submarine_combat" } }
	}
	
	state = { name = "destroyed" 
		event = { time = 0 keep_sound = yes sound  = { soundeffect = "event:/SFX/Animation/vehicles/naval/fleet/torpedo_craft/submarine/anm_ship_submarine_destroyed" } }
	}	
}
