	##### Organisation 1

	### A member in the roll call: who, how it votes, a veto mark, its lean, and the lobbying buttons.
	### The filter buttons above the list decide which rows are visible.
	type cwp_iot_roll_row_1 = widget {
		visible = "[Or(Or(Or(Or(Or(Not(GetVariableSystem.Exists('cwp_iot_show')), GetVariableSystem.HasValue('cwp_iot_show', 'all')), And(And(GetVariableSystem.HasValue('cwp_iot_show', 'for'), Not(EqualTo_CFixedPoint(Scope.Var('cwp_iot_1_status').GetValue, '(CFixedPoint)3'))), EqualTo_CFixedPoint(Scope.Var('cwp_iot_1_vote').GetValue, '(CFixedPoint)1'))), And(And(GetVariableSystem.HasValue('cwp_iot_show', 'against'), Not(EqualTo_CFixedPoint(Scope.Var('cwp_iot_1_status').GetValue, '(CFixedPoint)3'))), EqualTo_CFixedPoint(Scope.Var('cwp_iot_1_vote').GetValue, '(CFixedPoint)2'))), And(And(GetVariableSystem.HasValue('cwp_iot_show', 'abstain'), Not(EqualTo_CFixedPoint(Scope.Var('cwp_iot_1_status').GetValue, '(CFixedPoint)3'))), EqualTo_CFixedPoint(Scope.Var('cwp_iot_1_vote').GetValue, '(CFixedPoint)3'))), And(And(GetVariableSystem.HasValue('cwp_iot_show', 'moved'), GreaterThanOrEqualTo_CFixedPoint(Scope.Var('cwp_iot_1_leanw').GetValue, '(CFixedPoint)2')), Not(GreaterThanOrEqualTo_CFixedPoint(Scope.Var('cwp_iot_1_leanw').GetValue, '(CFixedPoint)5'))))]"
		size = { 600 38 }
		datacontext = "[Scope.GetCountry]"
		tooltip = "[GetScriptedGui('cwp_iot_row_tt_1_sgui').ExecuteTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('member', Scope.GetCountry.MakeScope).End)]"

		background = {
			using = entry_bg_simple
		}

		flowcontainer = {
			parentanchor = left|vcenter
			position = { 8 0 }
			spacing = 6

			tiny_flag = {
				parentanchor = vcenter
			}

			textbox = {
				size = { 132 22 }
				parentanchor = vcenter
				align = left|nobaseline
				elide = right
				raw_text = "#b [Country.GetNameNoFormatting]#!"
			}

			# the vote: an icon and a word, or "Suspended"
			widget = {
				size = { 96 22 }
				parentanchor = vcenter

				flowcontainer = {
					visible = "[And(Not(EqualTo_CFixedPoint(Scope.Var('cwp_iot_1_status').GetValue, '(CFixedPoint)3')), EqualTo_CFixedPoint(Scope.Var('cwp_iot_1_vote').GetValue, '(CFixedPoint)1'))]"
					parentanchor = left|vcenter
					spacing = 4

					icon = {
						size = { 20 20 }
						parentanchor = vcenter
						texture = "gfx/interface/icons/generic_icons/approval_icon.dds"
					}

					textbox = {
						autoresize = yes
						parentanchor = vcenter
						align = nobaseline
						text = "cwp_iot_votew_1"
					}
				}

				flowcontainer = {
					visible = "[And(Not(EqualTo_CFixedPoint(Scope.Var('cwp_iot_1_status').GetValue, '(CFixedPoint)3')), EqualTo_CFixedPoint(Scope.Var('cwp_iot_1_vote').GetValue, '(CFixedPoint)2'))]"
					parentanchor = left|vcenter
					spacing = 4

					icon = {
						size = { 20 20 }
						parentanchor = vcenter
						texture = "gfx/interface/icons/generic_icons/disapproval_icon.dds"
					}

					textbox = {
						autoresize = yes
						parentanchor = vcenter
						align = nobaseline
						text = "cwp_iot_votew_2"
					}
				}

				flowcontainer = {
					visible = "[And(Not(EqualTo_CFixedPoint(Scope.Var('cwp_iot_1_status').GetValue, '(CFixedPoint)3')), EqualTo_CFixedPoint(Scope.Var('cwp_iot_1_vote').GetValue, '(CFixedPoint)3'))]"
					parentanchor = left|vcenter
					spacing = 4

					icon = {
						size = { 20 20 }
						parentanchor = vcenter
						texture = "gfx/interface/icons/generic_icons/maybe_icon.dds"
					}

					textbox = {
						autoresize = yes
						parentanchor = vcenter
						align = nobaseline
						text = "cwp_iot_votew_3"
					}
				}

				textbox = {
					visible = "[EqualTo_CFixedPoint(Scope.Var('cwp_iot_1_status').GetValue, '(CFixedPoint)3')]"
					size = { 100% 100% }
					align = left|nobaseline
					text = "cwp_iot_status_3"
				}
			}

			# a council power voting Against, unless it has walked out
			widget = {
				size = { 18 18 }
				parentanchor = vcenter

				icon = {
					visible = "[And(And(EqualTo_CFixedPoint(Scope.Var('cwp_iot_1_status').GetValue, '(CFixedPoint)2'), EqualTo_CFixedPoint(Scope.Var('cwp_iot_1_vote').GetValue, '(CFixedPoint)2')), Not(Scope.Var('cwp_iot_absent').IsSet))]"
					size = { 100% 100% }
					texture = "gfx/interface/icons/generic_icons/warning.dds"
					tooltip = "cwp_iot_veto_tt"
				}
			}

			# the lean as a number: green from 15 up, red from -15 down
			widget = {
				size = { 44 22 }
				parentanchor = vcenter

				textbox = {
					visible = "[Not(GreaterThanOrEqualTo_CFixedPoint(Scope.Var('cwp_iot_1_leanw').GetValue, '(CFixedPoint)3'))]"
					size = { 100% 100% }
					align = left|nobaseline
					raw_text = "#P [Scope.Var('cwp_iot_1_lean').GetValue|0]#!"
				}

				textbox = {
					visible = "[EqualTo_CFixedPoint(Scope.Var('cwp_iot_1_leanw').GetValue, '(CFixedPoint)3')]"
					size = { 100% 100% }
					align = left|nobaseline
					raw_text = "#gold [Scope.Var('cwp_iot_1_lean').GetValue|0]#!"
				}

				textbox = {
					visible = "[GreaterThanOrEqualTo_CFixedPoint(Scope.Var('cwp_iot_1_leanw').GetValue, '(CFixedPoint)4')]"
					size = { 100% 100% }
					align = left|nobaseline
					raw_text = "#N [Scope.Var('cwp_iot_1_lean').GetValue|0]#!"
				}
			}
		}

		# Fixed slots: the clock, then Persuade, Aid, Favour (only while a favour is owed), Press.
		# Not on our own row. No scripted GUI is asked anything until a button is pressed.
		flowcontainer = {
			visible = "[Not(Country.IsLocalPlayer)]"
			parentanchor = right|vcenter
			position = { -8 0 }
			spacing = 4

			widget = {
				size = { 20 20 }
				parentanchor = vcenter

				icon = {
					visible = "[Scope.Var('cwp_iot_lobby_cd').IsSet]"
					size = { 100% 100% }
					texture = "gfx/interface/icons/generic_icons/clock.dds"
					tooltip = "cwp_iot_lobby_cd_tt"
				}
			}

			widget = {
				size = { 60 26 }
				parentanchor = vcenter

				cwp_iot_button = {
					size = { 100% 100% }
					visible = "[EqualTo_CFixedPoint(GetGlobalVariable('cwp_iot_1_phase').GetValue, '(CFixedPoint)1')]"
					enabled = "[And(And(And(Not(Scope.Var('cwp_iot_lobby_cd').IsSet), GreaterThanOrEqualTo_CFixedPoint(GetPlayer.MakeScope.Var('cwp_iot_1_vote').GetValue, '(CFixedPoint)1')), Not(GreaterThanOrEqualTo_CFixedPoint(GetPlayer.MakeScope.Var('cwp_iot_1_vote').GetValue, '(CFixedPoint)3'))), GreaterThanOrEqualTo_CFixedPoint(GetPlayer.MakeScope.Var('cwp_iot_1_standing').GetValue, '(CFixedPoint)5'))]"
					onclick = "[GetScriptedGui('cwp_iot_lobby_1_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('member', Scope.GetCountry.MakeScope).AddScope('action', MakeScopeValue('(CFixedPoint)1')).End)]"
					tooltip = "cwp_iot_lobby_1_tt"

					blockoverride "cwp_iot_button_text" {
						text = "cwp_iot_lobby_1"
					}
				}
			}

			widget = {
				size = { 40 26 }
				parentanchor = vcenter

				cwp_iot_button = {
					size = { 100% 100% }
					visible = "[EqualTo_CFixedPoint(GetGlobalVariable('cwp_iot_1_phase').GetValue, '(CFixedPoint)1')]"
					enabled = "[And(And(Not(Scope.Var('cwp_iot_lobby_cd').IsSet), GreaterThanOrEqualTo_CFixedPoint(GetPlayer.MakeScope.Var('cwp_iot_1_vote').GetValue, '(CFixedPoint)1')), Not(GreaterThanOrEqualTo_CFixedPoint(GetPlayer.MakeScope.Var('cwp_iot_1_vote').GetValue, '(CFixedPoint)3')))]"
					onclick = "[GetScriptedGui('cwp_iot_lobby_1_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('member', Scope.GetCountry.MakeScope).AddScope('action', MakeScopeValue('(CFixedPoint)2')).End)]"
					tooltip = "cwp_iot_lobby_2_tt"

					blockoverride "cwp_iot_button_text" {
						text = "cwp_iot_lobby_2"
					}
				}
			}

			widget = {
				size = { 52 26 }
				parentanchor = vcenter

				cwp_iot_button = {
					size = { 100% 100% }
					visible = "[And(EqualTo_CFixedPoint(GetGlobalVariable('cwp_iot_1_phase').GetValue, '(CFixedPoint)1'), Scope.Var('cwp_iot_owes').IsSet)]"
					enabled = "[And(And(Not(Scope.Var('cwp_iot_lobby_cd').IsSet), GreaterThanOrEqualTo_CFixedPoint(GetPlayer.MakeScope.Var('cwp_iot_1_vote').GetValue, '(CFixedPoint)1')), Not(GreaterThanOrEqualTo_CFixedPoint(GetPlayer.MakeScope.Var('cwp_iot_1_vote').GetValue, '(CFixedPoint)3')))]"
					onclick = "[GetScriptedGui('cwp_iot_lobby_1_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('member', Scope.GetCountry.MakeScope).AddScope('action', MakeScopeValue('(CFixedPoint)3')).End)]"
					tooltip = "cwp_iot_lobby_3_tt"

					blockoverride "cwp_iot_button_text" {
						text = "cwp_iot_lobby_3"
					}
				}
			}

			widget = {
				size = { 48 26 }
				parentanchor = vcenter

				cwp_iot_button = {
					size = { 100% 100% }
					visible = "[EqualTo_CFixedPoint(GetGlobalVariable('cwp_iot_1_phase').GetValue, '(CFixedPoint)1')]"
					enabled = "[And(And(Not(Scope.Var('cwp_iot_lobby_cd').IsSet), GreaterThanOrEqualTo_CFixedPoint(GetPlayer.MakeScope.Var('cwp_iot_1_vote').GetValue, '(CFixedPoint)1')), Not(GreaterThanOrEqualTo_CFixedPoint(GetPlayer.MakeScope.Var('cwp_iot_1_vote').GetValue, '(CFixedPoint)3')))]"
					onclick = "[GetScriptedGui('cwp_iot_lobby_1_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('member', Scope.GetCountry.MakeScope).AddScope('action', MakeScopeValue('(CFixedPoint)4')).End)]"
					tooltip = "cwp_iot_lobby_4_tt"

					blockoverride "cwp_iot_button_text" {
						text = "cwp_iot_lobby_4"
					}
				}
			}
		}
	}

	### A council power in the box that explains the veto.
	type cwp_iot_council_row_1 = widget {
		size = { 336 30 }
		datacontext = "[Scope.GetCountry]"
		tooltip = "[GetScriptedGui('cwp_iot_row_tt_1_sgui').ExecuteTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('member', Scope.GetCountry.MakeScope).End)]"

		background = {
			using = entry_bg_simple
		}

		flowcontainer = {
			parentanchor = left|vcenter
			position = { 8 0 }
			spacing = 6

			tiny_flag = {
				parentanchor = vcenter
			}

			textbox = {
				size = { 128 22 }
				parentanchor = vcenter
				align = left|nobaseline
				elide = right
				raw_text = "#b [Country.GetNameNoFormatting]#!"
			}

			widget = {
				size = { 76 22 }
				parentanchor = vcenter

				textbox = {
					visible = "[EqualTo_CFixedPoint(Scope.Var('cwp_iot_1_vote').GetValue, '(CFixedPoint)1')]"
					size = { 100% 100% }
					align = left|nobaseline
					text = "cwp_iot_votew_1"
				}

				textbox = {
					visible = "[EqualTo_CFixedPoint(Scope.Var('cwp_iot_1_vote').GetValue, '(CFixedPoint)2')]"
					size = { 100% 100% }
					align = left|nobaseline
					text = "cwp_iot_votew_2"
				}

				textbox = {
					visible = "[EqualTo_CFixedPoint(Scope.Var('cwp_iot_1_vote').GetValue, '(CFixedPoint)3')]"
					size = { 100% 100% }
					align = left|nobaseline
					text = "cwp_iot_votew_3"
				}
			}
		}

		flowcontainer = {
			parentanchor = right|vcenter
			position = { -8 0 }
			spacing = 6
			ignoreinvisible = yes

			textbox = {
				visible = "[And(And(EqualTo_CFixedPoint(Scope.Var('cwp_iot_1_status').GetValue, '(CFixedPoint)2'), EqualTo_CFixedPoint(Scope.Var('cwp_iot_1_vote').GetValue, '(CFixedPoint)2')), Not(Scope.Var('cwp_iot_absent').IsSet))]"
				autoresize = yes
				parentanchor = vcenter
				align = nobaseline
				text = "cwp_iot_veto"
				tooltip = "cwp_iot_veto_tt"
			}

			textbox = {
				visible = "[Scope.Var('cwp_iot_absent').IsSet]"
				autoresize = yes
				parentanchor = vcenter
				align = nobaseline
				default_format = "#title"
				text = "cwp_iot_absent"
				tooltip = "cwp_iot_absent_tt"
			}
		}
	}

	### A seat in the full ledger: who, what kind of seat, standing, dues, and the motions that can be sponsored.
	type cwp_iot_member_row_1 = widget {
		size = { 680 34 }
		datacontext = "[Scope.GetCountry]"
		tooltip = "[GetScriptedGui('cwp_iot_row_tt_1_sgui').ExecuteTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('member', Scope.GetCountry.MakeScope).End)]"

		background = {
			using = entry_bg_simple
		}

		flowcontainer = {
			parentanchor = left|vcenter
			position = { 8 0 }
			spacing = 6

			tiny_flag = {
				parentanchor = vcenter
			}

			textbox = {
				size = { 190 22 }
				parentanchor = vcenter
				align = left|nobaseline
				elide = right
				raw_text = "#b [Country.GetNameNoFormatting]#!"
			}

			widget = {
				size = { 90 22 }
				parentanchor = vcenter

				textbox = {
					visible = "[EqualTo_CFixedPoint(Scope.Var('cwp_iot_1_status').GetValue, '(CFixedPoint)1')]"
					size = { 100% 100% }
					align = left|nobaseline
					text = "cwp_iot_status_1"
				}

				textbox = {
					visible = "[EqualTo_CFixedPoint(Scope.Var('cwp_iot_1_status').GetValue, '(CFixedPoint)2')]"
					size = { 100% 100% }
					align = left|nobaseline
					text = "cwp_iot_status_2"
				}

				textbox = {
					visible = "[EqualTo_CFixedPoint(Scope.Var('cwp_iot_1_status').GetValue, '(CFixedPoint)3')]"
					size = { 100% 100% }
					align = left|nobaseline
					text = "cwp_iot_status_3"
				}
			}

			textbox = {
				size = { 70 22 }
				parentanchor = vcenter
				align = left|nobaseline
				raw_text = "[Scope.Var('cwp_iot_1_standing').GetValue|0]"
			}
		}

		# Fixed slots: Censure, then Sanction or Lift (never both), then Suspend. None on our own row.
		flowcontainer = {
			visible = "[Not(Country.IsLocalPlayer)]"
			parentanchor = right|vcenter
			position = { -8 0 }
			spacing = 4

			widget = {
				size = { 70 24 }
				parentanchor = vcenter

				cwp_iot_button = {
					size = { 100% 100% }
					enabled = "[And(GreaterThanOrEqualTo_CFixedPoint(GetPlayer.MakeScope.Var('cwp_iot_1_standing').GetValue, '(CFixedPoint)10'), GreaterThanOrEqualTo_CFixedPoint(GetGlobalVariable('cwp_iot_1_afree').GetValue, '(CFixedPoint)1'))]"
					onclick = "[GetScriptedGui('cwp_iot_propose_1_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('member', Scope.GetCountry.MakeScope).AddScope('mtype', MakeScopeValue('(CFixedPoint)1')).End)]"
					tooltip = "cwp_iot_propose_1_tt"

					blockoverride "cwp_iot_button_text" {
						text = "cwp_iot_propose_1"
					}
				}
			}

			widget = {
				size = { 72 24 }
				parentanchor = vcenter

				cwp_iot_button = {
					size = { 100% 100% }
					visible = "[Not(Scope.Var('cwp_iot_1_sanc').IsSet)]"
					enabled = "[And(GreaterThanOrEqualTo_CFixedPoint(GetPlayer.MakeScope.Var('cwp_iot_1_standing').GetValue, '(CFixedPoint)10'), GreaterThanOrEqualTo_CFixedPoint(GetGlobalVariable('cwp_iot_1_afree').GetValue, '(CFixedPoint)1'))]"
