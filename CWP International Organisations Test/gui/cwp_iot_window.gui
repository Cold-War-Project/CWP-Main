		maximumsize = { 644 -1 }
		align = left|nobaseline
		default_format = "#title"
		using = fontsize_small
	}

	type cwp_iot_line_668 = textbox {
		autoresize = yes
		multiline = yes
		maximumsize = { 668 -1 }
		align = left|nobaseline
	}

	type cwp_iot_note_668 = textbox {
		autoresize = yes
		multiline = yes
		maximumsize = { 668 -1 }
		align = left|nobaseline
		default_format = "#title"
		using = fontsize_small
	}

	type cwp_iot_line_700 = textbox {
		autoresize = yes
		multiline = yes
		maximumsize = { 700 -1 }
		align = left|nobaseline
	}

	type cwp_iot_note_700 = textbox {
		autoresize = yes
