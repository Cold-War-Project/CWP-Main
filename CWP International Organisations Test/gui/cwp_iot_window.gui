	##### Organisation 2

	### A member in the roll call: who, how it votes, a veto mark, its lean, and the lobbying buttons.
	### The filter buttons above the list decide which rows are visible.
	type cwp_iot_roll_row_2 = widget {
		visible = "[Or(Or(Or(Or(Or(Not(GetVariableSystem.Exists('cwp_iot_show')), GetVariableSystem.HasValue('cwp_iot_show', 'all')), And(And(GetVariableSystem.HasValue('cwp_iot_show', 'for'), Not(EqualTo_CFixedPoint(Scope.Var('cwp_iot_2_status').GetValue, '(CFixedPoint)3'))), EqualTo_CFixedPoint(Scope.Var('cwp_iot_2_vote').GetValue, '(CFixedPoint)1'))), And(And(GetVariableSystem.HasValue('cwp_iot_show', 'against'), Not(EqualTo_CFixedPoint(Scope.Var('cwp_iot_2_status').GetValue, '(CFixedPoint)3'))), EqualTo_CFixedPoint(Scope.Var('cwp_iot_2_vote').GetValue, '(CFixedPoint)2'))), And(And(GetVariableSystem.HasValue('cwp_iot_show', 'abstain'), Not(EqualTo_CFixedPoint(Scope.Var('cwp_iot_2_status').GetValue, '(CFixedPoint)3'))), EqualTo_CFixedPoint(Scope.Var('cwp_iot_2_vote').GetValue, '(CFixedPoint)3'))), And(And(GetVariableSystem.HasValue('cwp_iot_show', 'moved'), GreaterThanOrEqualTo_CFixedPoint(Scope.Var('cwp_iot_2_leanw').GetValue, '(CFixedPoint)2')), Not(GreaterThanOrEqualTo_CFixedPoint(Scope.Var('cwp_iot_2_leanw').GetValue, '(CFixedPoint)5'))))]"
		size = { 600 38 }
		datacontext = "[Scope.GetCountry]"
		tooltip = "[GetScriptedGui('cwp_iot_row_tt_2_sgui').ExecuteTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('member', Scope.GetCountry.MakeScope).End)]"

		background = {
			using = entry_bg_simple
		}

		flowcontainer = {
			parentanchor = left|vcenter
			position = { 8 0 }
			spacing = 6

			tiny_flag = {
				parentanchor = vcenter
			}

			textbox = {
				size = { 132 22 }
				parentanchor = vcenter
				align = left|nobaseline
				elide = right
				raw_text = "#b [Country.GetNameNoFormatting]#!"
			}

			# the vote: an icon and a word, or "Suspended"
			widget = {
				size = { 96 22 }
				parentanchor = vcenter

				flowcontainer = {
					visible = "[And(Not(EqualTo_CFixedPoint(Scope.Var('cwp_iot_2_status').GetValue, '(CFixedPoint)3')), EqualTo_CFixedPoint(Scope.Var('cwp_iot_2_vote').GetValue, '(CFixedPoint)1'))]"
					parentanchor = left|vcenter
					spacing = 4

					icon = {
						size = { 20 20 }
						parentanchor = vcenter
						texture = "gfx/interface/icons/generic_icons/approval_icon.dds"
					}

					textbox = {
						autoresize = yes
						parentanchor = vcenter
						align = nobaseline
						text = "cwp_iot_votew_1"
					}
				}

				flowcontainer = {
					visible = "[And(Not(EqualTo_CFixedPoint(Scope.Var('cwp_iot_2_status').GetValue, '(CFixedPoint)3')), EqualTo_CFixedPoint(Scope.Var('cwp_iot_2_vote').GetValue, '(CFixedPoint)2'))]"
					parentanchor = left|vcenter
					spacing = 4

					icon = {
						size = { 20 20 }
						parentanchor = vcenter
						texture = "gfx/interface/icons/generic_icons/disapproval_icon.dds"
					}

					textbox = {
						autoresize = yes
						parentanchor = vcenter
						align = nobaseline
						text = "cwp_iot_votew_2"
					}
				}

				flowcontainer = {
					visible = "[And(Not(EqualTo_CFixedPoint(Scope.Var('cwp_iot_2_status').GetValue, '(CFixedPoint)3')), EqualTo_CFixedPoint(Scope.Var('cwp_iot_2_vote').GetValue, '(CFixedPoint)3'))]"
					parentanchor = left|vcenter
					spacing = 4

					icon = {
						size = { 20 20 }
						parentanchor = vcenter
						texture = "gfx/interface/icons/generic_icons/maybe_icon.dds"
					}

					textbox = {
						autoresize = yes
						parentanchor = vcenter
						align = nobaseline
						text = "cwp_iot_votew_3"
					}
				}

				textbox = {
					visible = "[EqualTo_CFixedPoint(Scope.Var('cwp_iot_2_status').GetValue, '(CFixedPoint)3')]"
					size = { 100% 100% }
					align = left|nobaseline
					text = "cwp_iot_status_3"
				}
			}

			# a council power voting Against, unless it has walked out
			widget = {
				size = { 18 18 }
				parentanchor = vcenter

				icon = {
					visible = "[And(And(EqualTo_CFixedPoint(Scope.Var('cwp_iot_2_status').GetValue, '(CFixedPoint)2'), EqualTo_CFixedPoint(Scope.Var('cwp_iot_2_vote').GetValue, '(CFixedPoint)2')), Not(Scope.Var('cwp_iot_absent').IsSet))]"
					size = { 100% 100% }
					texture = "gfx/interface/icons/generic_icons/warning.dds"
					tooltip = "cwp_iot_veto_tt"
				}
			}

			# the lean as a number: green from 15 up, red from -15 down
			widget = {
				size = { 44 22 }
				parentanchor = vcenter

				textbox = {
					visible = "[Not(GreaterThanOrEqualTo_CFixedPoint(Scope.Var('cwp_iot_2_leanw').GetValue, '(CFixedPoint)3'))]"
					size = { 100% 100% }
					align = left|nobaseline
					raw_text = "#P [Scope.Var('cwp_iot_2_lean').GetValue|0]#!"
				}

				textbox = {
					visible = "[EqualTo_CFixedPoint(Scope.Var('cwp_iot_2_leanw').GetValue, '(CFixedPoint)3')]"
					size = { 100% 100% }
					align = left|nobaseline
					raw_text = "#gold [Scope.Var('cwp_iot_2_lean').GetValue|0]#!"
				}

				textbox = {
					visible = "[GreaterThanOrEqualTo_CFixedPoint(Scope.Var('cwp_iot_2_leanw').GetValue, '(CFixedPoint)4')]"
					size = { 100% 100% }
					align = left|nobaseline
					raw_text = "#N [Scope.Var('cwp_iot_2_lean').GetValue|0]#!"
				}
			}
		}

