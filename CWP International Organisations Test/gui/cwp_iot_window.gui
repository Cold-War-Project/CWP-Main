# CWP international organisations test: shared types, the opener button and the standalone window.
# The opener and the window are created at startup by gui/scripted_widgets/cwp_iot_widgets.txt.
# No vanilla .gui file is overwritten. Written by build_iot_gui.py; layout rules as in the
# scripted GUI test mod (fixed columns and button slots, a word and a colour per state).

types cwp_iot_types
{
	### A text button. "cwp_iot_button_selected" switches on a paper highlight,
	### "cwp_iot_button_style" swaps the vanilla button look.
	type cwp_iot_button = button {
		block "cwp_iot_button_style" {
			using = default_button
		}
		size = { 70 26 }

		widget = {
			size = { 100% 100% }

			block "cwp_iot_button_selected" {
				visible = no
			}

			background = {
				using = paper_bg
			}
		}

		textbox = {
			parentanchor = center
			autoresize = yes
			align = center|nobaseline
			fontsize = 14

			block "cwp_iot_button_text" {
				raw_text = "?"
			}
		}
	}

	### A column title.
	type cwp_iot_colhead = textbox {
		align = left|nobaseline
		default_format = "#title"
		using = fontsize_small
	}

	### The flag and name of a list entry that is a country.
	type cwp_iot_country_tag = flowcontainer {
		datacontext = "[Scope.GetCountry]"
		spacing = 6

		tiny_flag = {
			parentanchor = vcenter
		}

		textbox = {
			autoresize = yes
			parentanchor = vcenter
			align = nobaseline
			raw_text = "#b [Country.GetNameNoFormatting]#!"
		}
	}

	### Section headers (a title on the left, a figure on the right: vanilla's header bar),

	### body text and small grey notes, one type for each width the pages use.

	type cwp_iot_header_344 = default_header_2texts_clean {
		blockoverride "size" {
			size = { 344 34 }
		}
	}

	type cwp_iot_header_352 = default_header_2texts_clean {
		blockoverride "size" {
			size = { 352 34 }
		}
	}

	type cwp_iot_header_520 = default_header_2texts_clean {
		blockoverride "size" {
			size = { 520 34 }
		}
	}

	type cwp_iot_header_624 = default_header_2texts_clean {
		blockoverride "size" {
			size = { 624 34 }
		}
	}

	type cwp_iot_header_640 = default_header_2texts_clean {
		blockoverride "size" {
			size = { 640 34 }
		}
	}

	type cwp_iot_header_660 = default_header_2texts_clean {
		blockoverride "size" {
			size = { 660 34 }
		}
	}

	type cwp_iot_header_684 = default_header_2texts_clean {
		blockoverride "size" {
			size = { 684 34 }
		}
	}

	type cwp_iot_header_704 = default_header_2texts_clean {
		blockoverride "size" {
			size = { 704 34 }
		}
	}

	type cwp_iot_line_328 = textbox {
		autoresize = yes
		multiline = yes
		maximumsize = { 328 -1 }
		align = left|nobaseline
	}

	type cwp_iot_note_328 = textbox {
		autoresize = yes
		multiline = yes
		maximumsize = { 328 -1 }
		align = left|nobaseline
		default_format = "#title"
		using = fontsize_small
	}

	type cwp_iot_line_336 = textbox {
		autoresize = yes
		multiline = yes
		maximumsize = { 336 -1 }
		align = left|nobaseline
	}

	type cwp_iot_note_336 = textbox {
		autoresize = yes
		multiline = yes
		maximumsize = { 336 -1 }
		align = left|nobaseline
		default_format = "#title"
		using = fontsize_small
	}

	type cwp_iot_line_520 = textbox {
		autoresize = yes
		multiline = yes
		maximumsize = { 520 -1 }
		align = left|nobaseline
	}

	type cwp_iot_note_520 = textbox {
		autoresize = yes
		multiline = yes
		maximumsize = { 520 -1 }
		align = left|nobaseline
		default_format = "#title"
		using = fontsize_small
	}

	type cwp_iot_line_600 = textbox {
		autoresize = yes
		multiline = yes
		maximumsize = { 600 -1 }
		align = left|nobaseline
	}

	type cwp_iot_note_600 = textbox {
		autoresize = yes
		multiline = yes
		maximumsize = { 600 -1 }
		align = left|nobaseline
		default_format = "#title"
		using = fontsize_small
	}

	type cwp_iot_line_624 = textbox {
		autoresize = yes
