# CWP international organisations test: the panel inside each organisation's journal entry.
# A named flowcontainer that the journal entry's "widget" field places in custom_widget_container_3.
# Types come from gui/cwp_iot_window.gui. Written by build_iot_gui.py.
flowcontainer = {
	name = "cwp_iot_je_panel_1"
	ignoreinvisible = yes

	flowcontainer = {
		direction = vertical
		spacing = 8
		margin = { 0 8 }
		ignoreinvisible = yes

		cwp_iot_button = {
			size = { 300 34 }
			parentanchor = hcenter
			onclick = "[GetVariableSystem.Set('cwp_iot_org', '1')]"
			onclick = "[GetVariableSystem.Set('cwp_iot_tab', 'status')]"
			onclick = "[GetVariableSystem.Set('cwp_iot_window_open', 'yes')]"
			tooltip = "cwp_iot_je_open_tt"

			blockoverride "cwp_iot_button_style" {
				using = default_button_primary
			}

			blockoverride "cwp_iot_button_text" {
				text = "cwp_iot_je_open"
			}
		}

		cwp_iot_header_520 = {
			blockoverride "text1" {
				text = "cwp_iot_org_1"
			}

			blockoverride "text2" {
				raw_text = "[GetGlobalVariable('cwp_iot_1_count').GetValue|0] members"
			}
		}

		flowcontainer = {
			spacing = 6
			ignoreinvisible = yes

			default_progressbar_horizontal = {
				size = { 200 22 }
				parentanchor = vcenter

				blockoverride "values" {
					value = "[FixedPointToFloat(GetGlobalVariable('cwp_iot_1_bar1').GetValue)]"
					min = 0
					max = 100
				}

				textbox = {
					parentanchor = center
					autoresize = yes
					align = center|nobaseline
					fontsize = 13
					raw_text = "Authority [GetGlobalVariable('cwp_iot_1_bar1').GetValue|0]"
				}
			}

			gold_progressbar_horizontal = {
				size = { 200 22 }
				parentanchor = vcenter

				blockoverride "values" {
					value = "[FixedPointToFloat(GetGlobalVariable('cwp_iot_1_bar2').GetValue)]"
					min = 0
					max = 100
				}

				textbox = {
					parentanchor = center
					autoresize = yes
					align = center|nobaseline
					fontsize = 13
					raw_text = "Universality [GetGlobalVariable('cwp_iot_1_bar2').GetValue|0]"
				}
			}
		}

		cwp_iot_line_520 = {
			visible = "[EqualTo_CFixedPoint(GetGlobalVariable('cwp_iot_1_phase').GetValue, '(CFixedPoint)1')]"
			text = "cwp_iot_in_session"
		}

		cwp_iot_line_520 = {
			visible = "[EqualTo_CFixedPoint(GetGlobalVariable('cwp_iot_1_phase').GetValue, '(CFixedPoint)0')]"
			raw_text = "In recess. The next regular session is #v [GetGlobalVariable('cwp_iot_1_recess').GetValue|0]#! months away."
		}

		cwp_iot_note_520 = {
			raw_text = "X7   kept on the entry itself: [JournalEntry.MakeScope.Var('cwp_iot_probe').GetValue|0]     expect 41"
		}

		cwp_iot_note_520 = {
			raw_text = "X7b  a list kept on the entry: [GetDataModelSize(JournalEntry.MakeScope.GetList('cwp_iot_je_list'))] entry     expect 1"
		}
	}
}

