	type treaty_tooltip_article_entry = container {
		treaty_tooltip_article = {
			visible = "[Not(Or(Or(Article.HasType('acquire_monopoly_for_company'), Article.RequiresInput('ship')), Article.HasType('free_text')))]"
		}

		treaty_tooltip_article = {
			visible = "[Article.HasType('acquire_monopoly_for_company')]"
			size = { 220 75 }
		}

		treaty_tooltip_article = {
			visible = "[Article.RequiresInput('ship')]"
			size = { 220 90 }
		}

		treaty_tooltip_article = {
			visible = "[Article.HasType('free_text')]"

			blockoverride "text_maximumsize" {
				maximumsize = { 160 20 }
			}
		}
	}

	type treaty_tooltip_article = widget {
		size = { 220 40 }

		state = {
			name = 1
			next = 2
			alpha = 0.5
			duration = 1.4
			using = Animation_Curve_Default
			trigger_when = "[Article.ExceedsMaxContraventions(Country.Self)]"
		}

		state = {
			name = 2
			next = 1
			alpha = 1
			duration = 1.4
			using = Animation_Curve_Default
		}

		block "article_tooltip" {
			tooltipwidget = {
				FancyTooltip_ArticleWithCountryContext = {}
			}
		}

		background = {
			using = simple_frame
		}

		flowcontainer = {
			spacing = 5

			block "text_icon_position" {
				parentanchor = vcenter
				position = { 10 0 }
			}

			icon = {
				parentanchor = vcenter
				size = { 30 30 }
				texture = "[Article.GetIcon]"
			}

			vertical_divider = {
				visible = "[Article.GetArticleType.RequiresAnyInput]"
			}

			widget = {
				visible = "[Article.GetArticleType.RequiresAnyInput]"
				size = { 0 0 }
			}

			### ARTICLE WITH NO INPUT - FULFILLED SIZE
			textbox = {
				visible = "[And(Not(Article.GetArticleType.RequiresAnyInput), Not(Article.ExceedsMaxContraventions(Country.Self)))]"
				parentanchor = vcenter
				autoresize = yes
				align = nobaseline
				using = elide_fontsize_min
				max_width = 150
				fonttintcolor = "[TooltipInfo.GetTintColor]"
				text = "[Article.GetNameNoFormatting]"
			}

			### ARTICLE WITH NO INPUT - NOT FULFILLED SIZE
			textbox = {
				visible = "[And(Not(Article.GetArticleType.RequiresAnyInput), Article.ExceedsMaxContraventions(Country.Self))]"
				parentanchor = vcenter
				autoresize = yes
				align = nobaseline
				using = elide_fontsize_min
				max_width = 130
				fonttintcolor = "[TooltipInfo.GetTintColor]"
				text = "[Article.GetNameNoFormatting]"
			}

			### MONEY TRANSFER
			money_transfer_article = {
				parentanchor = vcenter

				blockoverride "text_format" {
					fonttintcolor = "[TooltipInfo.GetTintColor]"
				}
			}

			### STATE INPUT
			state_input_article = {
				parentanchor = vcenter

				blockoverride "text_format" {
					fonttintcolor = "[TooltipInfo.GetTintColor]"
				}
			}

			### COUNTRY INPUT
			country_input_article = {
				parentanchor = vcenter

				blockoverride "text_format" {
					fonttintcolor = "[TooltipInfo.GetTintColor]"
				}
			}

			### SHIP INPUT
			ship_input_article = {
				parentanchor = vcenter

				blockoverride "text_format" {
					fonttintcolor = "[TooltipInfo.GetTintColor]"
				}
			}

			### STRATEGIC REGION INPUT
			strategic_region_input_article = {
				parentanchor = vcenter

				blockoverride "text_format" {
					fonttintcolor = "[TooltipInfo.GetTintColor]"
				}
			}

			### GOODS TRANSFER
			goods_transfer_article = {
				parentanchor = vcenter

				blockoverride "text_format" {
					fonttintcolor = "[TooltipInfo.GetTintColor]"
				}
			}

			### GENERAL GOODS INPUT
			goods_input_article = {
				parentanchor = vcenter

				blockoverride "text_format" {
					fonttintcolor = "[TooltipInfo.GetTintColor]"
				}
			}

			### COMPANY MONOPOLY
			company_monopoly_article = {
				parentanchor = vcenter

				blockoverride "text_format" {
					fonttintcolor = "[TooltipInfo.GetTintColor]"
				}
			}

			### TEXT INPUT
			text_input_article = {
				parentanchor = vcenter
				blockoverride "raw_text" {
					raw_text = "[Article.GetNameNoFormatting]"
				}

				blockoverride "text_format" {
					fonttintcolor = "[TooltipInfo.GetTintColor]"
				}
			}

			### LAW COMMITMENT
			law_commitment_article = {
				parentanchor = vcenter

				blockoverride "text_format" {
					fonttintcolor = "[TooltipInfo.GetTintColor]"
				}

				blockoverride "law_icon_background_size" {
					size = { 38 38 }
			}

				blockoverride "law_name_text_maximumsize" {
					maximumsize = { 110 38 }
		}
			}
		}

		icon = {
			visible = "[Article.ExceedsMaxContraventions(Country.Self)]"
			parentanchor = right|vcenter
			position = { -5 0 }
			size = { 30 30 }
			texture = "gfx/interface/icons/generic_icons/warning.dds"
		}
	}

