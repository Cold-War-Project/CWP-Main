	type FancyTooltip_WarGoalDraftArticle = FancyTooltip_WarGoalDraft {
		datacontext = "[WarGoalDraft.GetDiplomaticPlay]"

		blockoverride "wargoal_icon_texture" {
			texture = "[WarGoalDraft.GetArticleType.GetIcon]"
		}

		blockoverride "wargoal_type" {
			raw_text = "WARGOAL_ARTICLE_TYPE"
		}

		blockoverride "war_goal_before_text" {
			custom_tooltip_textbox_with_empty_line = {
				visible = "[Not(StringIsEmpty(ArticleDraft.GetRequiredInputsDesc))]"
				text = "[ArticleDraft.GetRequiredInputsDesc]"
			}

			block "can_add_article_text" {}

			flowcontainer = {
				visible = "[And(ArticleDraft.HasType('law_commitment'), ArticleDraft.HasAllRequiredInputsSet)]"
				direction = vertical
				datacontext = "[WarGoalDraft.GetArticleDraft]"
				datacontext = "[WarGoalDraft.GetTarget]"
				datacontext = "[ArticleDraft.GetLawType]"

				flowcontainer = {
					margin = { 15 10 }

					tooltipwidget = {
						FancyTooltip_LawType = {}
					}

					background = {
						using = entry_bg
					}

					flowcontainer = {
						parentanchor = vcenter
						spacing = 10

						icon = {
							parentanchor = vcenter
							size = { 50 50 }
							texture = "[LawType.GetTexture]"
						}

						flowcontainer = {
							parentanchor = vcenter
							direction = vertical

							custom_tooltip_textbox = {
								max_width = 450
								text = "[LawType.GetGroup.GetName]"
							}

							custom_tooltip_textbox = {
								max_width = 450
								using = fontsize_large
								text = "[LawType.GetNameNoFormatting]"
							}
						}
					}
				}

				widget = {
					size = { 5 5 }
				}

				custom_tooltip_textbox_with_empty_line = {
					visible = "[ObjectsEqual(ArticleDraft.GetLawType, Country.GetActiveLawFromGroup(ArticleDraft.GetLawType.GetGroup.GetKey).GetLawType)]"
					text = "ACTIVE_LAW_COUNTRY"
				}

				custom_tooltip_textbox_with_empty_line = {
					visible = "[And(Not(ObjectsEqual(ArticleDraft.GetLawType, Country.GetActiveLawFromGroup(ArticleDraft.GetLawType.GetGroup.GetKey).GetLawType)), Not(ObjectsEqual(ArticleDraft.GetLawType, Country.GetLawBeingEnacted.GetLawType)))]"
					text = "INACTIVE_LAW_COUNTRY"
				}

				custom_tooltip_textbox_with_empty_line = {
					visible = "[ObjectsEqual(ArticleDraft.GetLawType, Country.GetLawBeingEnacted.GetLawType)]"
					datacontext = "[Country.GetLawBeingEnacted]"
					text = "LAW_BEING_ENACTED_DESC"
				}
			}
		}

		blockoverride "infamy" {
			custom_tooltip_textbox = {
				visible = "[GreaterThan_CFixedPoint(ArticleDraft.GetWarGoalInfamyValue(GetPlayer.Self), '(CFixedPoint)0')]"
				text = "[ArticleDraft.GetWarGoalInfamyValueDesc(GetPlayer.Self)]"
			}
		}

		blockoverride "maneuver_cost" {
			custom_tooltip_textbox_with_empty_line = {
				text = "[ArticleDraft.GetWarGoalManeuversCostDesc(GetPlayer.Self, DiplomaticPlay.Self)]"
			}
		}

		blockoverride "click_prompt_visibility" {
			visible = no
		}

		blockoverride "war_goal_desc" {
			### GENERAL EFFECTS
			custom_tooltip_textbox = {
				visible = "[Not(StringIsEmpty(ArticleDraft.GetEffectsDesc))]"
				margin_left = 10
				text = "ARTICLE_DRAFT_EFFECTS"
			}

			### RELATION EFFECTS
			custom_tooltip_textbox = {
				visible = "[Not(StringIsEmpty(ArticleDraft.GetRelationsEffectDesc))]"
				margin_left = 10
				text = "ARTICLE_DRAFT_EFFECTS_RELATION"
			}

			custom_tooltip_newline = {
				visible = "[Not(StringIsEmpty(ArticleDraft.GetMutualModifierDesc))]"
			}

			### MUTUAL MODIFIERS TITLE
			custom_tooltip_textbox = {
				visible = "[Not(StringIsEmpty(ArticleDraft.GetMutualModifierDesc))]"
				text = "ARTICLE_DRAFT_MUTUAL_MODIFIERS_TITLE"
			}

			### MUTUAL MODIFIERS
			custom_tooltip_textbox = {
				visible = "[Not(StringIsEmpty(ArticleDraft.GetMutualModifierDesc))]"
				margin_left = 10
				text = "ARTICLE_DRAFT_MUTUAL_MODIFIERS"
			}

			custom_tooltip_newline = {
				visible = "[Not(StringIsEmpty(ArticleDraft.GetSourceModifierDesc))]"
			}

			### SOURCE MODIFIERS TITLE
			custom_tooltip_textbox = {
				visible = "[Not(StringIsEmpty(ArticleDraft.GetSourceModifierDesc))]"
				text = "ARTICLE_DRAFT_WAR_GOAL_SOURCE_MODIFIERS_TITLE"
			}

			### SOURCE MODIFIERS
			custom_tooltip_textbox = {
				visible = "[Not(StringIsEmpty(ArticleDraft.GetSourceModifierDesc))]"
				margin_left = 10
				text = "ARTICLE_DRAFT_SOURCE_MODIFIERS"
			}

			custom_tooltip_newline = {
				visible = "[Not(StringIsEmpty(ArticleDraft.GetTargetModifierDesc))]"
			}

			### TARGET MODIFIERS TITLE
			custom_tooltip_textbox = {
				visible = "[Not(StringIsEmpty(ArticleDraft.GetTargetModifierDesc))]"
				text = "ARTICLE_DRAFT_WAR_GOAL_TARGET_MODIFIERS_TITLE"
			}

			### TARGET MODIFIERS
