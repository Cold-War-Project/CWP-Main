		custom_tooltip_textbox_with_empty_line = {
			visible = "[Not(StringIsEmpty(PowerBlocPrinciple.GetIsPossibleTriggerDesc))]"
			text = "[PowerBlocPrinciple.GetIsPossibleTriggerDesc]"
