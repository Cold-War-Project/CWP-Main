	type harvest_condition_tooltip_item = widget {
		size = { 540 40 }

		tooltipwidget = {
			FancyTooltip_HarvestCondition = {}
		}

		background = {
			using = entry_bg_simple
		}

		textbox = {
			parentanchor = vcenter
			size = { 40 30 }
			position = { 10 0 }
			align = nobaseline
			elide = right
			fontsize_min = 12
			text = "HARVEST_CONDITION_AREA_STATE_ENTRY_INTENSITY"
		}

		flowcontainer = {
			parentanchor = vcenter
			position = { 60 0 }
			spacing = 5

