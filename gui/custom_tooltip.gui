	type FancyTooltip_StrategicRegion = FancyTooltipWidgetType {
		blockoverride "text" {} #all content is in 'blockoverride "tooltip_content_after"

		blockoverride "name" {
			text = "[StrategicRegion.GetNameNoFormatting]"
		}

		blockoverride "type" {
			text = "TOOLTIP_TYPE_STRATEGIC_REGION"
		}

		blockoverride "go_to_button" {
			button_icon_goto = {
				size = { 30 30 }
				input_action = "go_to_details"
				using = tooltip_ne
				onclick = "[InformationPanelBar.OpenStrategicRegionPanel(StrategicRegion.Self)]"
				tooltip = "GO_TO_BUTTON_STRATEGIC_REGION"
			}
		}

		blockoverride "instruction_text" {
			visible = no
		}

		blockoverride "table_visibility" {
			visible = yes
			minimumsize = { @tooltip_fixed_width -1 }
		}

		blockoverride "row_background" {
			using = dark_area
		}

		blockoverride "table_datamodel" {
			datamodel = "[DataModelFirst(StrategicRegion.GetCountriesWithInterest, '(int32)10')]"
		}

		blockoverride "content_after_table" {
			hbox = {
				layoutpolicy_horizontal = expanding

				custom_tooltip_textbox = {
					visible = "[GreaterThan_int32(GetDataModelSize(StrategicRegion.GetCountriesWithInterest), '(int32)10')]"
					default_format = "#tooltippable"
					text = "DATA_STRATEGIC_REGION_AND_X_MORE_COUNTRIES"

					tooltipwidget = {
						RegularTooltip_CountriesWithInterest_MoreThan10 = {}
					}
				}

				expand = {}
			}
		}

		blockoverride "table_header_1" {
			text = "[concept_country]"
		}

		blockoverride "table_header_2" {
			align = nobaseline
			margin_left = 25
			text = "[concept_involvement]"
		}

		blockoverride "table_header_3" {
			tooltip = "STANCE_TOOLTIP"
			text = "STANCE"
			align = hcenter|nobaseline
		}

		blockoverride "table_header_4" {
			text = "[concept_locality]"
		}

		blockoverride "table_value_1" {
			minimumsize = { 190 -1 }
			maximumsize = { 190 -1 }
			text = "[Country.GetName]"
		}

		blockoverride "table_value_2" {
			minimumsize = { 125 -1 }
			maximumsize = { 125 -1 }
			align = nobaseline
			raw_text = "[Country.GetCurrentInterestTierTypeIn(StrategicRegion.Self).GetName]"
		}

		blockoverride "table_value_3" {
			minimumsize = { 50 -1 }
			maximumsize = { 50 -1 }

			icon = {
				visible = "[Not(Country.IsPlayer)]"
				parentanchor = center
				size = { 24 24 }
				datacontext = "[Country.GetAIStrategicRegionStanceTypeIn(StrategicRegion.Self)]"
				texture = "[AIStrategicRegionStanceType.GetIcon]"

				tooltipwidget = {
					FancyTooltip_AIStrategicRegionStanceType = {}
				}
			}

			textbox = {
				visible = "[Country.IsPlayer]"
				parentanchor = center
				align = nobaseline
				autoresize = yes
				alpha = 0.5
				text = "NONE"
			}
		}

		blockoverride "table_value_4" {
			minimumsize = { 70 -1 }
			maximumsize = { 70 -1 }
			margin_right = 5
			raw_text = "#b [Country.GetLocalityInDisplay(StrategicRegion.Self)|0%]#!"
			tooltip = "COUNTRY_STRATEGIC_REGION_LOCALITY_TOOLTIP"
		}

		blockoverride "tooltip_content_after" {
			max_width = @tooltip_fixed_width
			min_width = @tooltip_fixed_width

			background = {
				texture = "[StrategicRegion.GetBestTexture]"
				fittype = centercrop
				alpha = 0.15
			}

			custom_tooltip_textbox = {
				text = "DATA_STRATEGIC_REGION_PLAYER_HAS_INTEREST"
			}

			custom_tooltip_textbox_with_empty_line = {
				text = "DATA_STRATEGIC_REGION_GDP"
			}

			widget = {
				visible = "[GreaterThan_CFixedPoint(GetPlayer.GetCurrentInvolvementIn(StrategicRegion.Self), '(CFixedPoint)0')]"
				datacontext = "[GetPlayer]"
				datacontext = "[GetPlayer.GetCurrentInterestTierTypeIn(StrategicRegion.Self)]"
				size = { 470 50 }

				country_involvement_bar_with_label = {
					margin_right = 10

					blockoverride "above_bar_text_hbox" {
						hbox = {
							layoutpolicy_horizontal = expanding

							custom_tooltip_textbox = {
								text = "DATA_STRATEGIC_REGION_CURRENT_PLAYER_INVOLVEMENT"
								max_width = 300
							}

							expand = {}
						}
					}
				}
			}

			custom_tooltip_newline = {
				visible = "[GreaterThan_CFixedPoint(GetPlayer.GetCurrentInvolvementIn(StrategicRegion.Self), '(CFixedPoint)0')]"
			}
		}
	}

