@tooltip_max_width = 550 #copied from tooltip.gui

@tooltip_fixed_width = 500 #for 2 column layouts etc, since max_width is quite wide
@tooltip_fixed_column_width = 245 #tooltip_fixed_width/2 - 10/2
@tooltip_fixed_column_width_minus_40 = 205
@tooltip_fixed_column_width_minus_16 = 229

types TooltipTypes
{
	type custom_tooltip_textbox = DefaultTooltipTextBox {
		max_width = @tooltip_max_width
		fonttintcolor = "[TooltipInfo.GetTintColor]"
		multiline = yes
	}

	type custom_tooltip_textbox_column_width = custom_tooltip_textbox {
		max_width = @tooltip_fixed_column_width
	}

	type custom_tooltip_textbox_fixed_width = custom_tooltip_textbox {
		max_width = @tooltip_fixed_width
	}

	type custom_tooltip_textbox_with_empty_line = custom_tooltip_textbox {
		margin_bottom = 15
	}

	type custom_tooltip_textbox_with_empty_line_fixed_width = custom_tooltip_textbox_with_empty_line {
		max_width = @tooltip_fixed_width
	}

	type custom_tooltip_newline = widget {
		size = { 21 21 }
	}

	type tooltip_divider = widget {
		parentanchor = hcenter
		size = { 100% 20 }

		divider_clean = {
			parentanchor = center
		}
	}

	type custom_tooltip_2_columns = flowcontainer {
		direction = horizontal
		using = tooltip_segment_margin

		spacing = 10

		block "bg"
		{
			using = tooltip_segment_background
		}


		flowcontainer = {
			direction = vertical
			max_width = @tooltip_fixed_column_width
			min_width = @tooltip_fixed_column_width
			block "left_column"
			{

			}
		}

		flowcontainer = {
			direction = vertical
			max_width = @tooltip_fixed_column_width
			min_width = @tooltip_fixed_column_width

			block "right_column"
			{

			}
		}
	}

	type custom_tooltip_2_columns_text_values = widget {
		size = { 245 24 }

		divider_clean = {}


		flowcontainer = {
			parentanchor = vcenter
			spacing = 2

			textbox = {
				size = { 100 24 }
				parentanchor = vcenter
				align = nobaseline
				using = elide_fontsize_min
				fonttintcolor = "[TooltipInfo.GetTintColor]"

				block "first_text" {
					raw_text = "[concept_concept]"
				}
			}

			block "whole_icon" {
				icon = {
					size = { 24 24 }

					block "icon_texture" {
						texture = "gfx/interface/icons/generic_icons/disapproval_icon.dds"
					}
				}
			}

			custom_tooltip_textbox = {
				parentanchor = vcenter
				max_width = 120

				block "second_text" {
					raw_text = "#b Cool Value#!"
				}
			}
		}
	}

	type FancyTooltip_DecreeType = FancyTooltipWidgetType {
		blockoverride "text" {} # Fully replaced by everything in tooltip_content_after

		blockoverride "icon_texture" {
			texture = "[DecreeType.GetTexture]"
		}

		blockoverride "icon_background_texture" {}

		blockoverride "icon_frame" {}

		blockoverride "name" {
			text = "[DecreeType.GetNameNoFormatting]"
		}

		blockoverride "type" {
			text = "TOOLTIP_TYPE_DECREE_TYPE"
		}

		blockoverride "tooltip_content_after" {
			custom_tooltip_textbox_with_empty_line = {
				visible = "[Not(StringIsEmpty(DecreeType.GetErrors(GetPlayer.Self)))]"
				text = "[DecreeType.GetErrors(GetPlayer.Self)]"
			}

			custom_tooltip_textbox_with_empty_line = {
				text = "[DecreeType.GetEffects]"
			}

			custom_tooltip_textbox = {
				text = "[DecreeType.GetCostFormatted(GetPlayer.Self)]"
			}

			block "available_options" {}

			tooltip_divider = {}

			custom_tooltip_textbox = {
				default_format = "#lore"
				text = "[DecreeType.GetDesc]"
			}
		}
	}

	type FancyTooltip_Treaty = FancyTooltipWidgetType {
		blockoverride "text" {} # Fully replaced by everything in tooltip_content_after

		blockoverride "icon_texture" {
			texture = "gfx/interface/icons/generic_icons/diplomatic_treaties.dds"
		}

		blockoverride "name" {
			text = "[Treaty.GetNameNoFormatting]"
		}

		blockoverride "type" {
			text = "TREATY_TYPE"
		}

		blockoverride "go_to_button_tooltip" {
			tooltip = "GO_TO_TREATY"
		}

		blockoverride "go_to_button_visibility" {
			visible = yes
		}

		blockoverride "go_to_button_properties" {
			onclick = "[InformationPanelBar.OpenTreatyPanel( Treaty.Self )]"
		}

		blockoverride "tooltip_content_after" {
			### ENTERED INTO FORCE DATE
			custom_tooltip_textbox = {
				visible = "[Not(Treaty.IsDraft)]"
				text = "TREATY_START_DATE_HEADER"
			}

			### BINDING PERIOD
			custom_tooltip_textbox = {
				visible = "[NotZero(Treaty.GetBindingDaysLeft)]"
				text = "TREATY_BINDING_PERIOD_REMAINING"
			}

			### BINDING PERIOD FOR DRAFTS
			custom_tooltip_textbox = {
				visible = "[And(Treaty.IsDraft, NotZero(Treaty.GetBindingDays))]"
				text = "TREATY_BINDING_PERIOD_WHEN_DRAFT"
			}

			### BINDING PERIOD HAS ENDED
			custom_tooltip_textbox = {
				visible = "[And3(Not(Treaty.IsDraft), IsZero(Treaty.GetBindingDaysLeft), NotZero(Treaty.GetBindingDays))]"
				text = "TREATY_BINDING_PERIOD_HAS_ENDED"
			}

			### NO BINDING PERIOD SET TO BEGIN WITH
			custom_tooltip_textbox = {
				visible = "[IsZero(Treaty.GetBindingDays)]"
				text = "TREATY_NO_BINDING_PERIOD"
			}

			custom_tooltip_textbox = {
				visible = "[Treaty.IsEnforced]"
				text = "TREATY_IS_ENFORCED_ON"
			}

			### OBLIGATIONS USED OR OWED
			flowcontainer = {
				visible = "[Treaty.AreObligationsEffectuated]"
				direction = vertical
				using = tooltip_ne
				tooltip = "OBLIGATION_DELAY_EXPLANATION"

				custom_tooltip_textbox = {
					visible = "[Treaty.DoesCallInObligation(Treaty.GetRightCountry.Self)]"
					datacontext = "[Treaty.GetRightCountry]"
					text = "TREATY_COUNTRY_HAS_CALLED_IN_OBLIGATION"
				}

				custom_tooltip_textbox = {
					visible = "[Treaty.DoesOweObligation(Treaty.GetRightCountry.Self)]"
					datacontext = "[Treaty.GetRightCountry]"
					text = "TREATY_COUNTRY_HAS_OWED_OBLIGATION"
				}

				custom_tooltip_textbox = {
					visible = "[Treaty.DoesCallInObligation(Treaty.GetLeftCountry.Self)]"
					datacontext = "[Treaty.GetLeftCountry]"
					text = "TREATY_COUNTRY_HAS_CALLED_IN_OBLIGATION"
				}

				custom_tooltip_textbox = {
					visible = "[Treaty.DoesOweObligation(Treaty.GetLeftCountry.Self)]"
					datacontext = "[Treaty.GetLeftCountry]"
					text = "TREATY_COUNTRY_HAS_OWED_OBLIGATION"
				}
			}

			flowcontainer = {
				visible = "[And(Not(Treaty.AreObligationsEffectuated), Or(Or(Or(Treaty.DoesOweObligation(Treaty.GetLeftCountry.Self), Treaty.DoesCallInObligation(Treaty.GetLeftCountry.Self)), Treaty.DoesOweObligation(Treaty.GetRightCountry.Self)), Treaty.DoesCallInObligation(Treaty.GetRightCountry.Self)))]"
				direction = vertical
				using = tooltip_ne
				tooltip = "OBLIGATION_DELAY_EXPLANATION"

				custom_tooltip_textbox = {
					visible = "[Treaty.DoesCallInObligation(Treaty.GetRightCountry.Self)]"
					datacontext = "[Treaty.GetRightCountry]"
					text = "TREATY_COUNTRY_WILL_CALL_IN_OBLIGATION"
				}

				custom_tooltip_textbox = {
					visible = "[Treaty.DoesOweObligation(Treaty.GetRightCountry.Self)]"
					datacontext = "[Treaty.GetRightCountry]"
					text = "TREATY_COUNTRY_WILL_OWE_OBLIGATION"
				}

				custom_tooltip_textbox = {
					visible = "[Treaty.DoesCallInObligation(Treaty.GetLeftCountry.Self)]"
					datacontext = "[Treaty.GetLeftCountry]"
					text = "TREATY_COUNTRY_WILL_CALL_IN_OBLIGATION"
				}

				custom_tooltip_textbox = {
					visible = "[Treaty.DoesOweObligation(Treaty.GetLeftCountry.Self)]"
					datacontext = "[Treaty.GetLeftCountry]"
					text = "TREATY_COUNTRY_WILL_OWE_OBLIGATION"
				}
			}

			tooltip_divider = {}

			container = {
				minimumsize = { 400 -1 }

				background = {
					using = dark_area
					alpha = 0.2
					margin = { 13 0 }
					margin_top = 10
				}

				flowcontainer = {
					position = { 5 5 }
					datacontext = "[Treaty.GetLeftCountry]"

					### Using a container here to make sure the influence cost background goes behind the flag.
					container = {
						parentanchor = vcenter

						widget = {
							parentanchor = vcenter
							position = { 50 0 }
							size = { 75 29 }

							total_influence_cost = {
								blockoverride "background_alpha" {
									alpha = 1
								}

								blockoverride "horizontal_margins" {
									margin_left = 5
									margin_right = 5
								}
							}
						}

						small_flag = {
							parentanchor = vcenter

							blockoverride "additional_flag_properties" {
								button = {
									visible = "[Treaty.IsEnforcedOn(Country.Self)]"
									parentanchor = vcenter|right
									size = { 40 40 }
									position = { 20 0 }
									alwaystransparent = yes
									texture = "gfx/interface/icons/generic_icons/capitulate.dds"
								}
							}
						}
					}

					flowcontainer = {
						visible = "[Or(Or(And(Treaty.DoesOweObligation(Country.Self), Treaty.AreObligationsEffectuated), And(Treaty.DoesOweObligation(Country.Self), Not(Treaty.AreObligationsEffectuated))), Not(Country.IsPlayer))]"
						parentanchor = vcenter
						direction = vertical
						datacontext = "[Treaty.GetLeftCountry]"

						widget = {
							visible = "[Not(Country.IsPlayer)]"
							size = { 20 20 }
							tooltip = "[Treaty.GetAcceptanceBreakdown(Country.Self)]"

							icon = {
								visible = "[LessThan_int32(Treaty.GetAcceptance(Country.Self), '(int32)0')]"
								parentanchor = center
								size = { 20 20 }
								texture = "gfx/interface/icons/generic_icons/disapproval_icon.dds"
							}

							icon = {
								visible = "[EqualTo_int32(Treaty.GetAcceptance(Country.Self), '(int32)0')]"
								parentanchor = center
								size = { 20 20 }
								texture = "gfx/interface/icons/generic_icons/undecided_icon.dds"
							}

							icon = {
								visible = "[GreaterThan_int32(Treaty.GetAcceptance(Country.Self), '(int32)0')]"
								parentanchor = center
								size = { 20 20 }
								texture = "gfx/interface/icons/generic_icons/approval_icon.dds"
							}
						}

						widget = {
							visible = "[Or(And(Treaty.DoesOweObligation(Country.Self), Treaty.AreObligationsEffectuated), And(Treaty.DoesOweObligation(Country.Self), Not(Treaty.AreObligationsEffectuated)))]"
							size = { 20 20 }

							icon = {
								visible = "[And(Treaty.DoesOweObligation(Country.Self), Treaty.AreObligationsEffectuated)]"
								parentanchor = center
								size = { 20 20 }
								using = tooltip_se
								tooltip = "TREATY_COUNTRY_HAS_OWED_OBLIGATION_WITH_EXPLANATION"
								texture = "gfx/interface/icons/generic_icons/obligation.dds"
							}

							icon = {
								visible = "[And(Treaty.DoesOweObligation(Country.Self), Not(Treaty.AreObligationsEffectuated))]"
								parentanchor = center
								size = { 20 20 }
								using = tooltip_se
								tooltip = "TREATY_COUNTRY_WILL_OWE_OBLIGATION_WITH_EXPLANATION"
								texture = "gfx/interface/icons/generic_icons/obligation.dds"
							}
						}
					}
				}

				flowcontainer = {
					parentanchor = right
					position = { -5 5 }
					datacontext = "[Treaty.GetRightCountry]"

					flowcontainer = {
						parentanchor = vcenter
						direction = vertical
						datacontext = "[Treaty.GetRightCountry]"

						widget = {
							visible = "[Not(Country.IsPlayer)]"
							size = { 20 20 }
							tooltip = "[Treaty.GetAcceptanceBreakdown(Country.Self)]"

							icon = {
								visible = "[LessThan_int32(Treaty.GetAcceptance(Country.Self), '(int32)0')]"
								parentanchor = center
								size = { 20 20 }
								texture = "gfx/interface/icons/generic_icons/disapproval_icon.dds"
							}

							icon = {
								visible = "[EqualTo_int32(Treaty.GetAcceptance(Country.Self), '(int32)0')]"
								parentanchor = center
								size = { 20 20 }
								texture = "gfx/interface/icons/generic_icons/undecided_icon.dds"
							}

							icon = {
								visible = "[GreaterThan_int32(Treaty.GetAcceptance(Country.Self), '(int32)0')]"
								parentanchor = center
								size = { 20 20 }
								texture = "gfx/interface/icons/generic_icons/approval_icon.dds"
							}
						}

						widget = {
							visible = "[Or(And(Treaty.DoesOweObligation(Country.Self), Treaty.AreObligationsEffectuated), And(Treaty.DoesOweObligation(Country.Self), Not(Treaty.AreObligationsEffectuated)))]"
							size = { 20 20 }

							icon = {
								visible = "[And(Treaty.DoesOweObligation(Country.Self), Treaty.AreObligationsEffectuated)]"
								parentanchor = center
								size = { 20 20 }
								using = tooltip_se
								tooltip = "TREATY_COUNTRY_HAS_OWED_OBLIGATION_WITH_EXPLANATION"
								texture = "gfx/interface/icons/generic_icons/obligation_flipped.dds"
							}

							icon = {
								visible = "[And(Treaty.DoesOweObligation(Country.Self), Not(Treaty.AreObligationsEffectuated))]"
								parentanchor = center
								size = { 20 20 }
								using = tooltip_se
								tooltip = "TREATY_COUNTRY_WILL_OWE_OBLIGATION_WITH_EXPLANATION"
								texture = "gfx/interface/icons/generic_icons/obligation_flipped.dds"
							}
						}
					}

					widget = {
						parentanchor = vcenter
						size = { 75 29 }

						total_influence_cost = {
							blockoverride "expand_before" {
								expand = {}
							}

							blockoverride "expand_after" {}

							blockoverride "background_alpha" {
								alpha = 1
							}

							blockoverride "horizontal_margins" {
								margin_left = 5
								margin_right = 7
							}

							blockoverride "background_margin" {
								margin_right = 10
							}
						}
					}

					small_flag = {
						parentanchor = vcenter

						blockoverride "additional_flag_properties" {
							button = {
								visible = "[Treaty.IsEnforcedOn(Country.Self)]"
								parentanchor = vcenter|right
								size = { 40 40 }
								position = { 20 0 }
								alwaystransparent = yes
								texture = "gfx/interface/icons/generic_icons/capitulate.dds"
							}
						}
					}
				}

				flowcontainer = {
					position = { 0 50 }
					direction = vertical
					spacing = 2

					### MUTUAL AGREEMENTS
					flowcontainer = {
						parentanchor = hcenter
						direction = vertical
						datacontext = "[Treaty.GetLeftCountry]"
						datamodel = "[Treaty.GetMutualAgreements]"
						alpha = "[TransparentIfTrue(Treaty.IsFrozenForBothCountries)]"

						item = {
							treaty_tooltip_article = {
								size = { 450 40 }

								blockoverride "text_icon_position" {
									parentanchor = center
								}
							}
						}
					}

					flowcontainer = {
						visible = "[Not(And(IsDataModelEmpty(Treaty.GetOffers), IsDataModelEmpty(Treaty.GetDemands)))]"
						parentanchor = hcenter
						spacing = 4

						### LEFT ARTICLES
						flowcontainer = {
							direction = vertical
							datacontext = "[Treaty.GetLeftCountry]"

							flowcontainer = {
								visible = "[And(Not(IsDataModelEmpty(Treaty.GetOffers)), LessThanOrEqualTo_int32(GetDataModelSize(Treaty.GetOffers), '(int32)10'))]"
								direction = vertical
								datamodel = "[Treaty.GetOffers]"
								spacing = 2
								alpha = "[TransparentIfTrue(Treaty.IsFrozenFor(Country.Self))]"

								item = {
									treaty_tooltip_article_entry = {}
								}
							}

							flowcontainer = {
								visible = "[GreaterThan_int32(GetDataModelSize(Treaty.GetOffers), '(int32)10')]"
								direction = vertical
								datamodel = "[DataModelFirst(Treaty.GetOffers, '(int32)10')]"
								spacing = 2
								alpha = "[TransparentIfTrue(Treaty.IsFrozenFor(Country.Self))]"

								item = {
									treaty_tooltip_article_entry = {}
								}
							}

							### MORE THAN 10 LEFT ARTICLES
							widget = {
								visible = "[GreaterThan_int32(GetDataModelSize(Treaty.GetOffers), '(int32)10')]"
								size = { 220 40 }
								using = tooltip_ws

								tooltipwidget = {
									RegularTooltip_TreatyArticlesPage = {
										blockoverride "articles_datamodel" {
											datamodel = "[DataModelSkipFirst(Treaty.GetOffers, '(int32)10')]"
										}
									}
								}

								background = {
									using = simple_frame
								}

								flowcontainer = {
									spacing = 5
									parentanchor = vcenter
									position = { 10 0 }

									### AND X MORE
									textbox = {
										parentanchor = vcenter
										autoresize = yes
										align = nobaseline
										using = elide_fontsize_min
										max_width = 200
										fonttintcolor = "[TooltipInfo.GetTintColor]"
										text = "TREATY_ARTICLE_AND_X_MORE_OFFERS"
									}
								}
							}

							### FROZEN STATUS - LEFT SIDE
							textbox = {
								visible = "[And(And(Not(IsDataModelEmpty(Treaty.GetOffers)), Treaty.IsFrozenFor(Country.Self)), Not(Country.IsAtWarWith(Treaty.GetOtherCountry(Country.Self).Self)))]"
								parentanchor = hcenter
								autoresize = yes
								multiline = yes
								align = hcenter|nobaseline
								using = elide_fontsize_min
								minimumsize = { 180 -1 }
								max_width = 180
								margin = { 10 10 }
								using = tooltip_ne
								tooltip = "TREATY_NOT_FULFILLED_FROZEN_STATUS_TOOLTIP"
								text = "TREATY_ARTICLES_FROZEN"

								background = {
									using = entry_bg_simple_solid
								}
							}

							textbox = {
								visible = "[And(And(Not(IsDataModelEmpty(Treaty.GetOffers)), Treaty.IsFrozenFor(Country.Self)), Country.IsAtWarWith(Treaty.GetOtherCountry(Country.Self).Self))]"
								parentanchor = hcenter
								autoresize = yes
								multiline = yes
								align = hcenter|nobaseline
								using = elide_fontsize_min
								minimumsize = { 180 -1 }
								max_width = 180
								margin = { 10 10 }
								using = tooltip_ne
								tooltip = "TREATY_FROZEN_DUE_TO_WAR"
								text = "TREATY_ARTICLES_FROZEN"

								background = {
									using = entry_bg_simple_solid
								}
							}
						}

						textbox = {
							visible = "[IsDataModelEmpty(Treaty.GetOffers)]"
							size = { 220 40 }
							alpha = 0.5
							align = hcenter|nobaseline
							fonttintcolor = "[TooltipInfo.GetTintColor]"
							text = "NONE"
						}

						vertical_divider_full = {}

						### RIGHT ARTICLES
						flowcontainer = {
							direction = vertical
							datacontext = "[Treaty.GetRightCountry]"

							flowcontainer = {
								visible = "[And(Not(IsDataModelEmpty(Treaty.GetDemands)), LessThanOrEqualTo_int32(GetDataModelSize(Treaty.GetDemands), '(int32)10'))]"
								direction = vertical
								datamodel = "[Treaty.GetDemands]"
								spacing = 2
								alpha = "[TransparentIfTrue(Treaty.IsFrozenFor(Country.Self))]"

								item = {
									treaty_tooltip_article_entry = {}
								}
							}

							flowcontainer = {
								visible = "[GreaterThan_int32(GetDataModelSize(Treaty.GetDemands), '(int32)10')]"
								direction = vertical
								datamodel = "[DataModelFirst(Treaty.GetDemands, '(int32)10')]"
								spacing = 2
								alpha = "[TransparentIfTrue(Treaty.IsFrozenFor(Country.Self))]"

								item = {
									treaty_tooltip_article_entry = {}
								}
							}

							### MORE THAN 10 RIGHT ARTICLES
							widget = {
								visible = "[GreaterThan_int32(GetDataModelSize(Treaty.GetDemands), '(int32)10')]"
								size = { 220 40 }

								tooltipwidget = {
									RegularTooltip_TreatyArticlesPage = {
										blockoverride "articles_datamodel" {
											datamodel = "[DataModelSkipFirst(Treaty.GetDemands, '(int32)10')]"
										}
									}
								}

								background = {
									using = simple_frame
								}

								flowcontainer = {
									spacing = 5
									parentanchor = vcenter
									position = { 10 0 }

									### AND X MORE
									textbox = {
										parentanchor = vcenter
										autoresize = yes
										align = nobaseline
										using = elide_fontsize_min
										max_width = 200
										fonttintcolor = "[TooltipInfo.GetTintColor]"
										text = "TREATY_ARTICLE_AND_X_MORE_DEMANDS"
									}
								}
							}

							### FROZEN STATUS - RIGHT SIDE
							textbox = {
								visible = "[And(And(Not(IsDataModelEmpty(Treaty.GetDemands)), Treaty.IsFrozenFor(Country.Self)), Not(Country.IsAtWarWith(Treaty.GetOtherCountry(Country.Self).Self)))]"
								parentanchor = hcenter
								autoresize = yes
								multiline = yes
								align = hcenter|nobaseline
								using = elide_fontsize_min
								minimumsize = { 180 -1 }
								max_width = 180
								margin = { 10 10 }
								using = tooltip_ne
								tooltip = "TREATY_NOT_FULFILLED_FROZEN_STATUS_TOOLTIP"
								text = "TREATY_ARTICLES_FROZEN"

								background = {
									using = entry_bg_simple_solid
								}
							}

							textbox = {
								visible = "[And(And(Not(IsDataModelEmpty(Treaty.GetDemands)), Treaty.IsFrozenFor(Country.Self)), Country.IsAtWarWith(Treaty.GetOtherCountry(Country.Self).Self))]"
								parentanchor = hcenter
								autoresize = yes
								multiline = yes
								align = hcenter|nobaseline
								using = elide_fontsize_min
								minimumsize = { 180 -1 }
								max_width = 180
								margin = { 10 10 }
								using = tooltip_ne
								tooltip = "TREATY_FROZEN_DUE_TO_WAR"
								text = "TREATY_ARTICLES_FROZEN"

								background = {
									using = entry_bg_simple_solid
								}
							}
						}

						textbox = {
							visible = "[IsDataModelEmpty(Treaty.GetDemands)]"
							size = { 220 40 }
							alpha = 0.5
							align = hcenter|nobaseline
							fonttintcolor = "[TooltipInfo.GetTintColor]"
							text = "NONE"
						}
					}
				}
			}
		}
	}

	type RegularTooltip_TreatyArticlesPage = RegularTooltip {
		blockoverride "tooltip_content_after" {
			dynamicgridbox = {
				datamodel_wrap = 1
				flipdirection = yes

				block "articles_datamodel" {
					datamodel = "[Treaty.GetDemands]"
