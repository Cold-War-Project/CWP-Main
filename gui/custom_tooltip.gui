	type RegularTooltip_TreatyProposal = RegularTooltip {
		blockoverride "tooltip_content_after" {
			custom_tooltip_textbox = {
				text = "TREATY_PROPOSAL_TOOLTIP_HEADER"
			}

			custom_tooltip_textbox = {
				visible = "[Not(StringIsEmpty(GetDesc(TreatyDraft.SendProposal)))]"
				text = "[GetDesc(TreatyDraft.SendProposal)]"
			}

			tooltip_divider = {}

			custom_tooltip_textbox = {
				visible = "[TreatyDraft.WillThreatenNavalHostilities]"
				max_width = @tooltip_fixed_width
				text = "[TreatyDraft.GetThreatenNavalHostilitiesInfamyWarning]"
			}

			custom_tooltip_textbox = {
				max_width = @tooltip_fixed_width
				text = "TREATY_PROPOSAL_TOOLTIP_IF_ACCEPTED_TITLE"
			}

			custom_tooltip_textbox = {
				max_width = @tooltip_fixed_width
				margin_left = 10
				text = "TREATY_PROPOSAL_TOOLTIP_COST"
			}

			custom_tooltip_textbox = {
				visible = "[Not(StringIsEmpty(TreatyDraft.GetRelationsEffectDesc))]"
				max_width = @tooltip_fixed_width
				margin_left = 10
				text = "TREATY_PROPOSAL_TOOLTIP_RELATION_EFFECT"
			}

			custom_tooltip_textbox = {
				visible = "[Not(StringIsEmpty(TreatyDraft.GetImmediateEffectsDesc))]"
				max_width = @tooltip_fixed_width
				margin_left = 10
				text = "[TreatyDraft.GetImmediateEffectsDesc]"
			}

			custom_tooltip_textbox = {
				visible = "[GreaterThan_int32(TreatyDraft.GetBindingDays, '(int32)0')]"
				max_width = @tooltip_fixed_width
				margin_left = 10
				text = "TREATY_PROPOSAL_TOOLTIP_BINDING_PERIOD"
			}

			custom_tooltip_newline = {
				visible = "[TreatyDraft.GetRightCountry.IsAI]"
			}

			flowcontainer = {
				visible = "[TreatyDraft.GetRightCountry.IsAI]"
				direction = vertical

				container = {
					minimumsize = { @tooltip_fixed_width 50 }

					background = {
						using = light_bg
						using = frame_small_mask
						alpha = 0.4
						margin = { 5 0 }
					}

					background = {
						using = frame_small
						margin = { 5 0 }
					}

					### GREEN BACKGROUND
					background = {
						visible = "[GreaterThanOrEqualTo_int32(TreatyDraft.GetAcceptance(TreatyDraft.GetRightCountry.Self), '(int32)1')]"
						using = fade_left_colored_green
						using = frame_small_mask
						margin = { 5 0 }
					}

					### RED BACKGROUND
					background = {
						visible = "[LessThan_int32(TreatyDraft.GetAcceptance(TreatyDraft.GetRightCountry.Self), '(int32)1')]"
						using = fade_left_colored_red
						using = frame_small_mask
						margin = { 5 0 }
					}

					flowcontainer = {
						visible = "[TreatyDraft.GetRightCountry.IsAI]"
						parentanchor = vcenter
						position = { 10 0 }
						spacing = 5
						margin = { 0 10 }

						### ACCEPTANCE ICON
						widget = {
							parentanchor = vcenter
							size = { 30 30 }

							treaty_draft_acceptance_icon = {
								blockoverride "acceptance_value" {}
							}
						}

						textbox = {
							parentanchor = vcenter
							align = nobaseline
							autoresize = yes
							using = elide_fontsize_min
							multiline = yes
							max_width = 450
							raw_text = "#v [TreatyDraft.GetAcceptance(TreatyDraft.GetRightCountry.Self)|+=]#! [TreatyDraft.GetAcceptanceStatus(TreatyDraft.GetRightCountry.Self)]"
						}
					}
				}

				custom_tooltip_2_columns = {
					blockoverride "left_column" {
						custom_tooltip_textbox_column_width = {
							visible = "[Not(StringIsEmpty(TreatyDraft.GetPositiveAcceptanceBreakdown(TreatyDraft.GetRightCountry.Self)))]"
							text = "TREATY_DRAFT_POSITIVE_ACCEPTANCE_BREAKDOWN"
						}

						custom_tooltip_textbox_column_width = {
							visible = "[StringIsEmpty(TreatyDraft.GetPositiveAcceptanceBreakdown(TreatyDraft.GetRightCountry.Self))]"
							using = empty_state_text_properties
							text = "TREATY_DRAFT_NO_POSITIVE_ACCEPTANCE"
						}

						background = {
							visible = "[Not(StringIsEmpty(TreatyDraft.GetPositiveAcceptanceBreakdown(TreatyDraft.GetRightCountry.Self)))]"
							using = fade_right_colored_green
							margin = { 10 10 }

							modify_texture = {
				 				spriteType = Corneredstretched
				 				spriteborder = { 0 0 }
				 				blend_mode = alphamultiply
				 				texture = "gfx/interface/masks/fade_horizontal_less_left.dds"
				 			}

				 			modify_texture = {
				 				spriteType = Corneredstretched
				 				spriteborder = { 0 0 }
				 				blend_mode = alphamultiply
				 				texture = "gfx/interface/masks/fade_vertical_center.dds"
				 			}
						}
					}

					blockoverride "right_column" {
						custom_tooltip_textbox_column_width = {
							visible = "[Not(StringIsEmpty(TreatyDraft.GetNegativeAcceptanceBreakdown(TreatyDraft.GetRightCountry.Self)))]"
							text = "TREATY_DRAFT_NEGATIVE_ACCEPTANCE_BREAKDOWN"
						}

						background = {
							visible = "[Not(StringIsEmpty(TreatyDraft.GetNegativeAcceptanceBreakdown(TreatyDraft.GetRightCountry.Self)))]"
							using = fade_right_colored_red
							margin = { 10 10 }

							modify_texture = {
				 				spriteType = Corneredstretched
				 				spriteborder = { 0 0 }
				 				blend_mode = alphamultiply
				 				texture = "gfx/interface/masks/fade_horizontal_less_left.dds"
				 			}

				 			modify_texture = {
				 				spriteType = Corneredstretched
				 				spriteborder = { 0 0 }
				 				blend_mode = alphamultiply
				 				texture = "gfx/interface/masks/fade_vertical_center.dds"
				 			}
						}

						custom_tooltip_textbox_column_width = {
							visible = "[StringIsEmpty(TreatyDraft.GetNegativeAcceptanceBreakdown(TreatyDraft.GetRightCountry.Self))]"
							using = empty_state_text_properties
							text = "TREATY_DRAFT_NO_NEGATIVE_ACCEPTANCE"
						}
					}
				}
			}
		}
	}

