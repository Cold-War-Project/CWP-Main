	type RegularTooltip_MarketWorldMarketExportsTo = RegularTooltip {
		blockoverride "tooltip_content_after" {

			flowcontainer = {
				direction = vertical
				margin_top = 10

				custom_tooltip_textbox = {
					text = "EXPORTING_TO_TITLE"
				}

				flowcontainer = {
					datamodel = "[Goods.GetImportersFromMarket]"
					margin_top = 5
					wrap_count = 4

					item = {
						flowcontainer = {
							margin = { 8 6 }
							spacing = 7

							background = {
								using = entry_bg_simple
							}

							small_market_flag = {
								parentanchor = vcenter
								blockoverride "small_market_flag_tooltip" {}
							}

							custom_tooltip_textbox = {
								text = "[Market.GetImportedAmountFromMarket(Goods.GetMarket, Goods.Self)|v1]"
								autoresize = yes
								align = nobaseline
								parentanchor = vcenter
								minimumsize = { 50 -1 }
								maximumsize = { 50 -1 }
								using = elide_fontsize_min
								multiline = no
							}

							tooltipwidget = {
								FancyTooltip_Market = {
									blockoverride "tooltip_content_before" {
										custom_tooltip_textbox = {
											text = "MARKET_TRADE_VALUES"
										}
									}
								}
							}
						}
					}
				}

				custom_tooltip_textbox = {
					visible = "[GreaterThan_CFixedPoint(Goods.GetWorldMarketAdditionalExportsFromMarket,'(CFixedPoint)0')]"
