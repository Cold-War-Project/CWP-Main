	type FancyTooltip_Company = FancyTooltipWidgetType {
		blockoverride "text" {} # Fully replaced by everything in tooltip_content_after

		blockoverride "icon_texture" {
			texture = "[Company.GetCompanyType.GetIcon]"
		}

		blockoverride "icon_background_texture" {}

		blockoverride "icon_frame" {}

		blockoverride "name" {
			text = "[Company.GetNameNoFormatting]"
		}

		blockoverride "type" {
			text = "[concept_company]"
		}

		blockoverride "go_to_button" {
			button_icon_goto = {
				size = { 30 30 }
				input_action = "go_to_details"
				using = tooltip_ne
				enabled = "[Company.GetBuilding.IsValid]"
				onclick = "[InformationPanelBar.OpenCompanyPanel(Company.Self)]"
				tooltip = "GO_TO_BUTTON_COMPANY"
			}
		}

		blockoverride "tooltip_content_after" {
			datacontext = "[Company.GetCountry]"

			### EXECUTIVE
			flowcontainer = {
				spacing = 7
				datacontext = "[Company.GetExecutive]"

				custom_tooltip_textbox = {
					parentanchor = vcenter
					raw_text = "[concept_executive]:"
				}

				character_portrait_mini = {}

				custom_tooltip_textbox = {
					parentanchor = vcenter
					text = "[Character.GetFullName]"
				}

				button_icon_goto = {
					parentanchor = vcenter
					size = { 21 21 }
					using = tooltip_above
					tooltip = "GO_TO_BUTTON_CHARACTER"
					onclick = "[InformationPanelBar.OpenCharacterPanel(Character.AccessSelf)]"
				}
			}

			flowcontainer = {
				direction = vertical
				using = tooltip_segment_margin
				max_width = @tooltip_fixed_width
				min_width = @tooltip_fixed_width

				custom_tooltip_textbox = {
					text = "DATA_COMPANY_NAME_FORMAT_TOOLTIP"
				}

				flowcontainer = {
					spacing = 5
					datamodel = "[Company.GetBuildingTypes]"

					item = {
						company_building_item = {}
					}
				}
			}

			flowcontainer = {
				direction = vertical
				using = tooltip_segment_margin
				using = tooltip_segment_background
				max_width = @tooltip_fixed_width
				min_width = @tooltip_fixed_width

				### HQ
				flowcontainer = {
					spacing = 7
					datacontext = "[Company.GetBuilding]"

					custom_tooltip_textbox = {
						raw_text = "[concept_company_hq]:"
					}

					custom_tooltip_textbox = {
						raw_text = "[Building.GetState.GetCountry.GetFlagTextIcon] [Building.GetState.GetName]"
					}

					button_icon_goto = {
						size = { 21 21 }
						using = tooltip_above
						tooltip = "GO_TO_BUTTON_COMPANY_HQ"
						onclick = "[InformationPanelBar.OpenBuildingDetailsPanel(Building.AccessSelf)]"
					}
				}

				custom_tooltip_textbox = {
					datacontext = "[Company.GetCompanyType]"
					text = "DATA_COMPANY_TYPE_CATEGORY"
				}

				flowcontainer = {
					spacing = 7
					visible = "[Not(IsDataModelEmpty(Company.GetPrestigeGoods))]"

					custom_tooltip_textbox = {
						raw_text = "[concept_prestige_good]:"
						parentanchor = vcenter
					}

					dynamicgridbox = {
						flipdirection = yes
						datamodel_wrap = 6
						datamodel = "[Company.GetPrestigeGoods]"
						parentanchor = vcenter

						item = {
							flowcontainer = {
								spacing = 2

								tooltipwidget = {
									FancyTooltip_Goods = {}
								}

								custom_tooltip_textbox = {
									text = "[Goods.GetName]"
									parentanchor = vcenter
								}
							}
						}
					}
				}
			}

			flowcontainer = {
				direction = vertical
				using = tooltip_segment_margin

				custom_tooltip_textbox = {
					text = "DATA_COMPANY_NAME_FORMAT_TOOLTIP_PT2"
				}
			}

			flowcontainer = {
				direction = vertical
				using = tooltip_segment_margin
				using = tooltip_segment_background
				max_width = @tooltip_fixed_width
				min_width = @tooltip_fixed_width

				prosperity_widget = {}
			}

			flowcontainer = {
				visible = "[HasDlcFeature('mp1_charter_companies')]"
				direction = vertical
				using = tooltip_segment_margin
				max_width = @tooltip_fixed_width
				min_width = @tooltip_fixed_width

				custom_tooltip_textbox = {
					text = "COMPANY_CHARTERS_TITLE"
				}

				flowcontainer = {
					datamodel = "[GetCompanyCharterTypes]"
					spacing = 2

					item = {
						flowcontainer = {
							datamodel = "[Company.GetActiveCharters(CompanyCharterType.Self)]"
							spacing = 2
							margin_top = 5

							item = {
								icon = {
									size = { 40 40 }
									texture = "[CompanyCharter.GetType.GetIcon]"

									tooltipwidget = {
										FancyTooltip_CompanyCharter = {}
									}
								}
							}
						}
					}
				}

				custom_tooltip_textbox = {
					visible = "[Not(Or(Or(Or(Or(Company.HasAnyIndustryCharterActive, Company.HasAnyColonizationCharterActive), Company.HasAnyInvestmentCharterActive), Company.HasAnyMonopolyCharterActive), Company.HasAnyTradeCharterActive))]"
					using = empty_state_text_properties
					text = "NONE"
				}
			}

			flowcontainer = {
				direction = vertical
				using = tooltip_segment_margin
				using = tooltip_segment_background
				max_width = @tooltip_fixed_width
				min_width = @tooltip_fixed_width

				custom_tooltip_textbox = {
					text = "COMPANY_ESTABLISHED"
				}
			}
		}
	}

