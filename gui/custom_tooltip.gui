	type FancyTooltip_ShipGroup = FancyTooltipWidgetType {
		blockoverride "text" {} # Fully replaced by everything in tooltip_content_after

		blockoverride "icon_texture" {
			texture = "[ShipGroup.GetIcon]"
		}

		blockoverride "name" {
			text = "[ShipGroup.GetNameNoFormatting]"
		}

		blockoverride "type" {
			text = "[concept_ship_group]"
		}

		blockoverride "icon_background_texture" {}

		blockoverride "icon_frame" {}

		blockoverride "tooltip_content_after" {
			custom_tooltip_textbox = {
				text = "SHIP_GROUP_TYPES_HEADER"
			}

			flowcontainer = {
				margin_top = 2
				spacing = 2
				wrap_count = 2
				datamodel = "[ShipGroup.GetShipTypes]"

				item = {
					ship_silhouette_for_tooltips = {
						blockoverride "ship_type_name" {
							text = "[ShipType.GetNameNoFormatting]"
						}
					}
				}
			}

			tooltip_divider = {}

			custom_tooltip_textbox = {
				default_format = "#lore"
				max_width = 382
				text = "[ShipGroup.GetDescription]"
			}
		}
	}

	type FancyTooltip_ShipType = FancyTooltipWidgetType {
		blockoverride "text" {} # Fully replaced by everything in tooltip_content_after

		blockoverride "name" {
			text = "[ShipType.GetNameNoFormatting]"
