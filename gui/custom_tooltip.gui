	type FancyTooltip_Strait = FancyTooltipWidgetType {
		blockoverride "text" {} # Fully replaced by everything in tooltip_content_after

		blockoverride "name" {
			text = "[Strait.GetNameNoFormatting]"
		}

		blockoverride "type" {
			text = "TOOLTIP_TYPE_STRAIT"
		}

		blockoverride "go_to_button_visibility" {
			visible = yes
		}

		blockoverride "go_to_button_properties" {
			onclick = "[InformationPanelBar.OpenStraitPanel(Strait.AccessSelf)]"
		}

		blockoverride "icon_texture" {
			texture = "gfx/interface/icons/state_trait_icons/straits.dds"
		}

		blockoverride "tooltip_content_after" {
			custom_tooltip_textbox_fixed_width = {
				visible = "[Not( IsObserver )]"

				text = "STRAIT_ACCESS_PLAYER"
			}

			custom_tooltip_textbox_fixed_width = {
				visible = "[Or(Strait.GetFirstState.GetController.IsLocalPlayer, Strait.GetSecondState.GetController.IsLocalPlayer)]"
				text = "STRAIT_TOLLS_PLAYER"
			}

			custom_tooltip_newline = {}

			custom_tooltip_2_columns = {
				blockoverride "left_column" {


					flowcontainer = {
						direction = vertical
						datacontext = "[Strait.GetFirstState]"
						datacontext = "[Strait.GetFirstController]"

						custom_tooltip_textbox_column_width = {
							raw_text = "#b [State.GetController.GetFlagTextIcon] [State.GetName]#!"
						}

						flowcontainer = {
				    		visible = "[State.GetBuilding('building_naval_fortification').IsValid]"
				    		parentanchor = hcenter

							icon = {
								size = { 60 60 }
								parentanchor = vcenter
								texture = "[State.GetBuilding('building_naval_fortification').GetIcon]"
							}

							flowcontainer = {
								direction = vertical
								spacing = 2

								button = {
									size = { 180 30 }
									using = default_button

									textbox = {
										parentanchor = vcenter
										margin_left = 10
										autoresize = yes
										align = nobaseline
										max_width = 175
										text = "[State.GetBuilding('building_naval_fortification').GetNameNoFormatting]"
									}
								}

								building_controls = {
									datacontext = "[State.GetBuilding('building_naval_fortification')]"
									parentanchor = right
								}
							}
						}

						flowcontainer = {
				    		visible = "[Not(State.GetBuilding('building_naval_fortification').IsValid)]"
				    		parentanchor = hcenter
				    		tooltip = "NO_NAVAL_FORTIFICATION_TOOLTIP"

							icon = {
								size = { 60 60 }
								parentanchor = vcenter
								alpha = 0.3
								texture = "[GetBuildingType('building_naval_fortification').GetIcon]"
							}

							flowcontainer = {
								direction = vertical
								spacing = 2

								button = {
									size = { 180 30 }
									using = default_button
									enabled = no

									textbox = {
										parentanchor = vcenter
										margin_left = 10
										autoresize = yes
										align = nobaseline
										max_width = 175
										text = "[GetBuildingType('building_naval_fortification').GetNameNoFormatting]"
									}
								}

								building_controls = {
									datacontext = "[State.GetBuilding('building_naval_fortification')]"
									parentanchor = right
								}
							}
						}

						widget = {
							size = { 5 5 }
						}

						flowcontainer = {
							alpha = "[TransparentIfTrue(IsZero(State.GetBuilding('building_naval_fortification').GetExpansionLevel))]"
							direction = vertical

