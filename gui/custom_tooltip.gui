	type FancyTooltip_ShipTemplate = FancyTooltipWidgetType {
		blockoverride "text" {} # Fully replaced by everything in tooltip_content_after
		datacontext = "[ShipTemplate.GetType]"

		blockoverride "name" {
			text = "[ShipTemplate.GetNameNoFormatting]"
		}

		blockoverride "type" {
			text = "SHIP_TEMPLATE_TOOLTIP_TYPES"
		}

		blockoverride "icon_texture" {
			texture = "gfx/interface/icons/generic_icons/flotillas.dds"
		}

		blockoverride "icon_background_texture" {}

		blockoverride "icon_frame" {}

		blockoverride "tooltip_content_after" {

			background = {
				texture = "gfx/interface/illustrations/war/defeat_navy.dds"
				fittype = centercrop
				alpha = 0.4
			}

			custom_tooltip_2_columns = {
				blockoverride "left_column" {
					datamodel = "[ShipTemplate.GetModifications]"

					item = {
						flowcontainer = {
							spacing = 2

							icon = {
								size = { 24 24 }
								texture = "[ShipModificationType.GetIcon]"
							}

							custom_tooltip_textbox = {
								parentanchor = vcenter
								max_width = 220
								text = "[ShipModificationType.GetName]"
							}
						}
					}
				}

				blockoverride "right_column" {

					textbox = {
						visible = "[IsDataModelEmpty(ShipTemplate.GetUtilityModifications)]"
						autoresize = yes
						align = nobaseline
						max_width = @tooltip_fixed_column_width
						using = elide_fontsize_min
						using = empty_state_text_properties
						text = "NO_UTILITY_MODIFICATIONS"
					}

					flowcontainer = {
						visible = "[Not(IsDataModelEmpty(ShipTemplate.GetUtilityModifications))]"
						direction = vertical
						datamodel = "[ShipTemplate.GetUtilityModifications]"

						item = {
							flowcontainer = {
								spacing = 2

								icon = {
									size = { 24 24 }
									texture = "[ShipModificationType.GetIcon]"
								}

								custom_tooltip_textbox = {
									parentanchor = vcenter
									max_width = 220
									text = "[ShipModificationType.GetName]"
								}
							}
						}
					}
				}
			}

			### Main Stats
			ship_template_stats_list = {}

			flowcontainer = {
				wrap_count = 2
				datacontext = "[ShipType.GetModifier]"

				ship_modifier_battle_against_ship_type_arsenal_ship_accuracy_add = {
					visible = "[NotZero_CFixedPoint(Modifier.GetValueFor('ship_battle_against_ship_type_arsenal_ship_accuracy_add'))]"
				}

				ship_modifier_battle_against_ship_type_arsenal_ship_accuracy_mult = {
					visible = "[NotZero_CFixedPoint(Modifier.GetValueFor('ship_battle_against_ship_type_arsenal_ship_accuracy_mult'))]"
				}

