	type RegularTooltip_LawEnactment = RegularTooltip {
		blockoverride "tooltip_content_after" {

			custom_tooltip_textbox = {
				text = "TOOLTIP_ENACT_LAW_NAME"
			}

			custom_tooltip_textbox = {
				text = "TOOLTIP_ENACT_LAW_CURRENT_LAW_NAME"
			}

			custom_tooltip_textbox = {
				visible = "[Not(StringIsEmpty(Law.CannotEnactDesc))]"
				text = "[Law.CannotEnactDesc]"
			}

			tooltip_divider = {}

			custom_tooltip_textbox = {
				text = "ENACT_LAW_CHANCES_HEADER"
			}

			### ENACTMENT CHANCES
			widget = {
				size = { @tooltip_max_width 60 }

				vbox = {
					layoutpolicy_horizontal = preferred
					layoutpolicy_vertical = preferred
					margin = { 15 5 }

					background = {
						using = entry_bg_simple
					}

					vbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = preferred
						spacing = 5

						hbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = preferred
							spacing = 5

							custom_tooltip_textbox = {
								alpha = "[TransparentIfFalse(GreaterThan_CFixedPoint(Law.GetCheckpointSuccessChance, '(CFixedPoint)0'))]"
								layoutpolicy_horizontal = expanding
								size = { 0 14 }
								align = left|nobaseline
								elide = right
								fontsize_min = 14
								text = "OUTCOME_SUCCESS"
							}

							custom_tooltip_textbox = {
								layoutpolicy_horizontal = expanding
								alpha = "[TransparentIfFalse(GreaterThan_CFixedPoint(Law.GetCheckpointAdvanceChance, '(CFixedPoint)0'))]"
								size = { 0 14 }
								align = left|nobaseline
								elide = right
								fontsize_min = 14
								text = "OUTCOME_ADVANCE"
							}
						}

						hbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = preferred
							spacing = 5

							custom_tooltip_textbox = {
								layoutpolicy_horizontal = expanding
								alpha = "[TransparentIfFalse(GreaterThan_CFixedPoint(Law.GetCheckpointDebateChance, '(CFixedPoint)0'))]"
								size = { 0 14 }
								align = left|nobaseline
								elide = right
								fontsize_min = 14
								text = "OUTCOME_DEBATE"
							}

							custom_tooltip_textbox = {
								layoutpolicy_horizontal = expanding
								alpha = "[TransparentIfFalse(GreaterThan_CFixedPoint(Law.GetCheckpointStallChance, '(CFixedPoint)0'))]"
								size = { 0 14 }
								align = left|nobaseline
								elide = right
								fontsize_min = 14
								text = "OUTCOME_STALL"
							}
						}
					}
				}
			}

			custom_tooltip_textbox_with_empty_line = {
				text = "[Law.GetReplacedLawEffect]"
			}

			custom_tooltip_textbox_with_empty_line = {
				text = "[Law.PredictLegitimacyChangeToEnactDesc]"
			}

			custom_tooltip_textbox = {
				default_format = "#title"
				text = "TEMPORARY_APPROVAL_FROM_LAW_CHANGE_TITLE"
			}

			interest_groups_with_approval_changes = {}

			custom_tooltip_newline = {
				visible = "[Not(IsDataModelEmpty(Law.GetMarginalizedIGsWithApprovalChanges))]"
			}

			custom_tooltip_textbox = {
				visible = "[Not(IsDataModelEmpty(Law.GetMarginalizedIGsWithApprovalChanges))]"
				default_format = "#title"
				raw_text = "[concept_marginalized]:"
			}

			interest_groups_with_approval_changes = {
				visible = "[Not(IsDataModelEmpty(Law.GetMarginalizedIGsWithApprovalChanges))]"
				alpha = 0.5

				blockoverride "datamodel" {
					datamodel = "[Law.GetMarginalizedIGsWithApprovalChanges]"
				}

				blockoverride "radicalize_animation" {}
			}

			custom_tooltip_newline = {
				visible = "[Or(Not(StringIsEmpty(Law.PredictMovementLoyalistsFromEnactmentDesc)), Not(IsDataModelEmpty(Law.GetAffectedMovementsFromStartEnact)))]"
			}

			custom_tooltip_textbox = {
				text = "[Law.PredictMovementLoyalistsFromEnactmentDesc]"
			}

			flowcontainer = {
				visible = "[Not(IsDataModelEmpty(Law.GetAffectedMovementsFromStartEnact))]"
				direction = vertical

				custom_tooltip_newline = {
					visible = "[Not(StringIsEmpty(Law.PredictMovementLoyalistsFromEnactmentDesc))]"
				}

				custom_tooltip_textbox = {
					text = "LAW_ENACTMENT_EFFECT_ON_MOVEMENT_ACTIVISM_HEADER"
				}

				flowcontainer = {
					minimumsize = { 520 -1 }
					direction = vertical
					margin = { 10 0 }
					datamodel = "[DataModelFirst(Law.GetAffectedMovementsFromStartEnact, '(int32)5')]"

					background = {
						using = entry_bg_simple
					}

					item = {
						movement_affected_by_law_enactment_tooltip_item = {}
					}
				}

				### If more than 5 affected Movements, here are the additional
				custom_tooltip_textbox = {
					visible = "[GreaterThan_int32(GetDataModelSize(Law.GetAffectedMovementsFromStartEnact), '(int32)5')]"
					default_format = "#tooltippable"
					text = "LAW_ENACTMENT_AFFECTED_MOVEMENTS_ADDITIONAL"

					tooltipwidget = {
						RegularTooltip = {
							blockoverride "tooltip_content" {
								flowcontainer = {
									parentanchor = hcenter
									minimumsize = { 520 -1 }
									direction = vertical
									datamodel = "[DataModelSkipFirst(Law.GetAffectedMovementsFromStartEnact, '(int32)5')]"

									item = {
										movement_affected_by_law_enactment_tooltip_item = {
											blockoverride "bottom_divider_visiblity" {
												visible = "[NotEqualTo_int32(Subtract_int32(GetDataModelSize(DataModelSkipFirst(Law.GetAffectedMovementsFromStartEnact, '(int32)5')), '(int32)1'), PdxGuiWidget.AccessParent.GetIndexInDataModel)]"
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}

