	type naval_mission_marker_tooltip_fleet = flowcontainer {
		margin_left = 10
		spacing = 5

		flowcontainer = {
			visible = "[MilitaryFormation.IsTraveling]"
			parentanchor = vcenter
			spacing = 3

			icon = {
				parentanchor = vcenter
				size = { 24 24 }
				texture = "gfx/interface/icons/generic_icons/expeditionary_force.dds"
			}

			custom_tooltip_textbox = {
				visible = "[GreaterThan_int32( MilitaryFormation.GetTravelDaysLeft, '(int32)0' )]"
				parentanchor = vcenter
				autoresize = yes
				text = "NAVAL_MISSION_MARKER_TRAVEL_DAYS"
			}

			custom_tooltip_textbox = {
				visible = "[EqualTo_int32( MilitaryFormation.GetTravelDaysLeft, '(int32)0' )]"
				parentanchor = vcenter
				autoresize = yes
				text = "NAVAL_MISSION_MARKER_TRAVEL_SOON"
			}
		}

		flowcontainer = {
			parentanchor = vcenter
			alpha = "[TransparentIfTrue(MilitaryFormation.IsTraveling)]"

			custom_tooltip_textbox = {
				visible = "[Not(MilitaryFormation.IsTraveling)]"
				parentanchor = vcenter
				autoresize = yes
				text = "NAVAL_MISSION_MARKER_FLEET_EFFICIENCY"
			}

			widget = {
				size = { 10 5 }
			}

			custom_tooltip_textbox = {
				parentanchor = vcenter
				autoresize = yes
				raw_text = "@ships! [MilitaryFormation.GetNumShips|v]"
			}

			icon = {
				parentanchor = vcenter
				size = { 24 24 }
				texture = "[MilitaryFormation.GetFlag]"
				color = "[MilitaryFormation.GetFlagColor]"
			}

			custom_tooltip_textbox = {
				parentanchor = vcenter
				autoresize = yes
				text = "[MilitaryFormation.GetNameNoIcon]"
			}
		}
	}

