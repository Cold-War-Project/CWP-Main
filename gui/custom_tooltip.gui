	type FancyTooltip_Building = FancyTooltipWidgetType {
		blockoverride "text" {} # Fully replaced by everything in tooltip_content_after

		blockoverride "icon_texture" {
			texture = "[Building.GetIcon]"
		}

		blockoverride "name" {
			text = "TOOLTIP_BUILDING_HEADER"
		}

		blockoverride "type" {
			text = "TOOLTIP_TYPE_BUILDING"
		}

		blockoverride "tooltip_content_after" {
			datacontext = "[Building.AccessState]"

			# Custom tooltip layout for constructed buildings
			flowcontainer = {
				visible = "[Building.IsValid]"
				direction = vertical

				flowcontainer = {
					direction = vertical
					using = tooltip_segment_margin

					custom_tooltip_2_columns = {
						blockoverride "bg" { } #no bg

						blockoverride "left_column" {
							spacing = 8

							flowcontainer = {
								spacing = 10

								building_level_controls = {
									blockoverride "controller_size" {
										size = { @tooltip_fixed_column_width_minus_40 35 }
									}
								}

								icon = {
									visible = "[Building.IsAutoDownsizing]"
									tooltip = "[Building.GetAutoDownsizeTooltip]"
									parentanchor = vcenter
									size = { 30 30 }
									texture = "gfx/interface/production_methods/auto_downsize.dds"
								}
							}

							building_progressbars = {
								blockoverride "progressbar_size" {
									size = {  @tooltip_fixed_column_width 26 }
								}

							}
						}

						blockoverride "right_column" {
							building_productivity_mini_chart = {
								blockoverride "graph_size" {
									size = { @tooltip_fixed_column_width_minus_16 60 }
								}
							}
						}
					}

					custom_tooltip_2_columns = {

						blockoverride "left_column" {
							building_average_wage_label = {
								using = tooltip_font
							}
						}

						blockoverride "right_column" {
							building_rank_label = {
								using = tooltip_font
							}
						}
					}
				}

				widget = {
					size = { 500 40 }

					hbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						spacing = 5
						margin_bottom = 7

						block "action_buttons" {
							building_auto_expand_toggle = {}

							building_subsidize_toggle = {}

							building_privatize_toggle = {}

							building_country_monopoly_icon = {
								visible = "[BuildingType.HasCountryMonopoly]"
								datacontext = "[Building.GetBuildingType]"
							}

							building_nationalize_button = {}
						}

						hbox = {
							layoutpolicy_horizontal = preferred
							layoutpolicy_vertical = expanding
							spacing = 10
							margin_right = 5

							block "company_owned_button" {
								button = {
									visible = "[Building.IsBuildingType('building_company_headquarter')]"
									layoutpolicy_horizontal = expanding
									size = { 0 30 }
									datacontext = "[Building.GetCompany]"
									using = default_button
									onclick = "[InformationPanelBar.OpenCompanyPanel(Company.Self)]"
									tooltip = "GO_TO_BUTTON_COMPANY"
									using = tooltip_ne

									textbox = {
										size = { 100% 100% }
										align = hcenter|nobaseline
										using = elide_fontsize_min
										margin = { 10 0 }
										text = "BUILDING_OWNED_BY_COMPANY"
									}
								}
							}

							expand = {}

							### STATE TRAITS
							hbox = {
								visible = "[Not(IsDataModelEmpty(State.AccessStateRegion.AccessTraits))]"
								datamodel = "[State.AccessStateRegion.AccessTraits]"

								item = {
									icon = {
										size = { 30 30 }
										tooltip = "TOOLTIP_STATE_TRAIT"
										using = tooltip_ne
										onmousehierarchyenter = "[AccessHighlightManager.HighlightStateTrait(StateTrait.Self)]"
										onmousehierarchyleave = "[AccessHighlightManager.RemoveHighlight]"
										alwaystransparent = no
										texture = "[StateTrait.GetTexture]"
									}
								}
							}

							### TIMED MODIFIERS
							hbox = {
								visible = "[Not(IsDataModelEmpty(Building.GetTimedModifiers))]"
								margin = { 5 0 }
								datamodel = "[Building.GetTimedModifiers]"
								spacing = 5

								item = {
									icon = {
										tooltip = "[TimedModifier.GetTooltip]"
										texture = "[TimedModifier.GetIcon]"
										size = { 30 30 }
									}
								}
							}

							button_icon_round = {
								size = { 30 30 }
								onclick = "[RightClickMenuManager.ToggleBuildingActions(Building.AccessSelf, PdxGuiWidget.AccessSelf)]"
								enabled = "[ObjectsEqual(Building.GetState.GetOwner.Self, GetPlayer.Self)]"
								tooltip = "SHOW_BUILDING_ACTIONS"
								using = tooltip_ne

								blockoverride "icon" {
									texture = "gfx/interface/buttons/button_icons/menu.dds"
								}

								blockoverride "icon_size" {
									size = { 80% 80% }
								}
							}
						}
					}
				}

				### PROCESS
				flowcontainer = {
					direction = vertical
					using = tooltip_segment_background
					using = tooltip_segment_margin

					custom_tooltip_textbox = {

						text = "PROCESS_TOOLTIP_HEADER"
					}

					building_process_breakdown = {
						min_width =  @tooltip_fixed_width
					}
				}

				flowcontainer = {
					direction = vertical

					using = tooltip_segment_margin

					custom_tooltip_textbox = {
						raw_text = "[concept_workforce]:"
					}

					flowcontainer = {
						datacontext = "[Building.AccessPopsList]"
						datamodel = "[PopList.GetItems]"
						visible = "[And(Building.IsActive, Not(IsDataModelEmpty(PopList.GetItems)))]"

						spacing = 20

						item = {
							flowcontainer = {
								tooltip = "[PopListItem.GetEmploymentDesc]"
								spacing = 5

								icon = {
									size = { 20 20 }
									texture = "[PopListItem.GetPopType.GetTexture]"
									parentanchor = vcenter
									tooltipwidget = {
										FancyTooltip_PopType = {
											datacontext = "[PopListItem.GetPopType]"
										}
									}
								}

								custom_tooltip_textbox = {
									raw_text = "[PopListItem.GetWorkingAdultsPopSize|Dv]"
									parentanchor = vcenter
									max_width = 70
								}
							}
						}
					}
				}

				world_market_access_info = {
					datacontext = "[Building.GetState]"
					visible = "[ObjectsEqual(Building.GetBuildingType, GetBuildingType('building_trade_center').Self)]"
					using = tooltip_segment_background
				}

				flowcontainer = {
					visible = "[ObjectsEqual(Building.GetBuildingType, GetBuildingType('building_trade_center').Self)]"
					min_width =  @tooltip_fixed_width
					direction = vertical

					using = tooltip_segment_margin
					using = tooltip_segment_background
					margin_top = 0

					flowcontainer = {
						visible = "[ObjectsEqual(Building.GetBuildingType, GetBuildingType('building_trade_center').Self)]"
						direction = vertical

						flowcontainer = {
							spacing = 10

							icon = {
								texture = "gfx/interface/icons/trade_icons/imports.dds"
								size = { 23 23 }
							}

							vertical_divider = {}

							overlappingitembox = {
								size = { 450 23 }

								datamodel = "[DataModelFirst(Building.AccessState.GetImports, '(int32)7')]"

								item = {
									flowcontainer = {
										small_goods_button = {
											blockoverride "tooltip" {
												tooltip = "[Goods.GetStateImportsDesc]"
											}
										}
										textbox = {
											raw_text = "[Building.GetState.GetImportedAmount(Goods.Self)|v0D]"
											autoresize = yes
											align = nobaseline
											margin_left = 3
											margin_right = 5
											minimumsize = { 40 -1 }
										}
									}
								}
							}
						}

						flowcontainer = {
							spacing = 10

							icon = {
								texture = "gfx/interface/icons/trade_icons/exports.dds"
								size = { 23 23 }
							}

							vertical_divider = {}

							overlappingitembox = {
								block "trade_center_extra_info_size" {
									size = { 450 23 }
								}

								datamodel = "[DataModelFirst(Building.AccessState.GetExports, '(int32)7')]"

								item = {
									flowcontainer = {
										small_goods_button = {
											blockoverride "tooltip" {
												tooltip = "[Goods.GetStateExportsDesc]"
											}
										}
										textbox = {
											raw_text = "[Building.GetState.GetExportedAmount(Goods.Self)|v0D]"
											autoresize = yes
											align = nobaseline
											margin_left = 3
											margin_right = 5
											minimumsize = { 40 -1 }
										}
									}
								}
							}
						}
					}
				}




				### HOLDING CHARACTER
				flowcontainer = {
					direction = vertical
					visible = "[Building.HasHoldingCharacter]"
					datacontext = "[Building.AccessHoldingCharacter]"

					using = tooltip_segment_background
					using = tooltip_segment_margin
					min_width = @tooltip_fixed_width

					custom_tooltip_textbox = {
						text = "HOLDING"
					}

					flowcontainer = {
						spacing = 8
						margin_top = 3

						button = {
							size = { 35 35 }
							onclick = "[InformationPanelBar.OpenCharacterPanel(Character.AccessSelf)]"
							onrightclick = "[RightClickMenuManager.ShowForCharacter(Character.AccessSelf)]"
							tooltip = "GO_TO_BUTTON_CHARACTER"

							character_portrait_small = {}
						}

						textbox = {
							text = "[Character.GetFullName]"
							autoresize = yes
							align = nobaseline
							parentanchor = vcenter
							using = tooltip_font
						}
					}
				}

				flowcontainer = {
					direction = vertical
					visible = "[Not(IsDataModelEmpty(Building.GetBuildingAssets))]"

					using = tooltip_segment_background
					using = tooltip_segment_margin
					min_width = @tooltip_fixed_width

					custom_tooltip_textbox = {
						text = "PORTFOLIO_TOOLTIP_HEADER"
					}

					property_portfolio_stacked_bar_chart = {
						blockoverride "barchart_size" {
							size = { @tooltip_fixed_width 40 }
						}
					}
				}
			}

			# Basic text contents when building is not constructed
			custom_tooltip_textbox = {
				visible = "[Not(Building.IsValid)]"
				text = "DATA_BUILDING_NAME_TOOLTIP"
			}

			custom_tooltip_textbox = {
				visible = "[InDebugMode]"
				raw_text = "[Building.GetDebugTooltip]"
			}
		}

		blockoverride "icon_background_texture" {}

		blockoverride "icon_frame" {}

		blockoverride "go_to_button_visibility" {
			visible = "[Building.IsValid]"
		}

		blockoverride "go_to_button_properties" {
			onclick = "[InformationPanelBar.OpenBuildingDetailsPanel(Building.AccessSelf)]"
		}
	}



