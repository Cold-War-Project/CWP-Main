	type FancyTooltip_ShipModificationType = FancyTooltipWidgetType {
		blockoverride "text" {} # Fully replaced by everything in tooltip_content_after

		blockoverride "name" {
			text = "[ShipModificationType.GetNameNoFormatting]"
		}

		blockoverride "type" {
			text = "[concept_ship_modification]"
		}

		blockoverride "icon_texture" {
			texture = "[ShipModificationType.GetIcon]"
		}

		blockoverride "icon_background_texture" {}

		blockoverride "icon_frame" {}

		blockoverride "tooltip_content_after" {
			custom_tooltip_textbox_with_empty_line = {
				visible = "[Not(StringIsEmpty(ShipModificationType.GetTechRequirements(GetPlayer.Self)))]"
				text = "SHIP_MODIFICATION_TECH_REQUIREMENTS_DESC"
			}

			flowcontainer = {
				direction = vertical
				datacontext = "[ShipModificationType.GetModifier]"

				custom_tooltip_textbox_with_empty_line = {
					visible = "[Not(IsDataModelEmpty(ShipModificationType.GetApplicableShipTypes))]"
					text = "SHIP_MODIFICATION_APPLICABLE_SHIP_TYPES_DESC"
				}

				ship_modifier_stat_hit_points = {
