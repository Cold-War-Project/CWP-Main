				custom_tooltip_newline = {}

				custom_tooltip_textbox_fixed_width = {
					text = "CULTURE_TT_ACCEPTANCE_MOD"
				}

				flowcontainer = {
					direction = vertical
					visible = "[NotEqualTo_int64(Culture.GetPopulation(GetPlayer.Self),'(int64)0')]"

