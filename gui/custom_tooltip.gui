					visible = "[Not(StringIsEmpty(GetDesc(CreateNavalMissionsForSelectedFleets(NavalMissionType.AccessSelf))))]"
					text = "[GetDesc(CreateNavalMissionsForSelectedFleets(NavalMissionType.AccessSelf))]"
				}

				custom_tooltip_newline = {
					visible = "[Not(StringIsEmpty(GetDesc(CreateNavalMissionsForSelectedFleets(NavalMissionType.AccessSelf))))]"
				}
			}

			custom_tooltip_textbox = {
				text = "[NavalMissionType.GetDesc]"
			}

			custom_tooltip_newline = {
				visible = "[Or(Not(NavalMissionType.GetModifier.IsEmpty), Not(NavalMissionType.GetCommandModifier.IsEmpty))]"
			}

			custom_tooltip_textbox = {
				visible = "[Or(Not(NavalMissionType.GetModifier.IsEmpty), Not(NavalMissionType.GetCommandModifier.IsEmpty))]"
				default_format = "#title"
				text = "MODIFIERS_HEADER"
