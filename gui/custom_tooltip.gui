	type FancyTooltip_MilitaryFormation = FancyTooltipWidgetType {
		max_update_rate = 8

		blockoverride "icon_texture" {
			texture = "[MilitaryFormation.GetFlag]"
			color = "[MilitaryFormation.GetFlagColor]"
		}

		blockoverride "icon_background_texture" {}

		blockoverride "icon_frame" {}

		blockoverride "name" {
			text = "DATA_MILITARY_FORMATION_NAME"
		}

		blockoverride "type" {
			text = "DATA_MILITARY_FORMATION_TYPE"
		}

		blockoverride "go_to_button_visibility" {
			visible = yes
		}

		blockoverride "go_to_button_tooltip" {
			tooltip = "GO_TO_BUTTON_MILITARY_FORMATION"
		}

		blockoverride "go_to_button_properties" {
			onclick = "[InformationPanelBar.OpenMilitaryFormationPanel(MilitaryFormation.Self)]"
		}

		blockoverride "tooltip_content_after" {
			flowcontainer = {
				direction = vertical
				using = tooltip_segment_margin_first

				custom_tooltip_textbox = {
					max_width = @tooltip_fixed_width
					text = "[MilitaryFormation.GetFormationStatusDesc]"
				}

				custom_tooltip_textbox = {
					visible = "[MilitaryFormation.GetStrategicObjective.IsValid]"
					max_width = @tooltip_fixed_width
					text = "SELECTED_STRATEGIC_OBJECTIVE"
				}

				flowcontainer = {
					visible = "[MilitaryFormation.HasNavalMission]"
					datacontext = "[MilitaryFormation.GetNavalMission]"
					spacing = 5

					icon = {
						parentanchor = vcenter
						size = { 30 30 }
						texture = "[NavalMission.GetType.GetIcon]"
					}

					custom_tooltip_textbox = {
						parentanchor = vcenter
						max_width = @tooltip_fixed_width
						text = "SELECTED_NAVAL_MISSION"
					}
				}
			}

			custom_tooltip_2_columns = {
				blockoverride "left_column" {
					custom_tooltip_textbox_column_width = {
						text = "DATA_MILITARY_FORMATION_REGULARS"
					}

					custom_tooltip_textbox_column_width = {
						visible = "[MilitaryFormation.IsArmy]"
						alpha = "[TransparentIfTrue(Not(MilitaryFormation.HasRaisedConscripts))]"
						text = "DATA_MILITARY_FORMATION_CONSCRIPTS"
					}

					custom_tooltip_textbox_column_width = {
						visible = "[MilitaryFormation.GetFlagship.IsValid]"
						text = "FLEET_FLAGSHIP_STATUS_IN_TOOLTIP"
					}
				}
				blockoverride "right_column" {
					custom_tooltip_textbox_column_width = {
						visible = "[Not(MilitaryFormation.IsFleet)]"
						text = "DATA_MILITARY_FORMATION_UPKEEP"
					}
					custom_tooltip_textbox_column_width = {
						visible = "[MilitaryFormation.IsFleet]"
						text = "DATA_MILITARY_FORMATION_FLEET_SUPPLY"
						tooltip = "[MilitaryFormation.GetShipList.GetSupplyExpensesDesc]"
					}
				}
			}

			custom_tooltip_2_columns = {
				blockoverride "bg" {}

				blockoverride "left_column" {
					flowcontainer = {
						visible = "[MilitaryFormation.IsArmy]"
						spacing = 5
						margin_left = 1

						manpower_bar = {
							size = { 6 15 }
							parentanchor = vcenter
							alpha = "[TransparentIfTrue(EqualTo_int64(MilitaryFormation.GetMaxManpower, MilitaryFormation.GetCurrentManpower))]"
						}

						DefaultTooltipTextBox = {
							parentanchor = vcenter
							align = nobaseline
							autoresize = yes
							multiline = yes
							fonttintcolor = "[TooltipInfo.GetTintColor]"
							text = "DATA_MILITARY_FORMATION_MANPOWER"
						}
					}

					flowcontainer = {
						visible = "[MilitaryFormation.IsFleet]"
						datacontext = "[MilitaryFormation.GetShipList]"
						spacing = 5
						margin_left = 1

						hit_points_bar = {
							size = { 6 18 }
							parentanchor = vcenter
							tooltip = "MILITARY_FORMATION_HIT_POINTS_TOOLTIP"

							blockoverride "hit_points_value" {
								value = "[FixedPointToFloat(MilitaryFormation.GetHitPointsPercentage)]"
							}
							blockoverride "hit_points_color" {
								color = "[GetMoraleColorVec(MilitaryFormation.GetHitPointsPercentage)]"
							}
							alpha = "[TransparentIfTrue(EqualTo_CFixedPoint(MilitaryFormation.GetHitPointsPercentage, '(CFixedPoint)1'))]"
						}

						DefaultTooltipTextBox = {
							parentanchor = vcenter
							align = nobaseline
							autoresize = yes
							multiline = yes
							fonttintcolor = "[TooltipInfo.GetTintColor]"
							text = "DATA_MILITARY_FORMATION_SHIP_HITPOINTS"
						}
					}

					flowcontainer = {
						visible = "[MilitaryFormation.IsFleet]"
						datacontext = "[MilitaryFormation.GetShipList]"
						spacing = 5
						margin_left = 1

						crew_bar = {
							size = { 6 15 }
							parentanchor = vcenter
							alpha = "[TransparentIfTrue(EqualTo_int32(ShipList.GetCrewMax, ShipList.GetCrew))]"
						}

						DefaultTooltipTextBox = {
							parentanchor = vcenter
							align = nobaseline
							autoresize = yes
							multiline = yes
							fonttintcolor = "[TooltipInfo.GetTintColor]"
							text = "DATA_MILITARY_FORMATION_SHIP_CREW"
						}
					}

					flowcontainer = {
						spacing = 5
						margin_left = 1

						organization_bar = {
							tooltip = "MILITARY_FORMATION_ORGANIZATION_TOOLTIP"
							parentanchor = vcenter
							size = { 6 15 }
							alpha = "[TransparentIfTrue(EqualTo_CFixedPoint(MilitaryFormation.GetOrganizationPercentage, '(CFixedPoint)1'))]"

							blockoverride "organization_value" {
								value = "[FixedPointToFloat( MilitaryFormation.GetOrganizationPercentage )]"
							}

							blockoverride "organization_color" {
								color = "[GetOrganizationColorVec( MilitaryFormation.GetOrganizationPercentage )]"
							}
						}

						DefaultTooltipTextBox = {
							parentanchor = vcenter
							align = nobaseline
							autoresize = yes
							multiline = yes
							fonttintcolor = "[TooltipInfo.GetTintColor]"
							text = "DATA_MILITARY_FORMATION_ORGANIZATION"
						}
					}

					flowcontainer = {
						visible = "[MilitaryFormation.IsArmy]"
						spacing = 5
						margin_left = 1

						morale_bar = {
							size = { 6 15 }
							parentanchor = vcenter
							tooltip = "MILITARY_FORMATION_MORALE_TOOLTIP"

							blockoverride "morale_value" {
								value = "[FixedPointToFloat( MilitaryFormation.GetMorale )]"
							}
							blockoverride "morale_color" {
								color = "[GetMoraleColorVec( MilitaryFormation.GetMorale )]"
							}
							alpha = "[TransparentIfTrue(EqualTo_CFixedPoint(MilitaryFormation.GetMorale, '(CFixedPoint)1'))]"
						}

						DefaultTooltipTextBox = {
							parentanchor = vcenter
							align = nobaseline
							autoresize = yes
							multiline = yes
							fonttintcolor = "[TooltipInfo.GetTintColor]"
							text = "DATA_MILITARY_FORMATION_MORALE"
						}
					}
				}

				blockoverride "right_column" {
					maximumsize = { 305 -1 }

					custom_tooltip_textbox_column_width = {
						visible = "[MilitaryFormation.IsArmy]"
						maximumsize = { 305 -1 }
						text = "DATA_MILITARY_FORMATION_COLUMN_ONE_ARMY"
					}

					custom_tooltip_textbox_column_width = {
						visible = "[MilitaryFormation.IsFleet]"
						maximumsize = { 305 -1 }
						text = "DATA_MILITARY_FORMATION_COLUMN_ONE_FLEET"
					}
				}
			}

			custom_tooltip_textbox = {
				using = tooltip_segment_margin
				margin_top = 0
				min_width = @tooltip_fixed_width
				max_width = @tooltip_fixed_width
				visible = "[MilitaryFormation.IsExiled]"

				text = "MILITARY_FORMATION_EXILED_ARMY_SHORT"
			}

			flowcontainer = {
				using = tooltip_segment_background
				using = tooltip_segment_margin
				min_width = @tooltip_fixed_width
				direction = vertical

				custom_tooltip_textbox = {
					visible = "[Not(IsDataModelEmpty(MilitaryFormation.GetCombatUnitEntries))]"
					default_format = "#title"
					text = "COMBAT_UNITS_CONCEPT"
				}

				flowcontainer = {
					visible = "[Not(IsDataModelEmpty(MilitaryFormation.GetCombatUnitEntries))]"
					spacing = 3
					margin_left = -2
					datamodel = "[MilitaryFormation.GetCombatUnitEntries]"

					item = {
						flowcontainer = {
							visible = "[GreaterThan_int32(MilitaryFormationUnitEntry.GetExpectedNumTotalUnits, '(int32)0')]"
							datacontext = "[MilitaryFormationUnitEntry.GetUnitType]"
							direction = vertical

							background = {
								using = simple_frame
							}

							margin = { 3 3 }

							tooltipwidget = {
								FancyTooltip_CombatUnitTypeWithCulture = {
									datacontext = "[MilitaryFormation.GetPrimaryCultureForType( CombatUnitType.Self )]"

									blockoverride "text_before_before" {
										text = "DATA_COMBAT_UNIT_TYPE_WITH_FORMATION_CONTEXT"
										margin_bottom = 15
									}
								}
							}

							flowcontainer = {
								direction = vertical

								icon = {
									texture = "[CombatUnitType.GetTextureForCulture( MilitaryFormation.GetPrimaryCultureForType( CombatUnitType.Self ).Self )]"
									size = { 70 70 }
									parentanchor = hcenter

									modify_texture = {
										using = simple_frame_mask
									}

									icon = {
										using = simple_frame
										size = { 100% 100% }
									}

									offense_defense_info_small = {
										position = { -2 -2 }

										background = {
											using = dark_area
											alpha = 0.7
										}
									}
								}

								flowcontainer = {
									direction = vertical
									parentanchor = hcenter

									custom_tooltip_textbox = {
										visible = "[MilitaryFormation.IsArmy]"
										autoresize = yes
										align = nobaseline
										using = elide_fontsize_min
										max_width = 65
										parentanchor = hcenter
										elide = right
										text = "MILITARY_FORMATION_NUMBER_OF_BATTALIONS"
										tooltip = "UNIT_TYPE_REGULAR_BATTALIONS_TOOLTIP_FOR_GUI"
									}

									custom_tooltip_textbox = {
										visible = "[MilitaryFormation.IsFleet]"
										autoresize = yes
										align = nobaseline
										using = elide_fontsize_min
										parentanchor = hcenter
										text = "MILITARY_FORMATION_NUMBER_OF_SHIPS"
										tooltip = "SHIP_TYPE_TOOLTIP_FOR_GUI"
									}

									custom_tooltip_textbox = {
										visible = "[And( MilitaryFormation.IsArmy, Not( MilitaryFormation.HasRaisedConscripts ))]"
										alpha = "[TransparentIfFalse(MilitaryFormation.HasRaisedConscripts)]"
										maximumsize = { 65 28 }
										parentanchor = hcenter
										elide = right
										autoresize = yes
										align = nobaseline
										using = elide_fontsize_min
										text = "MILITARY_FORMATION_NUMBER_OF_CONSCRIPTS_NOT_RAISED"
										tooltip = "UNIT_TYPE_CONSCRIPT_BATTALIONS_TOOLTIP_FOR_GUI_NOT_RAISED"
									}

									custom_tooltip_textbox = {
										visible = "[MilitaryFormation.HasRaisedConscripts]"
										alpha = "[TransparentIfFalse(Or(NotZero(MilitaryFormationUnitEntry.GetCurrentNumConscriptUnits), NotZero(MilitaryFormationUnitEntry.GetExpectedNumConscriptUnits)))]"
										maximumsize = { 65 28 }
										parentanchor = hcenter
										elide = right
										autoresize = yes
										align = nobaseline
										using = elide_fontsize_min
										text = "MILITARY_FORMATION_NUMBER_OF_CONSCRIPTS"
										tooltip = "UNIT_TYPE_CONSCRIPT_BATTALIONS_TOOLTIP_FOR_GUI"
									}
								}
							}
						}
					}
				}

				custom_tooltip_textbox = {
					visible = "[MilitaryFormation.IsFleet]"
					text = "SHIPS_CONCEPT"
				}

				flowcontainer = {
					wrap_count = 2
					datacontext = "[MilitaryFormation.GetShipList]"

					### SHIP TYPES - 6 or less
					flowcontainer = {
						visible = "[LessThan_int32(GetDataModelSize(ShipList.GetShipTemplates), '(int32)6')]"
						datamodel = "[ShipList.GetShipTemplates]"
						wrap_count = 2
						spacing = 2

						item = {
							flowcontainer = {
								visible = "[NotZero(ShipList.GetNumShipsOfTemplate(ShipTemplate.Self))]"

								ship_silhouette_for_tooltips = {
									datacontext = "[ShipTemplate.GetType]"

									blockoverride "ship_type_name" {
										text = "NUMBER_OF_SHIPS_OF_TEMPLATE_IN_FLEET"
									}
								}
							}
						}
					}

					### SHIP TYPES - More than 6
					flowcontainer = {
						visible = "[GreaterThan_int32(GetDataModelSize(ShipList.GetShipTemplates), '(int32)6')]"
						datamodel = "[DataModelFirst(ShipList.GetShipTemplates, '(int32)6')]"
						wrap_count = 2
						spacing = 2

						item = {
							flowcontainer = {
								visible = "[NotZero(ShipList.GetNumShipsOfTemplate(ShipTemplate.Self))]"

								ship_silhouette_for_tooltips = {
									datacontext = "[ShipTemplate.GetType]"

									blockoverride "ship_type_name" {
										text = "NUMBER_OF_SHIPS_OF_TEMPLATE_IN_FLEET"
									}
								}
							}
						}
					}

					### Additional ship types number
					textbox = {
						visible = "[GreaterThan_int32(GetDataModelSize(ShipList.GetShipTemplates), '(int32)6')]"
						autoresize = yes
						align = nobaseline
						parentanchor = vcenter
						raw_text = "#v [GetDataModelSize(DataModelSkipFirst(ShipList.GetShipTemplates, '(int32)6'))|=]#!"

						tooltipwidget = {
							RegularTooltip_AdditionalShipTypes = {
								blockoverride "header_text" {
									text = "MORE_THAN_6_SHIP_TEMPLATES_TOOLTIP_FLEET"
								}

								blockoverride "datamodel" {
									datamodel = "[DataModelSkipFirst(ShipList.GetShipTemplates, '(int32)6')]"
								}
							}
						}
					}
				}
			}

			flowcontainer = {
				visible = "[And( MilitaryFormation.IsFleet, Not( IsDataModelEmpty( MilitaryFormation.GetTransportedFormations ) ) )]"
				using = tooltip_segment_background
				using = tooltip_segment_margin
				min_width = @tooltip_fixed_width
				direction = vertical

				custom_tooltip_textbox = {
					default_format = "#title"
					text = "FLEET_TRANSPORTED_ARMIES_HEADER"
				}

				flowcontainer = {
					direction = vertical
					datamodel = "[MilitaryFormation.GetTransportedFormations]"

					item = {
						flowcontainer = {
							spacing = 5
							margin = { 2 2 }

							icon = {
								parentanchor = vcenter
								size = { 24 24 }
								texture = "[MilitaryFormation.GetFlag]"
								color = "[MilitaryFormation.GetFlagColor]"
							}

