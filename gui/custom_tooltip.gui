	type RegularTooltip_LocalPrices = RegularTooltip {
		blockoverride "tooltip_content_after" {
			flowcontainer = {
				datamodel = "[DataModelSkipFirst(Goods.AccessMarket.AccessLocalPrices(Goods.Self), '(int32)14')]"
				wrap_count = 8
				spacing = 5

				item = {
					flowcontainer = {
						datacontext = "[Goods.AccessState]"
						direction = vertical
						margin = { 5 5 }
						margin_right = 10

						tooltipwidget = {
							FancyTooltip_Goods = {}
						}

						background = {
							using = entry_bg_simple
						}

						textbox = {
							visible = "[ObjectsEqual(State.GetOwner, GetPlayer.Self)]"
							text = "[Goods.GetState.GetNameNoFormatting]"
							autoresize = yes
							align = nobaseline
							maximumsize = { 92 23 }
							minimumsize = { 92 23 }
							using = elide_fontsize_min
							margin_left = 4
						}

						textbox = {
							visible = "[Not(ObjectsEqual(State.GetOwner, GetPlayer.Self))]"
							text = "[State.GetOwner.GetFlagTextIcon] [Goods.GetState.GetNameNoFormatting]"
							autoresize = yes
							align = nobaseline
							maximumsize = { 92 23 }
							minimumsize = { 92 23 }
							using = elide_fontsize_min
							margin_left = 4
						}

						textbox = {
							text = "GOODS_LOCAL_PRICE_INFO"
							autoresize = yes
							align = nobaseline
							maximumsize = { 92 23 }
							minimumsize = { 92 23 }
							using = elide_fontsize_min
						}
					}
				}
			}
		}
	}

	type FancyTooltip_Law = FancyTooltipWidgetType {
		blockoverride "text" {} # Fully replaced by everything in tooltip_content_after

		blockoverride "icon_texture" {
			texture = "[Law.GetTexture]"
		}

		blockoverride "name" {
			raw_text = "[Law.GetNameNoFormatting] ([Law.GetGroup.GetName])"
		}

		blockoverride "type" {
			text = "TOOLTIP_TYPE_CONSTITUTION_LAW"
		}

		blockoverride "go_to_button_visibility" {
			visible = yes
		}

		blockoverride "go_to_button_properties" {
			onclick = "[InformationPanelBar.OpenChangeLaw(Law.GetGroup)]"
		}

		blockoverride "tooltip_content_after" {

			block "active_status" {
				custom_tooltip_textbox = {
					visible = "[Law.IsActive]"
					text = "ACTIVE_LAW"
				}

				custom_tooltip_textbox = {
					visible = "[And(Not(Law.IsActive), Not(Law.IsBeingEnacted))]"
					text = "INACTIVE_LAW"
				}

				custom_tooltip_textbox = {
					visible = "[And(Not(StringIsEmpty(Law.CannotEnactDesc)), And(Not(Law.IsActive), Not(Law.IsBeingEnacted)))]"
					text = "[Law.CannotEnactDesc]"
				}

				custom_tooltip_textbox = {
					visible = "[IsValid(Law.StartEnacting)]"
					text = "LAW_CAN_BE_ENACTED"
				}

				custom_tooltip_textbox = {
					visible = "[Law.IsBeingEnacted]"
					text = "LAW_BEING_ENACTED_DESC"
				}

				custom_tooltip_newline = {
					visible = "[Not(Or(Law.IsActive, Law.IsBeingEnacted))]"
				}

				custom_tooltip_textbox = {
					visible = "[Not(Or(Law.IsActive, Law.IsBeingEnacted))]"
					text = "ENACT_LAW_CHANCES_HEADER"
				}
			}

			### ENACTMENT CHANCES
			widget = {
