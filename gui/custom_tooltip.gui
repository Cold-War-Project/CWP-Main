	type FancyTooltip_NavalMissionType = FancyTooltipWidgetType {
		blockoverride "text" {} # Fully replaced by everything in tooltip_content_after

		blockoverride "icon_texture" {
			texture = "[NavalMissionType.GetIcon]"
		}

		blockoverride "name" {
			raw_text = "[NavalMissionType.GetNameNoFormatting]"
