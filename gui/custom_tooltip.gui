	type FancyTooltip_Goods = FancyTooltipWidgetType {
		blockoverride "text" {
			text = "DATA_GOODS_NAME_TOOLTIP"
		}

		blockoverride "icon_texture" {
			texture = "[Goods.GetTexture]"
		}

		blockoverride "name" {
			block "goods_name" {
				text = "[Goods.GetNameNoFormatting]"
			}
		}

		blockoverride "type" {
			text = "TOOLTIP_TYPE_GOODS"
		}

		blockoverride "color" {
			color = "[Goods.GetCategoryColor]"
		}

		blockoverride "go_to_button" {
			button_icon_goto = {
				visible = "[And(Goods.HasStateContext, Not(Goods.IsLocal))]"
				size = { 30 30 }
				input_action = "go_to_details"
				using = tooltip_above
				tooltip = "GO_TO_DETAILS"
				onclick = "[InformationPanelBar.OpenGoodsStatePanel(Goods.GetState, Goods.Self)]"
			}

			button_icon_goto = {
				visible = "[Goods.IsLocal]"
				size = { 30 30 }
				input_action = "go_to_details"
				using = tooltip_above
				tooltip = "GO_TO_DETAILS"
				onclick = "[InformationPanelBar.OpenGoodsLocalPricesPanel(Goods.Self)]"
			}

			button_icon_goto = {
				visible = "[And(Goods.HasMarketContext, Not(Or(Goods.HasStateContext, Goods.IsLocal)))]"
				size = { 30 30 }
				input_action = "go_to_details"
				using = tooltip_above
				tooltip = "GO_TO_DETAILS"
				onclick = "[InformationPanelBar.OpenGoodsPanel(Goods.GetMarket, Goods.Self)]"
			}

			button_icon_goto = {
				visible = "[Not(Or(Or(Goods.HasMarketContext, Goods.HasStateContext), Goods.IsLocal))]"
				size = { 30 30 }
				input_action = "go_to_details"
				using = tooltip_above
				tooltip = "GO_TO_DETAILS"
				onclick = "[InformationPanelBar.OpenGoodsPanel(GetPlayer.GetMarket.Self, Goods.Self)]"
			}
		}

		blockoverride "tooltip_content_before" {

			flowcontainer = {
				visible = "[Or(Not(Goods.IsLocal), Goods.HasStateContext)]"
				spacing = 10
				margin_bottom = 10
				margin_top = 5

				block "state_price_card" {
					state_price_card = {}
				}

				block "market_price_card" {
					market_price_card = {}
				}

				world_market_price_card = {}
			}

			container = {
				visible = "[Goods.IsLocal]"

				flowcontainer = {
					datamodel = "[DataModelFirst(Goods.AccessMarket.AccessLocalPrices(Goods.Self), '(int32)14')]"
					wrap_count = 5
					spacing = 5

					item = {
						flowcontainer = {
							datacontext = "[Goods.AccessState]"
							direction = vertical
							margin = { 5 5 }
							margin_right = 10

							tooltipwidget = {
								FancyTooltip_Goods = {}
							}

							background = {
								using = entry_bg_simple
							}

							textbox = {
								visible = "[ObjectsEqual(State.GetOwner, GetPlayer.Self)]"
								text = "[Goods.GetState.GetNameNoFormatting]"
								autoresize = yes
								align = nobaseline
								maximumsize = { 92 23 }
								minimumsize = { 92 23 }
								using = elide_fontsize_min
								margin_left = 4
							}

							textbox = {
								visible = "[Not(ObjectsEqual(State.GetOwner, GetPlayer.Self))]"
								text = "[State.GetOwner.GetFlagTextIcon] [Goods.GetState.GetNameNoFormatting]"
								autoresize = yes
								align = nobaseline
								maximumsize = { 92 23 }
								minimumsize = { 92 23 }
								using = elide_fontsize_min
								margin_left = 4
							}

							textbox = {
								text = "GOODS_LOCAL_PRICE_INFO"
								autoresize = yes
								align = nobaseline
								maximumsize = { 92 23 }
								minimumsize = { 92 23 }
								using = elide_fontsize_min
							}
						}
					}
				}

				flowcontainer = {
					parentanchor = bottom|right
					margin = { 5 5 }
					margin_right = 10
					visible = "[GreaterThan_int32(GetDataModelSize(Goods.AccessMarket.AccessLocalPrices(Goods.Self)), '(int32)14')]"

					tooltipwidget = {
						RegularTooltip_LocalPrices = {}
					}

					background = {
						using = entry_bg_simple
					}

					textbox = {
						raw_text = "#b [GetDataModelSize(DataModelSkipFirst(Goods.AccessMarket.AccessLocalPrices(Goods.Self), '(int32)14'))|=]#!"
						autoresize = yes
						align = hcenter|nobaseline
						maximumsize = { 90 46 }
						minimumsize = { 90 46 }
						using = elide_fontsize_min
						using = fontsize_large
					}
				}
			}

			custom_tooltip_textbox = {
				using = tooltip_segment_margin
				visible = "[Goods.IsPrestigeGoods]"
				text = "PRESTIGE_GOODS_VARIANT"
				margin_bottom = 0
			}
		}

		blockoverride "tooltip_content_after" {

			custom_tooltip_textbox = {
				visible = "[And3(
					Goods.HasMarketContext,
					Not(Goods.GetMarket.CanTradeGoods(Goods.Self)),
					Not(Goods.IsLocal)
				)]"
				text = "GOODS_CANNOT_BE_TRADED_DUE_TO_TREATY"
			}

			flowcontainer = {
				minimumsize = { 540 -1 }
				margin_top = 10

				flowcontainer = {
					visible = "[Not(IsDataModelEmpty(Goods.AccessBuildingsProducingThis))]"
					minimumsize = { 270 -1 }
					direction = vertical

					custom_tooltip_textbox = {
						text = "PRODUCING_GOODS"
						autoresize = yes
						align = nobaseline
						margin_bottom = 2
					}

					overlappingitembox = {
						datamodel = "[Goods.AccessBuildingsProducingThis]"
						size = { 260 44 }
						spacing = 3
						righttoleft = yes

						item = {
							icon = {
								size = { 44 44 }
								texture = "[BuildingType.GetIcon]"

								tooltipwidget = {
									FancyTooltip_BuildingType = {}
								}
							}
						}
					}
				}

				flowcontainer = {
					direction = vertical
					minimumsize = { 270 -1 }
					visible = "[Not(IsDataModelEmpty(Goods.AccessBuildingsUsingThis))]"

					custom_tooltip_textbox = {
						text = "USING_GOODS"
						autoresize = yes
						align = nobaseline
						margin_bottom = 2
					}

					overlappingitembox = {
						datamodel = "[Goods.AccessBuildingsUsingThis]"
						size = { 270 44 }
						spacing = 3
						righttoleft = yes

						item = {
							icon = {
								size = { 44 44 }
								texture = "[BuildingType.GetIcon]"

								tooltipwidget = {
									FancyTooltip_BuildingType = {}
								}
							}
						}
					}
				}
			}

			custom_tooltip_textbox = {
				visible = "[Not(StringIsEmpty(Goods.GetNeedLevelsContainingThisDesc))]"
				text = "[Goods.GetNeedLevelsContainingThisDesc]"
				margin_top = 10
			}

			widget = {
				visible = "[Goods.HasMarketContext]"
				size = { 10 10 }
			}

			block "goods_interactions" {
				widget = {
					visible = "[Goods.HasMarketContext]"
					size = { 540 100 }

					background = {
						using = entry_bg_simple
						margin_left = 2
						margin_right = 2
					}

					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 10
						margin = { 10 0 }

						#CONSUMPTION TAXES
						vbox = {
							spacing = 8
							margin_left = 60

								textbox = {
									layoutpolicy_horizontal = expanding
									align = center|nobaseline
									text = "BUDGET_CONSUMPTION_TAXES"
								}

								widget = { size = { 5 5 }}

								consumption_tax_button_toggle = {
									visible = "[Not(ObjectsEqual(GetMetaPlayer.GetPlayedOrObservedCountry.GetCapital.GetMarket, Goods.GetMarket))]"

									blockoverride "tooltip" {
										tooltip = "NOT_PLAYER_MARKET_CONSUMPTION_TAXES"
								}

								blockoverride "enabled" {
									enabled = no
								}
							}

							consumption_tax_button_toggle = {
								visible = "[ObjectsEqual(GetMetaPlayer.GetPlayedOrObservedCountry.GetCapital.GetMarket, Goods.GetMarket)]"
							}

							widget = { size = { 5 5 }}
						}

						widget = { size = { 20 5 }}

						vertical_divider_full = {
							blockoverride "size" {
								size = { 0 95 }
								}
							}

						#TARIFFS AND SUBVENTION
						vbox = {
							visible = "[Goods.IsTradeable]"
							spacing = 5
							widget = {
								textbox = {
									autoresize = yes
									align = nobaseline
									text = "BUDGET_TARIFFS"
									parentanchor = left|vcenter
								}
							}

							hbox = {
								margin_top = 6
								spacing = 5

								icon = {
									texture = "gfx/interface/icons/trade_icons/imports.dds"
									size = { 28 28 }
								}

								set_level_bar_import_tariffs = {}
							}

							hbox = {
								spacing = 5
								#margin_top = 5

								icon = {
									texture = "gfx/interface/icons/trade_icons/exports.dds"
									size = { 28 28 }
								}

								set_level_bar_export_tariffs = {}
							}
						}

					}
				}
			}

			block "goods_trend" {
				v3_plotline = {
					visible = "[And(Goods.HasPriceTrend,Not(Goods.IsLocal))]"

					blockoverride "size" {
						size = { 450 100 }
					}
					blockoverride "header" {
						text = "PRICE"
					}
					blockoverride "line_color" {
						color = { .9 .9 .9 1.0 }
					}
					blockoverride "line_plotpoints" {
						visible = "[Not(IsEmpty(Goods.GetPriceTrend))]"
						plotpoints = "[GetTrendPlotPointsNormalized( Goods.GetPriceTrend, Goods.GetMinPrice, Goods.GetMaxPrice )]"
					}
					blockoverride "maxvalue" {
						raw_text = "@money![Goods.GetMaxPrice]"
					}
					blockoverride "minvalue" {
						raw_text = "@money![Goods.GetMinPrice]"
					}
					blockoverride "startdate" {
						text = "[GetOldestDate(Goods.GetPriceTrend)]"
					}
					blockoverride "enddate" {
						text = "[GetLatestDate(Goods.GetPriceTrend)]"
					}
					blockoverride "multiitem" {}

					blockoverride "extra_plotlines" {
						### Base Price line
						plotline = {
							size = { 100% 100% }
							using = plot_line
							width = 1
							color = { 0 0 0 0.5 }
							plotpoints = "[Goods.GetBasePricePlotPoints]"
						}
					}
					blockoverride "empty_state_visibility" {
						visible = "[IsEmpty(Goods.GetPriceTrend)]"
					}

					blockoverride "everything_that_is_not_empty_state_visibility" {
						visible = "[Not(IsEmpty(Goods.GetPriceTrend))]"
					}

					blockoverride "empty_state_text" {
						text = "GRAPH_NOT_INITIALIZED"
					}
				}
			}
		}
	}

