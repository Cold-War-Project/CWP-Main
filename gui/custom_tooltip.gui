	type FancyTooltip_ArticleWithCountryContext = FancyTooltipWidgetType {
		blockoverride "text" {} # Fully replaced by everything in tooltip_content_after

		blockoverride "icon_texture" {
			texture = "[Article.GetArticleType.GetIcon]"
		}

		blockoverride "icon_size" {
			size = { 70% 70% }
		}

		blockoverride "name" {
			text = "[Article.GetNameNoFormatting]"
		}

		blockoverride "type" {
			text = "[concept_article]"
		}

		blockoverride "tooltip_content_after" {
			custom_tooltip_textbox = {
				visible = "[Article.ExceedsMaxContraventions(Country.Self)]"
				using = look_at_me_text_animation
				text = "ARTICLE_TOOLTIP_NOT_FULFILLED"
			}

			custom_tooltip_textbox = {
				visible = "[Article.ExceedsMaxContraventions(Country.Self)]"
				text = "ARTICLE_TOOLTIP_NOT_FULFILLED_REASON"
			}

			custom_tooltip_textbox_with_empty_line = {
				visible = "[And(Treaty.IsFrozenFor(Country.Self), Not(Country.IsAtWarWith(Treaty.GetOtherCountry(Country.Self).Self)))]"
				text = "ARTICLE_IS_FROZEN_STATUS"
			}

			custom_tooltip_textbox_with_empty_line = {
				visible = "[And(Treaty.IsFrozenFor(Country.Self), Country.IsAtWarWith(Treaty.GetOtherCountry(Country.Self).Self))]"
				text = "TREATY_FROZEN_DUE_TO_WAR"
			}

			flowcontainer = {
				visible = "[Article.HasType('law_commitment')]"
				direction = vertical

				custom_tooltip_textbox = {
					text = "ARTICLE_LAW_LABEL"
				}

				custom_tooltip_textbox_with_empty_line = {
					visible = "[ObjectsEqual(Article.GetLaw, Country.GetActiveLawFromGroup(Article.GetLaw.GetGroup.GetKey).GetLawType)]"
					text = "ACTIVE_LAW_COUNTRY"
				}

				custom_tooltip_textbox_with_empty_line = {
					visible = "[And(Not(ObjectsEqual(Article.GetLaw, Country.GetActiveLawFromGroup(Article.GetLaw.GetGroup.GetKey).GetLawType)), Not(ObjectsEqual(Article.GetLaw, Country.GetLawBeingEnacted.GetLawType)))]"
					text = "INACTIVE_LAW_COUNTRY"
				}

				custom_tooltip_textbox_with_empty_line = {
					visible = "[ObjectsEqual(Article.GetLaw, Country.GetLawBeingEnacted.GetLawType)]"
					datacontext = "[Country.GetLawBeingEnacted]"
					text = "LAW_BEING_ENACTED_DESC"
				}
			}

			custom_tooltip_textbox_with_empty_line = {
				visible = "[And( Article.HasKind('mutual'), Not(Article.HasType('free_text')))]"
				alpha = "[TransparentIfTrue(Treaty.IsFrozenFor(Country.Self))]"
				text = "ARTICLE_INFLUENCE_COST_TOOLTIP_MUTUAL"
			}

			custom_tooltip_textbox_with_empty_line = {
				visible = "[And( Article.HasKind('directed'), Not(Article.HasType('free_text')))]"
				alpha = "[TransparentIfTrue(Treaty.IsFrozenFor(Country.Self))]"
				text = "ARTICLE_INFLUENCE_COST_TOOLTIP_DIRECTED"
			}

			### FREE TEXT
			custom_tooltip_textbox = {
				visible = "[Article.HasType('free_text')]"
				multiline = yes
				margin_left = 10
				default_format = "#lore"
				text = "TREATY_FREE_TEXT"
			}

			custom_tooltip_textbox = {
				visible = "[Not(Article.HasType('free_text'))]"
				text = "ARTICLE_EFFECTS_TITLE"
			}

			flowcontainer = {
				direction = vertical
				alpha = "[TransparentIfTrue(Treaty.IsFrozenFor(Country.Self))]"

