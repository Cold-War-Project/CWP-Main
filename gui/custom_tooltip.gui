	type FancyTooltip_InterestTierTypeWithCountryAndStrategicRegionContext = FancyTooltipWidgetType {
		blockoverride "text" {}

		blockoverride "name" {
			text = "[InterestTierType.GetNameNoFormatting]"
		}

		blockoverride "icon_texture" {
			texture = "[InterestTierType.GetIcon]"
		}

		blockoverride "type" {
			text = "TOOLTIP_TYPE_INTEREST_TIER_TYPE"
		}

		blockoverride "tooltip_content_after"
		{
			custom_tooltip_textbox = {
				visible = "[ObjectsEqual(InterestTierType.Self, Country.GetCurrentInterestTierTypeIn(StrategicRegion.Self).Self)]"
				text = "INTEREST_TIER_ACTIVE"
			}

			custom_tooltip_textbox = {
				text = "INTEREST_TIER_BOUNDS_DESC"
			}

			custom_tooltip_textbox_with_empty_line = {
				visible = "[EqualTo_CFixedPoint(Country.GetCurrentInvolvementIn(StrategicRegion.Self), Country.GetTargetInvolvementIn(StrategicRegion.Self))]"
				text = "INTEREST_TIER_CURRENT_INVOLVEMENT_DESC"
			}

			custom_tooltip_textbox_with_empty_line = {
				visible = "[Not(EqualTo_CFixedPoint(Country.GetCurrentInvolvementIn(StrategicRegion.Self), Country.GetTargetInvolvementIn(StrategicRegion.Self)))]"
				text = "INTEREST_TIER_TARGET_INVOLVEMENT_DESC"
			}

			### EFFECTS
			flowcontainer = {
				direction = vertical
				spacing = 2

				custom_tooltip_textbox = {
					text = "INTEREST_TIER_EFFECTS_TITLE"
				}

				custom_tooltip_textbox = {
					visible = "[Not(StringIsEmpty(InterestTierType.GetStateModifier.GetDesc))]"
					margin_left = 10
					text = "[InterestTierType.GetStateModifier.GetDesc]"
				}

				custom_tooltip_textbox = {
					visible = "[Not(StringIsEmpty(InterestTierType.GetOnActivateEffectDesc(Country.Self, StrategicRegion.Self)))]"
					margin_left = 10
					text = "[InterestTierType.GetOnActivateEffectDesc(Country.Self, StrategicRegion.Self)]"
				}

				custom_tooltip_textbox = {
					visible = "[Not(StringIsEmpty(InterestTierType.GetTradeAdvantageDesc))]"
					margin_left = 10
					text = "[InterestTierType.GetTradeAdvantageDesc]"
				}

				custom_tooltip_textbox = {
					visible = "[Not(StringIsEmpty(InterestTierType.GetLeverageGenerationMultDesc))]"
					margin_left = 10
					text = "[InterestTierType.GetLeverageGenerationMultDesc]"
				}

				custom_tooltip_textbox = {
					visible = "[And4(StringIsEmpty(InterestTierType.GetOnActivateEffectDesc(Country.Self, StrategicRegion.Self)), StringIsEmpty(InterestTierType.GetStateModifier.GetDesc), StringIsEmpty(InterestTierType.GetTradeAdvantageDesc), StringIsEmpty(InterestTierType.GetLeverageGenerationMultDesc))]"
					margin_left = 10
					text = "INTEREST_TIER_NO_EFFECT"
				}
			}

			flowcontainer = {
				direction = vertical
				spacing = 2

				visible = "[Not(StringIsEmpty(InterestTierType.GetOnDeactivateEffectDesc(Country.Self, StrategicRegion.Self)))]"

				custom_tooltip_newline = {}

				custom_tooltip_textbox = {
					default_format = "#title"
					text = "INTEREST_TIER_ON_DEACTIVATE_EFFECT"
				}

				custom_tooltip_textbox = {
					margin_left = 10
					text = "[InterestTierType.GetOnDeactivateEffectDesc(Country.Self, StrategicRegion.Self)]"
				}
			}

			custom_tooltip_newline = {}

			### INVOLVEMENT BREAKDOWN
			custom_tooltip_textbox = {
				text = "INTERST_TIER_INVOLVEMENT_BREAKDOWN_TITLE"
			}

			custom_tooltip_textbox_with_empty_line = {
				margin_left = 10
				text = "INTERST_TIER_INVOLVEMENT_BREAKDOWN"
			}

			tooltip_divider = {}

			custom_tooltip_textbox = {
				default_format = "#lore"
				text = "[InterestTierType.GetDescription]"
			}
		}
	}

