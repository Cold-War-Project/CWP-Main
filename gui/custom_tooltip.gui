				text = "[NavalMissionType.GetModifier.GetDesc]"
			}

			custom_tooltip_textbox = {
				visible = "[Not(NavalMissionType.GetCommandModifier.IsEmpty)]"
				margin_left = 10
				text = "[NavalMissionType.GetCommandModifier.GetDesc]"
			}
		}
