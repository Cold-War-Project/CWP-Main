								align = right|nobaseline
							}
						}

						flowcontainer = {
							datamodel = "[DataModelFirst(Market.GetImports, '(int32)10')]"
							parentanchor = right
							direction = vertical

							item = {
								flowcontainer = {
									spacing = 5
									parentanchor = right

									minimumsize = { 200 -1 }
									margin = { 3 3 }

									tooltipwidget = {
										FancyTooltip_Goods = {}
									}

									background = {
										visible = "[IsEven_int32(PdxGuiWidget.GetIndexInDataModel)]"
										using = dark_area
									}

									icon = {
										size = { 23 23 }
										texture = "[Goods.GetTexture]"
										parentanchor = vcenter
									}

									custom_tooltip_textbox = {
										text = "[Goods.GetMarketImports|vD]"
										autoresize = yes
										align = nobaseline
										parentanchor = vcenter
										minimumsize = { 40 -1 }
										maximumsize = { 40 -1 }
										fontsize_min = 12
									}

									overlappingitembox = {
										datamodel = "[Goods.GetExportersToMarket]"
										size = { 115 18 }
										spacing = 5
										righttoleft = yes
										parentanchor = vcenter

										item = {
											small_market_flag = {
												parentanchor = vcenter
											}
										}
									}
								}
							}
						}
					}

					flowcontainer = {
						direction = vertical
						margin_left = 4

						flowcontainer = {
							spacing = 1

							icon = {
								texture = "gfx/interface/icons/trade_icons/exports.dds"
								size = { 23 23 }
							}

							custom_tooltip_textbox = {
								text = "MARKET_EXPORTS"
								margin_bottom = 5
								margin_left = 5
								autoresize = yes
								align = right|nobaseline
							}
						}

						flowcontainer = {
							datamodel = "[DataModelFirst(Market.GetExports, '(int32)10')]"
							parentanchor = right
							direction = vertical

							item = {
								flowcontainer = {
									spacing = 5
									parentanchor = right

									minimumsize = { 200 -1 }
									margin = { 3 3 }

									tooltipwidget = {
										FancyTooltip_Goods = {}
									}

									background = {
										visible = "[IsEven_int32(PdxGuiWidget.GetIndexInDataModel)]"
										using = dark_area
									}

									icon = {
										size = { 23 23 }
										texture = "[Goods.GetTexture]"
									}

									custom_tooltip_textbox = {
										text = "[Goods.GetMarketExports|vD]"
										autoresize = yes
										align = nobaseline
										parentanchor = vcenter
										minimumsize = { 40 -1 }
										maximumsize = { 40 -1 }
										fontsize_min = 12
									}

									overlappingitembox = {
										datamodel = "[Goods.GetImportersFromMarket]"
										size = { 115 18 }
										spacing = 5
										righttoleft = yes
										parentanchor = vcenter

										item = {
											small_market_flag = {
												parentanchor = vcenter
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
