	type interest_groups_with_approval_changes = flowcontainer {
		visible = "[Not(IsDataModelEmpty(Law.GetIGsWithApprovalChanges))]"
		minimumsize = { 520 -1 }
		direction = vertical

		block "datamodel" {
			datamodel = "[Law.GetIGsWithApprovalChanges]"
		}

		background = {
			using = entry_bg_simple
		}

		item = {
			flowcontainer = {
				margin = { 10 0 }
				tooltip = "INTERST_GROUP_APPROVAL_CHANGE_BREAKDOWN_TOOLTIP"

				### IG COLOR
				background = {
					texture = "gfx/interface/tooltip/tooltip_title_bg.dds"
					color = "[InterestGroup.GetColor]"
					alpha = 0.2
					mirror = horizontal

					modify_texture = {
						using = texture_velvet
					}
				}

				widget = {
					size = { 530 40 }

					widget = {
						size = { 100 40 }

						### RED
						background = {
							visible = "[LessThan_int32(InterestGroup.GetApprovalValueDeltaFromEnactment(Law.GetLawType.Self), '(int32)0')]"
							texture = "gfx/interface/tooltip/tooltip_title_bg.dds"
							color = { 0.78 0.25 0.25 1 }
							alpha = 0.5
							margin_left = 10

							modify_texture = {
								using = texture_velvet
							}
						}

						### GREEN
						background = {
							visible = "[GreaterThan_int32(InterestGroup.GetApprovalValueDeltaFromEnactment(Law.GetLawType.Self), '(int32)0')]"
							texture = "gfx/interface/tooltip/tooltip_title_bg.dds"
							color = { 0.54 0.78 0.33 1 }
							alpha = 0.5
							margin_left = 10

							modify_texture = {
								using = texture_velvet
							}
						}
					}

					block "radicalize_animation" {
						widget = {
							visible = "[InterestGroup.WillRadicalizeIfEnacted(Law.GetLawType.Self)]"
							parentanchor = right
							size = { 100 40 }

							### WILL RADICALIZE - RED BLINKING ANIMATION
							icon = {
								size = { 110 100% }
								using = look_at_me_animation_weak
								color = { 0.78 0.25 0.25 1 }
								mirror = horizontal
								texture = "gfx/interface/tooltip/tooltip_title_bg.dds"
							}
						}
					}

					hbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						spacing = 5

						icon = {
							visible = "[LessThan_int32(InterestGroup.GetApprovalValueDeltaFromEnactment(Law.GetLawType.Self), '(int32)0')]"
							size = { 25 25 }
							texture = "gfx/interface/icons/generic_icons/disapproval_icon.dds"
						}

						icon = {
							visible = "[GreaterThan_int32(InterestGroup.GetApprovalValueDeltaFromEnactment(Law.GetLawType.Self), '(int32)0')]"
							size = { 25 25 }
							texture = "gfx/interface/icons/generic_icons/approval_icon.dds"
						}

						textbox = {
							size = { 50 40 }
							align = nobaseline
							elide = right
							fontsize_min = 12
							raw_text = "#v [InterestGroup.GetApprovalValueDeltaFromEnactment(Law.GetLawType.Self)|=+]#!"
						}

						vertical_divider = {
							blockoverride "size" {
								layoutpolicy_vertical = expanding
								size = { 2 0 }
							}
						}

						textbox = {
							layoutpolicy_horizontal = expanding
							size = { 0 40 }
							align = nobaseline
							elide = right
							fontsize_min = 12
							text = "IG_NAME_AND_CLOUT"
						}

						expand = {}

						icon = {
							visible = "[InterestGroup.WillRadicalizeIfEnacted(Law.GetLawType.Self)]"
							size = { 25 25 }
							texture = "gfx/interface/icons/generic_icons/warning.dds"

							block "radicalize_animation" {
								using = look_at_me_animation
							}
						}

						textbox = {
							size = { 24 40 }
							align = right|nobaseline
							elide = right
							fontsize_min = 12
							raw_text = "#v [InterestGroup.GetApprovalValue|+]#!"
						}

						icon = {
							size = { 25 25 }
							texture = "gfx/interface/icons/generic_icons/arrow_right_small.dds"
						}

						textbox = {
							size = { 24 40 }
							align = nobaseline
							elide = right
							fontsize_min = 12
							raw_text = "#v [InterestGroup.GetApprovalValueIfEnacted(Law.GetLawType.Self)|+]#!"
						}
					}
				}
			}
		}
	}

