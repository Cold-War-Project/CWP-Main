					custom_tooltip_newline = {}

					custom_tooltip_textbox = {
						text = "ACCEPTANCE_STATUS_TT_EFFECTS_HEADER"
						default_format = "#title"
						min_width = @tooltip_fixed_width
					}
				}
			}
		}
	}

	# One Pop, its Acceptance Value and how it ties to Acceptance Status
	type FancyTooltip_PopAcceptance = FancyTooltipWidgetType {
		blockoverride "text" {	} #all content is in 'blockoverride "tooltip_content_after"'

		blockoverride "replace_icon" {
			acceptance_status_fancy_tooltip_large_icon = {
				datacontext = "[Pop.GetAcceptanceStatus]"
			}
		}

		blockoverride "name" {
			text = "[Pop.GetAcceptanceStatus.GetNameNoFormatting]"
		}

		blockoverride "type" {
			text = "[concept_acceptance_status]"
		}

		blockoverride "tooltip_content_after"
		{
			datacontext = "[Pop.GetAcceptanceStatus]"
			datacontext = "[Pop.GetCountry]"

			flowcontainer = {
				direction = vertical
				using = tooltip_segment_margin

				custom_tooltip_textbox_fixed_width = {
					visible = "[Pop.IsAcceptanceStatusIncreasing]"
					text = "ACCEPTANCE_STATUS_WILL_INCREASE"
				}

				custom_tooltip_textbox_fixed_width = {
					visible = "[Not(Pop.GetSocialClass.GetSocialHierarchy.IsDefault)]"
					text = "ACCEPTANCE_STATUS_STRATA_RESTRICTION"
				}

				custom_tooltip_newline = {
					visible = "[Or(Pop.IsAcceptanceStatusIncreasing, Not(Pop.GetSocialClass.GetSocialHierarchy.IsDefault))]"
				}

				custom_tooltip_textbox_fixed_width = {
					text = "POP_ACCEPTANCE_VALUE_WITH_BREAKDOWN"
				}

				custom_tooltip_newline = {}

				custom_tooltip_textbox_fixed_width = {
					visible = "[AcceptanceStatus.HasHigherStatus]"
					text = "ACCEPTANCE_STATUS_NEXT"
				}

				custom_tooltip_textbox_fixed_width = {
					visible = "[AcceptanceStatus.HasLowerStatus]"
					text = "ACCEPTANCE_STATUS_PREV"
				}
			}

			acceptance_tooltip_bottom_section_flowcontainer = {}
		}

	}


	type acceptance_tooltip_bottom_section_flowcontainer = flowcontainer {
		# uses datacontexts:
		# Country
		# AcceptanceStatus

		direction = vertical

		flowcontainer = {
			direction = vertical
			using = tooltip_segment_margin
			using = tooltip_segment_background

			custom_tooltip_textbox = {
				text = "ACCEPTANCE_STATUS_TT_COUNTRY_HEADER"
				default_format = "#title"
				min_width = @tooltip_fixed_width
			}

			block "bottom_section_population"
			{

			}

			custom_tooltip_textbox = {
				text = "[AcceptanceStatus.GetEffectsDescIn(Country.Self)]"
				min_width = @tooltip_fixed_width
			}
		}

		custom_tooltip_textbox = {
			text = "[AcceptanceStatus.GetDesc]"
			using = tooltip_segment_margin
			default_format = "#lore"
			max_width = @tooltip_fixed_width
		}
	}

	type RegularTooltip_RetrofitShip = RegularTooltip {
		blockoverride "tooltip_content_after" {
			custom_tooltip_textbox = {
				text = "RETROFIT_SHIP_BUTTON_TOOLTIP"
			}

			flowcontainer = {
				visible = "[Ship.IsOutdated]"
				direction = vertical

				tooltip_divider = {}

				custom_tooltip_textbox = {
					text = "SHIP_IS_OUTDATED"
				}

				### Changed Modifications Slots
				flowcontainer = {
					direction = vertical
					datamodel = "[Ship.GetModificationSlotsChanged]"

					item = {
						flowcontainer = {
							margin = { 10 5 }
							spacing = 7

							background = {
								using = entry_bg_simple
							}

							### Modification Slot
							textbox = {
								parentanchor = vcenter
								size = { 140 30 }
								align = nobaseline
								using = elide_fontsize_min
								text = "[ShipModificationSlotType.GetName]"
							}

							### Old Modification
							flowcontainer = {
								parentanchor = vcenter
								spacing = 5
								datacontext = "[Ship.GetModificationTypeOld(ShipModificationSlotType.Self)]"

								tooltipwidget = {
									FancyTooltip_ShipModificationType = {}
								}

								icon = {
									parentanchor = vcenter
									size = { 25 25 }
									texture = "[ShipModificationType.GetIcon]"
								}

								textbox = {
									parentanchor = vcenter
									size = { 120 30 }
									align = nobaseline
									using = elide_fontsize_min
									text = "[ShipModificationType.GetNameNoFormatting]"
								}
							}

							icon = {
								parentanchor = vcenter
								size = { 25 25 }
								texture = "gfx/interface/icons/generic_icons/arrow_right_small.dds"
							}

							### New Modification
							flowcontainer = {
								parentanchor = vcenter
								spacing = 5
								datacontext = "[Ship.GetModificationTypeNew(ShipModificationSlotType.Self)]"

								tooltipwidget = {
									FancyTooltip_ShipModificationType = {}
								}

								icon = {
									parentanchor = vcenter
									size = { 25 25 }
									texture = "[ShipModificationType.GetIcon]"
								}

								textbox = {
									parentanchor = vcenter
									size = { 120 30 }
									align = nobaseline
									using = elide_fontsize_min
									default_format = "#b"
									text = "[ShipModificationType.GetNameNoFormatting]"
								}
							}
						}
					}
				}

				### Changed Additional Modifications
				flowcontainer = {
					spacing = 5
					wrap_count = 2
					datamodel = "[Ship.GetUtilityModificationsChanged]"

					item = {
						flowcontainer = {
							margin = { 10 5 }
							spacing = 5
							using = tooltip_se
							tooltip = "RETROFIT_SHIP_UTILITY_MOD_TOOLTIP"

							### RED
							background = {
								visible = "[Ship.IsUtilityModificationNew(ShipModificationType.Self)]"
								texture = "gfx/interface/tooltip/tooltip_title_bg.dds"
								color = { 0.78 0.25 0.25 1 }
								alpha = 0.5

								modify_texture = {
									using = texture_velvet
								}
							}

							### GREEN
							background = {
								visible = "[Ship.IsUtilityModificationOld(ShipModificationType.Self)]"
								texture = "gfx/interface/tooltip/tooltip_title_bg.dds"
								color = { 0.54 0.78 0.33 1 }
								alpha = 0.5

								modify_texture = {
									using = texture_velvet
								}
							}

							### Red Cross
							icon = {
								visible = "[Ship.IsUtilityModificationNew(ShipModificationType.Self)]"
								parentanchor = vcenter
								size = { 25 25 }
								texture = "gfx/interface/icons/generic_icons/red_cross.dds"
							}

							### Green Checkmark
							icon = {
								visible = "[Ship.IsUtilityModificationOld(ShipModificationType.Self)]"
								parentanchor = vcenter
								size = { 25 25 }
								texture = "gfx/interface/icons/generic_icons/green_checkmark.dds"
							}

							background = {
								using = entry_bg_simple
							}

							textbox = {
								parentanchor = vcenter
								size = { 205 30 }
								align = nobaseline
								using = elide_fontsize_min
								text = "[ShipModificationType.GetName]"
							}
						}
					}
				}

				custom_tooltip_newline = {}

				custom_tooltip_textbox = {
					text = "RETROFIT_SHIP_CONSTRUCTION_COST"
				}

				custom_tooltip_textbox = {
					text = "RETROFIT_SHIP_TOTAL_WEEKS"
				}
			}
		}
	}

	type FancyTooltip_Ship = FancyTooltipWidgetType {
		blockoverride "text" {} # Fully replaced by everything in tooltip_content_after

		blockoverride "name" {
			text = "SHIP_TOOLTIP_NAME"
		}

		blockoverride "type" {
			text = "SHIP_TOOLTIP_TYPES"
		}

		blockoverride "header_text_margin_left" {
			margin_left = 130
		}

		blockoverride "whole_icon" {
			ship_type_silhouette = {
				datacontext = "[Ship.GetType]"
				position = { 10 13 }
				size = { 110 30 }
			}
		}

		blockoverride "go_to_button_visibility" {
			visible = yes
		}

		blockoverride "go_to_button_properties" {
			onclick = "[InformationPanelBar.OpenShipPanel(Ship.Self)]"
		}

		blockoverride "tooltip_content_after" {
			spacing = 1
			custom_tooltip_textbox = {
				visible = "[Ship.IsFlagship]"
				text = "SHIP_FLAGSHIP"
			}

			flowcontainer = {
				spacing = 5

				DefaultTooltipTextBox = {
					parentanchor = vcenter
					fonttintcolor = "[TooltipInfo.GetTintColor]"
					multiline = yes
					max_width = 450
					text = "SHIP_PART_OF_FLEET"
				}

				button_icon_goto = {
					visible = "[Ship.GetFleet.IsValid]"
					datacontext = "[Ship.GetFleet]"
					size = { 25 25 }
					onclick = "[InformationPanelBar.OpenMilitaryFormationPanelTab( MilitaryFormation.Self, 'default' )]"
					tooltip = "GO_TO_BUTTON_MILITARY_FORMATION"
				}
			}

			custom_tooltip_newline = {}

			custom_tooltip_textbox = {
				text = "SHIP_TEMPLATE_IN_TOOLTIP"
			}

			flowcontainer = {
				spacing = 2

				flowcontainer = {
					spacing = 2
					datamodel = "[Ship.GetModifications]"

					item = {
						icon = {
							using = tooltip_se
							size = { 24 24 }
							texture = "[ShipModificationType.GetIcon]"

							tooltipwidget = {
								FancyTooltip_ShipModificationType = {}
							}
						}
					}
				}

				flowcontainer = {
					spacing = 2
					datamodel = "[Ship.GetUtilityModifications]"

					item = {
						icon = {
							using = tooltip_se
							size = { 24 24 }
							texture = "[ShipModificationType.GetIcon]"

							tooltipwidget = {
								FancyTooltip_ShipModificationType = {}
							}
						}
					}
				}
			}

			flowcontainer = {
				visible = "[Or(Ship.IsOutdated, Ship.IsToRetrofit)]"
				direction = vertical

				flowcontainer = {
					spacing = 5

					DefaultTooltipTextBox = {
						visible = "[Ship.IsOutdated]"
						parentanchor = vcenter
						fonttintcolor = "[TooltipInfo.GetTintColor]"
						multiline = yes
						max_width = 450
						text = "SHIP_TEMPLATE_IS_OUTDATED"
					}

					DefaultTooltipTextBox = {
						visible = "[Ship.IsToRetrofit]"
						parentanchor = vcenter
						fonttintcolor = "[TooltipInfo.GetTintColor]"
						multiline = yes
						max_width = 450
						text = "RETROFIT_SHIP_IS_BEING_RETROFITTED"
					}

					### Retrofit ship
					retrofit_ship_button = {
						size = { 26 26 }
					}

					### Cancel Retrofit
					cancel_retrofit_ship_button = {
						size = { 26 26 }
					}
				}

				custom_tooltip_textbox = {
					visible = "[Ship.IsToRetrofit]"
					margin_left = 10
					text = "RETROFIT_SHIP_WEEKS_LEFT"
				}
			}

			custom_tooltip_newline = {}

			block "icons_and_bars" {

				military_formation_icon_and_bars = {
					datacontext = "[Ship.GetFleet]"
					size = { 500 80 }

					blockoverride "text_parentanchor" {
						parentanchor = vcenter
					}

					blockoverride "first_bar_size" {
						size = { 500 25 }
					}

					blockoverride "second_bar_size" {
						size = { 500 18 }
					}

					blockoverride "third_bar_size" {
						size = { 500 18 }
					}

					blockoverride "first_bar_tooltip" {
						tooltip = "SHIP_HIT_POINTS_TOOLTIP"
					}

					blockoverride "second_bar_tooltip" {
						tooltip = "SHIP_CREW_TOOLTIP"
					}

					blockoverride "first_bar_values" {
						min = 0
						max = 1
						value = "[FixedPointToFloat(Ship.GetHitPointsPercentage)]"
					}

					blockoverride "second_bar_values" {
						min = 0
						max = "[Ship.GetCrewMax]"
						value = "[Ship.GetTotalCrew]"
					}

					blockoverride "first_bar_text" {
						raw_text = "@ship_hp! #b [Ship.GetHitPoints|0]#! / [Ship.GetHitPointsMax|0]" #todo
					}

					blockoverride "second_bar_text" {
						raw_text = "@crew! #b [Ship.GetTotalCrew|D]#! / [Ship.GetCrewMax|D]"
					}

					blockoverride "entire_icon" {}
				}
			}

