		blockoverride "stat_tooltip" {
			tooltip = "SHIP_VETERANCY_TOOLTIP"
		}

		blockoverride "stat_value" {
			#text = "[Ship.GetVeterancyLevel.GetNameNoIcon]" # todo PRCAL-45075 - comment back in once veteran rank number has been added by code.
			white_progressbar_vertical = { # todo PRCAL-45075 - delete once veteran rank number has been added by code.
				visible = "[Not(Ship.IsAtMaxVeterancy)]"
				size = { 6 20 }
				parentanchor = vcenter|left
				tooltip = "SHIP_VETERANCY_TOOLTIP"

				blockoverride "values" {
					min = "[Ship.GetVeterancyLevel.GetExperienceThreshold]"
					max = "[Ship.GetVeterancyLevel.GetNextLevel.GetExperienceThreshold]"
					value = "[Ship.GetVeterancyExperience]"
				}
				blockoverride "color" {
					color = { 0.6 0.4 0.6 1 }
				}
			}
