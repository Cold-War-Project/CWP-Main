# COPY-PASTED FOR NOW
@panel_width_minus_10 = 530			# used to be 450
@panel_width = 540  				# used to be 460
@panel_width_half = 270				# used to be 230
@panel_width_plus_10 = 550  		# used to be 470
@panel_width_plus_14 = 554			# used to be 474
@panel_width_plus_14_half = 277		# used to be 237
@panel_width_plus_20 = 560			# used to be 480
@panel_width_plus_30 = 570			# used to be 490
@panel_width_plus_70 = 610			# used to be 530

ship_change_name_popup_type = {
	name = ship_change_name_popup
}

types ship_change_name
{
	type ship_change_name_popup_type = default_popup
	{
		datacontext = "[ShipChangeNamePopup.GetShip]"

		blockoverride "window_header_name"
		{
			text = "CHANGE_NAME"
		}

		blockoverride "header_close_button_visibility"
		{
			visible = yes
		}

		blockoverride "header_close_button"
		{
			visible = yes
			onclick = "[PopupManager.HideShipChangeName]"
		}

		blockoverride "entire_scrollarea"
		{
			flowcontainer = {
				direction = vertical

				#background = {
				#	using = default_background
				#}

				# "Choose Name" section
				flowcontainer = {
					direction = vertical
					spacing = 10

					# Set a custom name
					editbox = {
						visible = yes
						background = {
							using = text_edit_bg
						}

						# The name is referenced in code. If you change it, it will no longer get properly reset
						name = "ship_name_edit"
						ontextedited = "[ShipChangeNamePopup.OnEditName]"
						maxcharacters = 50
						size = { 420 40 }
						margin_left = 10
						alwaystransparent = no
						focuspolicy = all
						focus_on_visible = yes
						align = left|nobaseline
					}

					flowcontainer = {
						direction = horizontal
						using = default_list_position
						spacing = 20

						button = {
							using = default_button
							using = close_button_sound
							size = { 140 40 }
							text = "CANCEL"
							shortcut = "close_window"
							onclick = "[PopupManager.HideShipChangeName]"
						}
						button = {
							using = default_button_primary_action
							using = confirm_button_sound
							name = "confirmation_button"
							size = { 140 40 }
							text = "CONFIRM"
							enabled = "[IsValid(ShipChangeNamePopup.Confirm)]"
							onclick = "[Execute(ShipChangeNamePopup.Confirm)]"
							tooltip = "[GetDesc(ShipChangeNamePopup.Confirm)]"
							onclick = "[PopupManager.HideShipChangeName]"
						}
					}

					widget = {
						size = { 420 10 }
					}
				}


			}
		}

		blockoverride "bottom_margin"
		{
			margin_bottom = 50
		}
	}
}

types ship_viewer_types
{
	type ship_viewer = icon {
		name = "ship_viewer_widget"
		size = { 100% 370 }
		gfxtype = jomini_entitygfx_sprite
		entity_instance = "[ShipViewer.GetEntity]"
		#using = frame_small_mask

		shaderfile = "gfx/FX/pdxgui_default.shader"
		effectname = "PdxGuiDefault"
		render_pass = "[GetGuiEntityShaderRenderpass]"

		gfx_environment_file = "gfx/map/environment/ui_ship_viewer_environment.txt"
		enabled_post_effects = luminance

		camera_position = "[ShipViewer.GetCameraPosition]"
		camera_look_at = "[ShipViewer.GetCameraLookAt]"
		camera_fov_y_degrees = 12
		camera_near_far = { 0.1 300.0 }
		alwaystransparent = no
	}
}

types ship_panel_types
{
	type ship_panel = default_block_window_two_lines {
		name = "ship_panel"
		datacontext = "[ShipPanel.GetShip]"

		blockoverride "animation_state_block" {
			state = {
				name = _show
				start_sound = {
					soundeffect = "event:/SFX/UI/SideBar/military"
				}
			}

			state = {
				name = _hide
				start_sound = {
					soundeffect = "event:/SFX/UI/SideBar/military_stop"
				}
			}
		}

		blockoverride "window_header_name"
		{
			text = "SHIP_PANEL_NAME"
		}

		blockoverride "window_header_name_line_two"
		{
			text = "SHIP_SUBTITLE"
		}

		blockoverride "goto_visibility" {}

		blockoverride "goto_properties" {
			onclick = "[Ship.ZoomTo]"
			tooltip = "ZOOM_TO_SHIP"
			enabled = "[Not( Ship.IsZoomingTo )]"
		}

		blockoverride "edit_visibility" {
			visible = "[Ship.GetCountry.IsLocalPlayer]"
		}

		blockoverride "edit_tooltip" {
			tooltip = "CHANGE_NAME"
		}

		blockoverride "edit_properties" {
			onclick = "[PopupManager.ShowShipChangeName(Ship.Self)]"
			#enabled = yes
		}

		blockoverride "goto_button" {
			button_icon_goto = {
				size = { 30 30 }
				datacontext = "[Ship.GetFleet]"
				tooltip = "GO_TO_BUTTON_MILITARY_FORMATION"
				onclick = "[InformationPanelBar.OpenMilitaryFormationPanelTab( MilitaryFormation.Self, 'default' )]"
				input_action = "go_to_details"
			}
		}

		blockoverride "fixed_bottom" {
			flowcontainer = {
				minimumsize = { @panel_width_plus_14 -1 }
				direction = vertical
				spacing = 5
				using = default_fade_in_out

				divider_clean = {
					size = { @panel_width_plus_14 4 }
				}

				background = {
					using = dark_area
				}

				widget = {
					size = { 5 2 }
				}

				flowcontainer = {
					parentanchor = hcenter
					spacing = 5

					### Flagship info
					flowcontainer = {
						direction = vertical
						visible = "[HasDlcFeature('ship_designer')]"

						button = {
							visible = "[And(Not(Ship.IsFlagship), Ship.GetCountry.IsLocalPlayer)]"
							using = default_button_action
							size = { 180 40 }
							onclick = "[PopupManager.AskConfirmation(Ship.AssignAsFlagship)]"
							enabled = "[IsValid(Ship.AssignAsFlagship)]"

							text = "ASSIGN_AS_FLAGSHIP_BUTTON"
							tooltip = "ASSIGN_AS_FLAGSHIP_BUTTON_TOOLTIP"
							using = tooltip_ne
						}

						button = {
							visible = "[And(Ship.IsFlagship, Ship.GetCountry.IsLocalPlayer)]"
							using = default_button_action
							size = { 180 40 }
							onclick = "[PopupManager.AskConfirmation(Ship.UnassignAsFlagship)]"
							enabled = "[IsValid(Ship.UnassignAsFlagship)]"

							text = "UNASSIGN_AS_FLAGSHIP_BUTTON"
							tooltip = "UNASSIGN_AS_FLAGSHIP_BUTTON_TOOLTIP"
							using = tooltip_ne

							icon = {
								using = highlighted_active_square_selection
							}
						}
					}

					### RETROFIT
					flowcontainer = {
						direction = vertical

						### START RETROFIT
						button = {
							visible = "[Not(Ship.IsToRetrofit)]"
							using = default_button
							size = { 180 40 }
							using = action_send_ship_to_retrofit
							enabled = "[IsValid(Ship.Retrofit)]"
							onclick = "[Execute(Ship.Retrofit)]"

							text = "RETROFIT_SHIP_BUTTON"
							tooltip = "RETROFIT_SHIP_BUTTON_TOOLTIP"
							using = tooltip_ne
						}

						### CANCEL RETROFIT
						button = {
							visible = "[Ship.IsToRetrofit]"
							using = default_button_action
							size = { 180 40 }
							using = fleet_panel_construction_template_build_cancel
							enabled = "[IsValid(Ship.CancelRetrofit)]"
							onclick = "[Execute(Ship.CancelRetrofit)]"

							text = "CANCEL_RETROFIT_SHIPS_BUTTON"
							tooltip = "RETROFIT_SHIP_CANCEL_BUTTON_TOOLTIP"
							using = tooltip_ne
						}
					}

					flowcontainer = {
						direction = vertical

						### Change Template
						button = {
							using = default_button
							size = { 180 40 }
							onclick = "[RightClickMenuManager.ToggleShipChangeTemplateActions(Ship.AccessSelf, PdxGuiWidget.AccessSelf)]"

							text = "CHANGE_TEMPLATE"
							tooltip = "BUTTON_CHANGE_TEMPLATE_SINGLE_SHIP_TOOLTIP"
							using = tooltip_ne
						}
					}
				}

				widget = {
					size = { 5 2 }
				}
			}
		}

		blockoverride "bottom_spacing" {}

		blockoverride "scrollarea_content"
		{
			flowcontainer = {
				direction = vertical
				minimumsize = { @panel_width_plus_14 -1 }
				maximumsize = { @panel_width_plus_14 -1 }
				spacing = 2
				datacontext = "[Ship.GetFleet]"

				widget = {
					parentanchor = hcenter
					size = { @panel_width_plus_14 370 }

					### 3D Ship View
					ship_viewer = {
						datacontext = "[ShipPanel.GetShipViewer]"

						console_button = {
							visible = "[InDebugMode]"
							parentanchor = left
							position = { 10 70 }
							raw_text = "Entity States"
							onclick = "[ExecuteConsoleCommand('gui.CreateDockable gui/debug_menues.gui ship_viewer_entity_states_from_ship_panel')]"
						}
					}

					icon = {
						parentanchor = top
						position = { 8 0 }
						size = { 55	55 }
						alpha = 0.8
						texture = "gfx/interface/icons/generic_icons/rotate_zoom.dds"
					}

					### Reset Camera Button
					button_icon_round_action = {
						size = { 34 34 }
						parentanchor = top
						position = { 70 10 }
						tooltip = "RESET_CAMERA"
						onclick = "[ShipPanel.GetShipViewer.ResetCamera]"

						blockoverride "icon_size" {
							size = { 75% 75% }
						}

						blockoverride "icon" {
							texture = "gfx/interface/buttons/button_icons/reset_camera.dds"
						}
					}

					### DELETE FORMATION
					button_icon_round_action = {
						size = { 34 34 }
						parentanchor = right
						position = { -10 10 }
						tooltip = "DECOMMISSION_SHIP_TOOLTIP"
						enabled = "[IsValid( Ship.Decommission )]"
						onclick = "[PopupManager.AskConfirmationCustomWithSound(Ship.Decommission, 'ship_decommission_confirmation_window', 'event:/SFX/UI/FleetPanel/fleetpanel_ship_decommission')]"

						blockoverride "icon_size" {
							size = { 65% 65% }
						}

						blockoverride "icon" {
							texture = "gfx/interface/icons/military_icons/disband_formation.dds"
						}
					}

					icon = {
						size = { 100% 100% }
						texture = "gfx/interface/navy/navy_bg_frame.dds"
						spriteType = Corneredtiled

						spriteborder_left = 200
						spriteborder_right = 60
						spriteborder_top = 170
						spriteborder_bottom = 180

						texture_density = 2
					}

					### Flagship Ornament Selector
					flowcontainer = {
						parentanchor = bottom|hcenter
						position = { 0 -10 }
						visible = "[And(Ship.IsFlagship, HasDlcFeature('ship_designer'))]"
						spacing = 5

						button_select_arrow = {
							parentanchor = vcenter
							mirror = horizontal
							size = { 33 33 }
							using = confirm_button_sound
							enabled = "[IsValid( Ship.SetPrevFlagshipOrnament )]"
							onclick = "[Execute( Ship.SetPrevFlagshipOrnament )]"
							tooltip = "FLAGSHIP_ORNAMENT_PREV_TOOLTIP"
							using = tooltip_se
						}

						textbox = {
							background = {
								using = dark_area
								alpha = 0.4
							}

							margin = { 0 3 }
							parentanchor = vcenter
							autoresize = yes
							align = hcenter|nobaseline
							min_width = 150
							max_width = 220
							default_format = "#title"
							text = "[Ship.GetFlagshipOrnamentName]"
						}

						button_select_arrow = {
							parentanchor = vcenter
							size = { 33 33 }
							using = confirm_button_sound
							enabled = "[IsValid( Ship.SetNextFlagshipOrnament )]"
							onclick = "[Execute( Ship.SetNextFlagshipOrnament )]"
							tooltip = "FLAGSHIP_ORNAMENT_NEXT_TOOLTIP"
							using = tooltip_se
						}

						textbox = {
							visible = "[Ship.GetTemplate.HasFlagshipSignalFlagsEntity]"

							background = {
								using = dark_area
								alpha = 0.4
							}

							checkbutton = {
								parentanchor = vcenter
								using = check_button
								position = { 3 0 }
								size = { 24 24 }
								onclick = "[Execute(Ship.ToggleFlagshipSignalFlags)]"
								checked = "[Ship.HasFlagshipSignalFlags]"
							}

							margin = { 35 3 }
							parentanchor = vcenter
							autoresize = yes
							align = hcenter|nobaseline
							min_width = 150
							max_width = 220
							default_format = "#title"
							text = "FLAGSHIP_SIGNALFLAGS_LABEL"
						}
					}

					state = {
						name = _show
						using = viewport_sound_parameter_open
						using = ship_panel_open
					}

					state = {
						name = _hide
						using = viewport_sound_parameter_close
					}

				}

				naval_battle_item = {
					visible = "[Ship.IsInBattle]"
					datacontext = "[Ship.GetNavalBattle]"
					parentanchor = hcenter
				}

				default_header = {
					using = default_list_position

					blockoverride "text" {
						text = "SHIP_DETAILS_HEADER"
					}
				}

				widget = {
					size = { 5 5 }
				}

				#SHIP NAME AND SILHOUETTE
				flowcontainer = {
					parentanchor = hcenter
					spacing = 20
					margin = { 20 10 }

					background = {
						using = entry_bg_simple
					}

					flowcontainer = {
						parentanchor = vcenter
						direction = vertical

						textbox = {
							autoresize = yes
							align = nobaseline
							using = fontsize_small
							text = "[Ship.GetType.GetName]"
						}

						textbox = {
							autoresize = yes
							align = nobaseline
							text = "[Ship.GetTemplate.GetName]"
						}

						widget = {
							size = { 10 5 }
						}

						ship_type_silhouette = {
							datacontext = "[Ship.GetType]"

							blockoverride "fittype" {
								fittype = start
							}
						}
					}

					flowcontainer = {
						parentanchor = vcenter
						direction = vertical
						spacing = 10

						military_formation_icon_and_bars = {
							datacontext = "[Ship.GetFleet]"
							size = { 300 80 }

							blockoverride "first_bar_size" {
								size = { 300 25 }
							}

							blockoverride "second_bar_size" {
								size = { 300 18 }
							}

							blockoverride "third_bar_size" {
								size = { 300 18 }
							}

							blockoverride "first_bar_tooltip" {
								tooltip = "SHIP_HIT_POINTS_TOOLTIP"
							}

							blockoverride "second_bar_tooltip" {
								tooltip = "SHIP_CREW_TOOLTIP"
							}

							blockoverride "first_bar_values" {
								min = 0
								max = 1
								value = "[FixedPointToFloat(Ship.GetHitPointsPercentage)]"
							}

							blockoverride "second_bar_values" {
								min = 0
								max = "[Ship.GetCrewMax]"
								value = "[Ship.GetTotalCrew]"
							}

							blockoverride "first_bar_text" {
								raw_text = "@ship_hp! #b [Ship.GetHitPoints|0]#!/[Ship.GetHitPointsMax|0]" #todo
							}

							blockoverride "second_bar_text" {
								raw_text = "@crew! #b [Ship.GetTotalCrew|D]#! / [Ship.GetCrewMax|D]"
							}

							blockoverride "entire_icon" {}
						}
					}
				}

				#SHIP MODIFICATIONS
				container = {
					parentanchor = hcenter
					minimumsize = { @panel_width_minus_10 -1 }
					maximumsize = { @panel_width_minus_10 -1 }

					background = {
						using = entry_bg_simple
					}

					flowcontainer = {
						direction = vertical
						spacing = 1
						margin = { 20 10 }
						datamodel = "[Ship.GetModifications]"

						item = {
							flowcontainer = {
								spacing = 2

								icon = {
									size = { 24 24 }
									texture = "[ShipModificationType.GetIcon]"
								}

								textbox = {
									parentanchor = vcenter
									autoresize = yes
									max_width = 220
									text = "[ShipModificationType.GetName]"
								}
							}
						}
					}

					flowcontainer = {
						parentanchor = right
						direction = vertical
						spacing = 1
						margin = { 25 10 }

						textbox = {
							visible = "[IsDataModelEmpty(Ship.GetUtilityModifications)]"
							autoresize = yes
							align = nobaseline
							using = elide_fontsize_min
							using = empty_state_text_properties
							text = "NO_UTILITY_MODIFICATIONS"
						}

						flowcontainer = {
							visible = "[Not(IsDataModelEmpty(Ship.GetUtilityModifications))]"
							direction = vertical
							spacing = 2
							datamodel = "[Ship.GetUtilityModifications]"

							item = {
								flowcontainer = {
									spacing = 2

									icon = {
										size = { 24 24 }
										texture = "[ShipModificationType.GetIcon]"
									}

									textbox = {
										parentanchor = vcenter
										autoresize = yes
										max_width = 220
										text = "[ShipModificationType.GetName]"
									}
								}
							}
						}
					}
				}

				widget = {
					size = { 5 5 }
				}

				divider_clean = {}

				flowcontainer = {
					datacontext = "[Ship.GetModifier]"
					parentanchor = hcenter

					flowcontainer = {
						direction = vertical

						ship_stat_upkeep = {}

						### Armor
						ship_stat_armor = {}

						### Crew Damage
						ship_stat_crew_damage = {}

						# Hull Damage
						ship_stat_hull_damage = {}

						### Crit Chance
						ship_stat_critical_hit_chance = {}

						### Crit Damage
						ship_stat_critical_hit_multiplier = {}

						### Visibility
						ship_stat_visibility = {}

						### Detection/Stealth
						ship_stat_detection = {}

						### Veteran Rank
						ship_stat_veterancy = {}

						### Accuracy
						ship_stat_accuracy = {}

					}

					vertical_divider_full = {}

					flowcontainer = {
						direction = vertical

						### Vulnerability
						ship_stat_vulnerability = {}

						### Screening
						ship_stat_screening = {}

						### Speed
						ship_stat_movement_speed = {}

						### Supply Efficiency
						ship_stat_supply_efficiency = {}

						### Supply Capacity
						ship_stat_supply_capacity = {}

						### Carrying Capacity
						ship_stat_carrying_capacity = {}

						### Marine Capacity
						ship_stat_marine_capacity = {}

						### Readiness Gain
						ship_stat_readiness_gain = {}

						### Blockade Strength
						ship_stat_blockade_strength = {}

						ship_modifier_battle_against_ship_type_arsenal_ship_accuracy_add = {
							visible = "[NotZero_CFixedPoint(Modifier.GetValueFor('ship_battle_against_ship_type_arsenal_ship_accuracy_add'))]"
						}
	
						ship_modifier_battle_against_ship_type_arsenal_ship_accuracy_mult = {
							visible = "[NotZero_CFixedPoint(Modifier.GetValueFor('ship_battle_against_ship_type_arsenal_ship_accuracy_mult'))]"
						}
	
						ship_modifier_battle_against_ship_type_arsenal_ship_hull_damage_add = {
							visible = "[NotZero_CFixedPoint(Modifier.GetValueFor('ship_battle_against_ship_type_arsenal_ship_hull_damage_add'))]"
						}
	
						ship_modifier_battle_against_ship_type_arsenal_ship_hull_damage_mult = {
							visible = "[NotZero_CFixedPoint(Modifier.GetValueFor('ship_battle_against_ship_type_arsenal_ship_hull_damage_mult'))]"
						}
	
						ship_modifier_battle_against_ship_type_attack_submarine_accuracy_add = {
							visible = "[NotZero_CFixedPoint(Modifier.GetValueFor('ship_battle_against_ship_type_attack_submarine_accuracy_add'))]"
						}
	
						ship_modifier_battle_against_ship_type_attack_submarine_accuracy_mult = {
							visible = "[NotZero_CFixedPoint(Modifier.GetValueFor('ship_battle_against_ship_type_attack_submarine_accuracy_mult'))]"
						}
	
						ship_modifier_battle_against_ship_type_attack_submarine_hull_damage_add = {
							visible = "[NotZero_CFixedPoint(Modifier.GetValueFor('ship_battle_against_ship_type_attack_submarine_hull_damage_add'))]"
						}
	
						ship_modifier_battle_against_ship_type_attack_submarine_hull_damage_mult = {
							visible = "[NotZero_CFixedPoint(Modifier.GetValueFor('ship_battle_against_ship_type_attack_submarine_hull_damage_mult'))]"
						}
	
						ship_modifier_battle_against_ship_type_aviation_cruiser_accuracy_add = {
							visible = "[NotZero_CFixedPoint(Modifier.GetValueFor('ship_battle_against_ship_type_aviation_cruiser_accuracy_add'))]"
						}
	
						ship_modifier_battle_against_ship_type_aviation_cruiser_accuracy_mult = {
							visible = "[NotZero_CFixedPoint(Modifier.GetValueFor('ship_battle_against_ship_type_aviation_cruiser_accuracy_mult'))]"
						}
	
						ship_modifier_battle_against_ship_type_aviation_cruiser_hull_damage_add = {
							visible = "[NotZero_CFixedPoint(Modifier.GetValueFor('ship_battle_against_ship_type_aviation_cruiser_hull_damage_add'))]"
						}
	
						ship_modifier_battle_against_ship_type_aviation_cruiser_hull_damage_mult = {
							visible = "[NotZero_CFixedPoint(Modifier.GetValueFor('ship_battle_against_ship_type_aviation_cruiser_hull_damage_mult'))]"
						}
	
						ship_modifier_battle_against_ship_type_battlecruiser_accuracy_add = {
							visible = "[NotZero_CFixedPoint(Modifier.GetValueFor('ship_battle_against_ship_type_battlecruiser_accuracy_add'))]"
						}
	
						ship_modifier_battle_against_ship_type_battlecruiser_accuracy_mult = {
							visible = "[NotZero_CFixedPoint(Modifier.GetValueFor('ship_battle_against_ship_type_battlecruiser_accuracy_mult'))]"
						}
	
						ship_modifier_battle_against_ship_type_battlecruiser_hull_damage_add = {
							visible = "[NotZero_CFixedPoint(Modifier.GetValueFor('ship_battle_against_ship_type_battlecruiser_hull_damage_add'))]"
						}
	
						ship_modifier_battle_against_ship_type_battlecruiser_hull_damage_mult = {
							visible = "[NotZero_CFixedPoint(Modifier.GetValueFor('ship_battle_against_ship_type_battlecruiser_hull_damage_mult'))]"
						}
	
						ship_modifier_battle_against_ship_type_battleship_accuracy_add = {
							visible = "[NotZero_CFixedPoint(Modifier.GetValueFor('ship_battle_against_ship_type_battleship_accuracy_add'))]"
						}
	
						ship_modifier_battle_against_ship_type_battleship_accuracy_mult = {
							visible = "[NotZero_CFixedPoint(Modifier.GetValueFor('ship_battle_against_ship_type_battleship_accuracy_mult'))]"
						}
	
						ship_modifier_battle_against_ship_type_battleship_hull_damage_add = {
