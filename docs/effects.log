	value = <integer value>  
	culture = <scope/cu:key>  
	religion = <scope/rel:key>  
	interest_group = <scope/ig:key>  
	pop_type = <scope/pop_type:key>  
	strata = <key>  
}
**Supported Scopes**: country  

