	if = {  
		limit = { total_population > 0 }  
		divide = total_population  
	}  
	else = {  
		multiply = 0.0001 # Fallback value in case of strange behaviour  
	}  
	  
	multiply = 1000  
	min = 0  
	max = 1  
}
